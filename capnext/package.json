{
  "name": "capnext",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "engines": {
    "node": "^20"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "@cap-js/sqlite": "^2",
    "express": "^4"
