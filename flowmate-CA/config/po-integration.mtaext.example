_schema-version: "3.3"
ID: flowmate-ca-po-integration
extends: flowmate-ca

modules:
  - name: flowmate-ca-srv
    properties:
      # Replace both placeholders. This mapping contains no client secret.
      FLOWMATE_CA_PO_INTEGRATION_CLIENTS: >-
        {"<exact-service-key-clientid>":"<active-shared-integration-user-uuid>"}
