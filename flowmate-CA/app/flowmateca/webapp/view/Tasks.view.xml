<mvc:View
  controllerName="flowmateca.controller.Tasks"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Page class="caPage" showNavButton="true" navButtonPress=".onNavHome" title="{taskView>/title}">
    <headerContent>
      <SegmentedButton selectedKey="{taskView>/mode}" selectionChange=".onModeChange">
        <items>
          <SegmentedButtonItem key="mine" text="My Tasks" icon="sap-icon://person-placeholder"/>
          <SegmentedButtonItem key="team" text="Team Queue" icon="sap-icon://group"/>
        </items>
      </SegmentedButton>
      <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onRefresh"/>
    </headerContent>
    <subHeader>
      <OverflowToolbar class="caFilterBar">
        <SearchField
          id="taskSearch"
          width="20rem"
          placeholder="Search task, request ID or title"
          liveChange=".onFilterChange"
          search=".onFilterChange"/>
        <Select id="taskStatusFilter" width="12rem" change=".onFilterChange">
          <core:Item key="" text="All statuses"/>
          <core:Item key="OPEN" text="Open"/>
          <core:Item key="SENT_BACK" text="Sent Back"/>
          <core:Item key="APPROVED" text="Approved"/>
          <core:Item key="REJECTED" text="Rejected"/>
        </Select>
        <ToolbarSpacer/>
        <Button text="Clear" icon="sap-icon://clear-filter" type="Transparent" press=".onClearFilters"/>
      </OverflowToolbar>
    </subHeader>
    <content>
      <!-- Scrolls sideways instead of squeezing: every column keeps a readable width. -->
      <ScrollContainer horizontal="true" vertical="false" width="100%" focusable="false">
      <Table
        items="{tasks>/items}"
        growing="true"
        growingScrollToLoad="false"
        noDataText="No tasks are available in this queue"
        itemPress=".onItemPress"
        class="caWorklistTable caScrollTable">
        <columns>
          <Column width="14rem"><Text text="Task ID"/></Column>
          <Column width="13rem"><Text text="Request ID"/></Column>
          <Column width="12rem"><Text text="{i18n>requestType}"/></Column>
          <Column width="11rem"><Text text="Requester"/></Column>
          <Column width="16rem"><Text text="Task"/></Column>
          <Column width="20rem"><Text text="Request"/></Column>
          <Column width="5rem"><Text text="Step"/></Column>
          <Column width="10rem"><Text text="{i18n>status}"/></Column>
          <Column width="12rem"><Text text="{i18n>slaDue}"/></Column>
          <Column width="10rem" visible="{taskView>/isTeamMode}"><Text text="Action"/></Column>
        </columns>
        <items>
          <ColumnListItem
            type="Navigation"
            highlight="{parts: ['tasks>slaDueAt', 'tasks>status/code', 'tasks>slaBreached'], formatter: '.formatSlaHighlight'}">
            <cells>
              <ObjectIdentifier title="{tasks>referenceNumber}" text="{tasks>assignedTeamName}"/>
              <Link text="{tasks>request/referenceNumber}" wrapping="true" press=".onRequestLinkPress"/>
              <Text text="{tasks>request/requestType/name}"/>
              <Text text="{tasks>request/requesterName}"/>
              <ObjectIdentifier title="{tasks>taskName}" text="{tasks>description}"/>
              <Text text="{tasks>request/title}" maxLines="2"/>
              <ObjectNumber number="{tasks>stepNo}"/>
              <VBox>
                <ObjectStatus text="{tasks>status/name}" state="{path: 'tasks>status/code', formatter: '.statusState'}"/>
                <ObjectStatus
                  text="{i18n>slaBreachedLabel}"
                  icon="sap-icon://lateness"
                  state="Error"
                  inverted="true"
                  class="sapUiTinyMarginTop"
                  visible="{parts: ['tasks>slaDueAt', 'tasks>status/code', 'tasks>slaBreached'], formatter: '.isSlaBreached'}"/>
                <ObjectStatus
                  text="{i18n>withinSlaLabel}"
                  icon="sap-icon://accept"
                  state="Success"
                  inverted="true"
                  class="sapUiTinyMarginTop"
                  visible="{parts: ['tasks>slaDueAt', 'tasks>status/code', 'tasks>slaBreached'], formatter: '.isWithinSla'}"/>
              </VBox>
              <VBox>
                <Text text="{= ${tasks>slaDueAt} ? ${path: 'tasks>slaDueAt', formatter: '.formatDateTime'} : ${path: 'tasks>dueDate', formatter: '.formatDate'} }"/>
                <Text
                  text="{parts: ['tasks>slaDueAt', 'tasks>status/code'], formatter: '.formatSlaRemaining'}"
                  class="caSlaRemaining"
                  visible="{= ${tasks>status/code} === 'OPEN' &amp;&amp; !!${tasks>slaDueAt} }"/>
              </VBox>
              <Button
                text="Assign to Me"
                icon="sap-icon://employee-approvals"
                type="Emphasized"
                visible="{taskView>/isTeamMode}"
                press=".onClaimTask"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
      </ScrollContainer>
    </content>
  </Page>
</mvc:View>
