<mvc:View
  controllerName="flowmateca.controller.RequestCreate"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  xmlns:unified="sap.ui.unified"
  xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
  xmlns="sap.m">
  <Page class="caPage" title="{i18n>createRequest}" showNavButton="true" navButtonPress=".onCancel">
    <headerContent>
      <Button text="{i18n>cancel}" type="Transparent" press=".onCancel"/>
      <Button text="{i18n>submit}" icon="sap-icon://paper-plane" type="Emphasized" press=".onSubmit"/>
    </headerContent>
    <content>
      <VBox class="caCreatePage sapUiResponsiveContentPadding">
        <MessageStrip
          text="Fields are shown based on the selected Request Type. The Process Variant controls the guided workflow that will be created."
          type="Information"
          showIcon="true"
          class="sapUiSmallMarginBottom"/>

        <Panel headerText="Request Classification" expandable="false" class="caFormSection">
          <content>
            <form:SimpleForm
              editable="true"
              layout="ColumnLayout"
              columnsXL="3"
              columnsL="3"
              columnsM="2"
              labelSpanXL="12"
              labelSpanL="12"
              labelSpanM="12">
              <Label text="{i18n>requestType}" required="true"/>
              <ComboBox
                id="requestType"
                selectedKey="{form>/requestTypeCode}"
                items="{catalog>/requestTypes}"
                selectionChange=".onRequestTypeChange"
                showSecondaryValues="true">
                <core:ListItem key="{catalog>code}" text="{catalog>name}" additionalText="{catalog>code}"/>
              </ComboBox>
              <Label text="Material Category" required="true" visible="{= ${form>/requestTypeCode} === 'MATERIAL_CODE'}"/>
              <ComboBox
                id="materialCategory"
                selectedKey="{form>/materialCategoryCode}"
                items="{catalog>/materialCategories}"
                selectionChange=".onMaterialCategoryChange"
                visible="{= ${form>/requestTypeCode} === 'MATERIAL_CODE'}"
                showSecondaryValues="true">
                <core:ListItem key="{catalog>code}" text="{catalog>name}" additionalText="{catalog>code}"/>
              </ComboBox>
              <Label text="{i18n>requestVariant}" required="true"/>
              <ComboBox
                id="requestVariant"
                selectedKey="{form>/requestVariantCode}"
                items="{catalog>/filteredVariants}"
                selectionChange=".onRequestVariantChange"
                enabled="{= ${form>/requestTypeCode} !== 'MATERIAL_CODE' || !!${form>/materialCategoryCode}}"
                showSecondaryValues="true">
                <core:ListItem key="{catalog>code}" text="{catalog>name}" additionalText="{catalog>code}"/>
              </ComboBox>
              <Label text="{i18n>bulkUpload}" required="true" visible="{= ${form>/requestTypeCode} !== 'MATERIAL_RESERVATION' &amp;&amp; !${form>/hasHeaderTable} }"/>
              <Select id="bulkUpload" selectedKey="{form>/bulkUpload}" change=".onBulkUploadChange" visible="{= ${form>/requestTypeCode} !== 'MATERIAL_RESERVATION' &amp;&amp; !${form>/hasHeaderTable} }">
                <core:Item key="SINGLE_LINE" text="{i18n>singleLineItems}"/>
                <core:Item key="MULTIPLE_LINE" text="{i18n>multipleLineItems}"/>
              </Select>
              <Label text="{i18n>title}" required="true"/>
              <Input value="{form>/title}" maxLength="255" placeholder="Briefly describe the required outcome"/>
              <Label text="{i18n>dueDate}"/>
              <DatePicker value="{form>/dueDate}" valueFormat="yyyy-MM-dd" displayFormat="medium"/>
              <Label text="Link to Existing Request"/>
              <ComboBox
                selectedKey="{form>/predecessorId}"
                items="{catalog>/myRequests}"
                showSecondaryValues="true"
                placeholder="Optional predecessor request">
                <core:ListItem key="{catalog>ID}" text="{catalog>referenceNumber}" additionalText="{catalog>title}"/>
                <!--po creation-->
              </ComboBox>
              <Label text="{i18n>description}"/>
              <TextArea value="{form>/description}" rows="3" width="100%" placeholder="Business context and expected outcome"/>
              <Label text="{i18n>requester}"/>
              <Input id="requesterInput" value="{form>/requesterName}" editable="false" placeholder="Logged-in user"/>

<Label text="Processor Team" required="true"/>
<ComboBox
    id="processorTeamComboBox"
    selectedKey="{form>/processorTeamCode}"
    items="{catalog>/teams}"
    showSecondaryValues="true"
    placeholder="Select processor team"
    selectionChange=".onProcessorTeamChange">
    <core:ListItem
        key="{catalog>teamCode}"
        text="{catalog>name}"
        additionalText="{catalog>teamCode}"/>
</ComboBox>
            </form:SimpleForm>
          </content>
        </Panel>

        <Panel
          headerText="{form>/detailSectionTitle}"
          expandable="false"
          visible="{= !!${form>/requestTypeCode} }"
          class="caFormSection">
          <content>
            <VBox id="dynamicFormHost"/>
            <VBox id="conditionalGridsHost"/>
          </content>
        </Panel>
        <Panel
          headerText="{i18n>headersTableTitle}"
          expandable="false"
          visible="{= !!${form>/requestVariantCode} &amp;&amp; ${form>/hasHeaderTable} }"
          class="caFormSection">
          <content>
            <Toolbar>
              <Title text="{= ${i18n>headersTableTitle} + ' (' + (${form>/details/headers} ? ${form>/details/headers}.length : 0) + ')' }" level="H4"/>
              <ToolbarSpacer/>
              <unified:FileUploader
                id="headersCsvUploader"
                buttonOnly="true"
                buttonText="{i18n>importCsv}"
                icon="sap-icon://upload"
                change=".onImportItemsCsv"
                app:grid="headers"/>
              <Button text="{i18n>exportCsvTemplate}" icon="sap-icon://download" press=".onExportItemsCsv" app:grid="headers"/>
              <Button text="{i18n>addRow}" icon="sap-icon://add" type="Emphasized" press=".onAddItemRow" app:grid="headers"/>
            </Toolbar>
            <Text text="{i18n>itemsTableHint}" class="sapUiTinyMarginBottom sapUiTinyMarginBeginEnd"/>
            <ScrollContainer height="18rem" horizontal="true" vertical="true" focusable="false" width="100%">
              <Table
                id="headersTableHost"
                noDataText="{i18n>noItemsYet}"
                sticky="ColumnHeaders"
                class="sapUiSizeCompact caItemsTable"/>
            </ScrollContainer>
          </content>
        </Panel>
        <Panel
          headerText="{= ${form>/hasHeaderTable} ? ${i18n>contractItemsTableTitle} : ${i18n>itemsTableTitle} }"
          expandable="false"
          visible="{= !!${form>/requestVariantCode} &amp;&amp; (${form>/bulkUpload} === 'MULTIPLE_LINE' || ${form>/requestTypeCode} === 'MATERIAL_RESERVATION' || ${form>/hasHeaderTable}) }"
          class="caFormSection">
          <content>
            <Toolbar>
              <Title text="{= (${form>/hasHeaderTable} ? ${i18n>contractItemsTableTitle} : ${i18n>itemsTableTitle}) + ' (' + (${form>/details/items} ? ${form>/details/items}.length : 0) + ')' }" level="H4"/>
              <ToolbarSpacer/>
              <unified:FileUploader
                id="itemsCsvUploader"
                buttonOnly="true"
                buttonText="{i18n>importCsv}"
                icon="sap-icon://upload"
                change=".onImportItemsCsv"
                app:grid="items"/>
              <Button text="{i18n>exportCsvTemplate}" icon="sap-icon://download" press=".onExportItemsCsv" app:grid="items"/>
              <Button text="{i18n>addRow}" icon="sap-icon://add" type="Emphasized" press=".onAddItemRow" app:grid="items"/>
            </Toolbar>
            <Text text="{i18n>itemsTableHint}" class="sapUiTinyMarginBottom sapUiTinyMarginBeginEnd"/>
            <ScrollContainer height="24rem" horizontal="true" vertical="true" focusable="false" width="100%">
              <Table
                id="itemsTableHost"
                noDataText="{i18n>noItemsYet}"
                sticky="ColumnHeaders"
                class="sapUiSizeCompact caItemsTable"/>
            </ScrollContainer>
          </content>
        </Panel>

        <Panel headerText="Supporting Documents" expandable="false" class="caFormSection">
          <content>
            <VBox>
              <unified:FileUploader
                id="attachmentUploader"
                multiple="true"
                uploadOnChange="false"
                change=".onFilesSelected"
                buttonText="Select Files"
                icon="sap-icon://attachment"/>
              <List items="{files>/items}" noDataText="No supporting documents selected" class="sapUiSmallMarginTop">
                <StandardListItem
                  title="{files>name}"
                  description="{files>sizeText}"
                  icon="sap-icon://document"
                  type="Inactive"/>
              </List>
              <MessageStrip
                text="Files upload in the background after the request is created. The maximum size per file is 400 MB."
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginTop"/>
            </VBox>
          </content>
        </Panel>
      </VBox>
    </content>
    <footer>
      <OverflowToolbar>
        <ToolbarSpacer/>
        <Button text="{i18n>cancel}" press=".onCancel"/>
        <Button text="{i18n>submit}" icon="sap-icon://paper-plane" type="Emphasized" press=".onSubmit"/>
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
