<mvc:View
  controllerName="flowmateca.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Page class="caPage" showHeader="true">
    <customHeader>
      <OverflowToolbar class="caTopBar">
        <Title text="Flowmate CA" level="H2"/>
        <ToolbarSpacer/>
        <Button icon="sap-icon://home" type="Transparent" tooltip="Workspace"/>
        <Button icon="sap-icon://documents" type="Transparent" tooltip="Requests" visible="{app>/currentUser/canCreate}" press=".onRequests"/>
        <Button icon="sap-icon://task" type="Transparent" tooltip="Tasks" visible="{app>/currentUser/canValidate}" press=".onTasks"/>
        <Button
          icon="sap-icon://action-settings"
          type="Transparent"
          tooltip="Administration"
          visible="{app>/currentUser/isAdmin}"
          press=".onAdmin"/>
        <ToolbarSeparator/>
        <Avatar
          displaySize="XS"
          displayShape="Circle"
          initials="{path: 'app>/currentUser/email', formatter: '.formatInitials'}"
          backgroundColor="{path: 'app>/currentUser/email', formatter: '.formatAvatarColor'}"/>
        <Text text="{app>/currentUser/displayName}"/>
      </OverflowToolbar>
    </customHeader>
    <content>
      <VBox class="caDashboard sapUiResponsiveContentPadding">
        <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="caDashboardIntro">
          <HBox alignItems="Center" class="caDashboardHeroTitle">
            <core:Icon src="sap-icon://business-objects-experience" class="caDashboardHeroIcon"/>
            <VBox>
              <Title text="{i18n>dashboardTitle}" level="H1"/>
              <Text text="Create, process and monitor supply-chain requests across Dialog and SAP teams."/>
            </VBox>
          </HBox>
          <Button
            text="{i18n>createRequest}"
            icon="sap-icon://add-document"
            type="Emphasized"
            class="caHeroAction"
            visible="{app>/currentUser/canCreate}"
            press=".onCreateRequest"/>
        </HBox>

        <FlexBox wrap="Wrap" class="caTileGrid" renderType="Div">
          <GenericTile class="caTile caTileIndigo" header="{i18n>allRequests}" subheader="{i18n>allRequestsSubtitle}" visible="{app>/currentUser/canViewAllRequests}" press=".onAllRequests">
            <tileContent>
              <TileContent>
                <NumericContent value="{dashboard>/allRequests}" icon="sap-icon://overview-chart" valueColor="Neutral"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileBlue" header="{i18n>myRequests}" subheader="{i18n>myRequestsDelegationSubtitle}" visible="{app>/currentUser/canCreate}" press=".onMyRequests">
            <tileContent>
              <TileContent>
                <NumericContent value="{dashboard>/myRequests}" icon="sap-icon://documents" valueColor="Neutral"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileIndigo" header="Draft Requests" subheader="Your saved forms awaiting submission" visible="{app>/currentUser/canViewDrafts}" press=".onDrafts">
            <tileContent>
              <TileContent>
                <NumericContent value="{dashboard>/myDrafts}" icon="sap-icon://save" valueColor="Neutral"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileTeal" header="{i18n>myTasks}" subheader="Tasks assigned to you" visible="{app>/currentUser/canValidate}" press=".onMyTasks">
            <tileContent>
              <TileContent>
                <NumericContent value="{dashboard>/myOpenTasks}" icon="sap-icon://task" valueColor="Neutral"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileGold" header="{i18n>teamTasks}" subheader="Available in your teams" visible="{app>/currentUser/canValidate}" press=".onTeamTasks">
            <tileContent>
              <TileContent>
                <NumericContent value="{dashboard>/myTeamTasks}" icon="sap-icon://group" valueColor="Neutral"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileOrange" header="{i18n>sentBack}" subheader="Waiting for correction" visible="{app>/currentUser/canCreate}" press=".onSentBack">
            <tileContent>
              <TileContent>
                <NumericContent value="{dashboard>/sentBackRequests}" icon="sap-icon://undo" valueColor="Neutral"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileRed" header="{i18n>rejected}" subheader="Raise a new request" visible="{app>/currentUser/canCreate}" press=".onRejected">
            <tileContent>
              <TileContent>
                <NumericContent value="{dashboard>/rejectedRequests}" icon="sap-icon://decline" valueColor="Neutral"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileIndigo" header="{i18n>pendingApproval}" subheader="Approval tasks assigned to you" visible="{app>/currentUser/canValidate}" press=".onPendingApproval">
            <tileContent>
              <TileContent>
                <NumericContent value="{dashboard>/pendingApproval}" icon="sap-icon://approvals" valueColor="Neutral"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileGreen" header="{i18n>completed}" subheader="Your completed requests" visible="{app>/currentUser/canCreate}" press=".onCompleted">
            <tileContent>
              <TileContent>
                <NumericContent value="{dashboard>/completedRequests}" icon="sap-icon://complete" valueColor="Neutral"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTilePurple" header="{i18n>reportsDashboard}" subheader="PO, SES and SCM performance" visible="{app>/currentUser/canViewReports}" press=".onReports">
            <tileContent>
              <TileContent>
                <NumericContent value="{dashboard>/reportingRequests}" icon="sap-icon://business-objects-experience" valueColor="Neutral"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileBlue" header="{i18n>delegationsTitle}" subheader="{i18n>delegationsSubtitle}" visible="{app>/currentUser/canManageDelegation}" press=".onDelegations">
            <tileContent>
              <TileContent>
                <ImageContent src="sap-icon://employee-approvals"/>
              </TileContent>
            </tileContent>
          </GenericTile>
        </FlexBox>

      </VBox>
    </content>
  </Page>
</mvc:View>
