<mvc:View
  controllerName="flowmateca.controller.Requests"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Page class="caPage" showNavButton="true" navButtonPress=".onNavHome" title="{i18n>myRequests}">
    <headerContent>
      <Button text="{i18n>createRequest}" icon="sap-icon://add" type="Emphasized" press=".onCreate"/>
      <Button text="Export to Excel" icon="sap-icon://excel-attachment" type="Transparent" press=".onExportExcel"/>
      <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onRefresh"/>
    </headerContent>
    <subHeader>
      <OverflowToolbar class="caFilterBar">
        <SearchField
          id="requestSearch"
          width="18rem"
          placeholder="Search ID, title or requester"
          liveChange=".onFilterChange"
          search=".onFilterChange"/>
        <ComboBox
          id="requestTypeFilter"
          width="15rem"
          placeholder="Request type"
          items="{catalog>/requestTypes}"
          selectionChange=".onRequestTypeChange">
          <core:Item key="{catalog>code}" text="{catalog>name}"/>
        </ComboBox>
        <ComboBox
          id="requestVariantFilter"
          width="15rem"
          placeholder="Process variant"
          items="{catalog>/filteredVariants}"
          selectionChange=".onFilterChange">
          <core:Item key="{catalog>code}" text="{catalog>name}"/>
        </ComboBox>
        <Select id="requestStatusFilter" width="11rem" change=".onFilterChange">
          <core:Item key="" text="All statuses"/>
          <core:Item key="SUBMITTED" text="Submitted"/>
          <core:Item key="IN_PROGRESS" text="In Progress"/>
          <core:Item key="SENT_BACK" text="Sent Back"/>
          <core:Item key="COMPLETED" text="Completed"/>
          <core:Item key="REJECTED" text="Terminated"/>
        </Select>
        <ToolbarSpacer/>
        <Label text="{i18n>sortBy}" labelFor="requestSort"/>
        <Select id="requestSort" width="14rem" selectedKey="{sortView>/key}" change=".onSortChange">
          <core:Item key="asc" text="{i18n>sortDueAsc}"/>
          <core:Item key="desc" text="{i18n>sortDueDesc}"/>
        </Select>
        <Button text="Clear" icon="sap-icon://clear-filter" type="Transparent" press=".onClearFilters"/>
      </OverflowToolbar>
    </subHeader>
    <content>
      <!-- Fits the page width; the page scrolls and the column headers stay in view. -->
      <ScrollContainer horizontal="false" vertical="false" width="100%" class="caWorklistScroll">
        <Table
          id="requestsTable"
          items="{list>/items}"
          mode="None"
          growing="true"
          growingScrollToLoad="true"
          noDataText="No requests match the selected filters"
          itemPress=".onItemPress"
          sticky="ColumnHeaders" class="caWorklistTable">
          <columns>
            <Column width="13rem"><Text text="Request ID"/></Column>
            <Column width="11rem"><Text text="{i18n>requestType}"/></Column>
            <!-- Hidden on the Sent Back / Terminated / Completed tile lists (opened with a status). -->
            <Column width="9rem" visible="{list>/showRequester}"><Text text="Requester"/></Column>
            <Column width="9rem"><Text text="{i18n>requestVariant}"/></Column>
            <Column><Text text="{i18n>title}"/></Column>
            <Column width="9rem"><Text text="{i18n>status}"/></Column>
            <Column width="8rem"><Text text="{i18n>dueDate}"/></Column>
            <Column width="8.5rem"><Text text="Created"/></Column>
          </columns>
          <items>
            <ColumnListItem
              type="Navigation"
              highlight="{parts: ['list>slaDueAt', 'list>status/code'], formatter: '.formatRequestSlaHighlight'}">
              <cells>
                <ObjectIdentifier title="{list>referenceNumber}"/>
                <Text text="{list>requestType/name}"/>
                <Text text="{list>requesterName}"/>
                <Text text="{list>requestVariant/name}"/>
                <Text text="{list>title}" tooltip="{list>title}" class="caTitleCell"/>
                <VBox>
                  <ObjectStatus text="{parts: ['list>status/name', 'list>status/code'], formatter: '.statusName'}" state="{path: 'list>status/code', formatter: '.statusState'}"/>
                  <ObjectStatus
                    text="{i18n>slaBreachedLabel}"
                    icon="sap-icon://lateness"
                    state="Error"
                    inverted="true"
                    class="sapUiTinyMarginTop"
                    visible="{parts: ['list>slaDueAt', 'list>status/code'], formatter: '.isRequestOverdue'}"/>
                </VBox>
                <Text text="{path: 'list>dueDate', formatter: '.formatDate'}"/>
                <Text text="{path: 'list>createdAt', formatter: '.formatDateTimeShort'}" tooltip="{path: 'list>createdAt', formatter: '.formatDateTime'}" wrapping="false"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </ScrollContainer>
    </content>
  </Page>
</mvc:View>
