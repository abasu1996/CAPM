<mvc:View
  controllerName="flowmateca.controller.TaskDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  xmlns:unified="sap.ui.unified"
  xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
  xmlns="sap.m">
  <Page class="caPage caObjectPage" showNavButton="true" navButtonPress=".onClose" title="{task>/taskName}">
    <headerContent>
      <Button icon="sap-icon://home" type="Transparent" tooltip="Dashboard" press=".onNavHome"/>
      <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onRefresh"/>
      <Button text="Assign Task" icon="sap-icon://employee" visible="{task>/canReassign}" press=".onReassignTask"/>
      <Button
        text="{i18n>claimTask}"
        icon="sap-icon://employee-approvals"
        type="Emphasized"
        visible="{task>/canClaim}"
        press=".onClaim"/>
      <!-- Purchase Order S/4 Data Validation: Approve waits until the Budget Check is done. -->
      <Button
        text="{i18n>budgetCheck}"
        icon="sap-icon://money-bills"
        type="Emphasized"
        visible="{task>/canRequestBudgetCheck}"
        press=".onRequestBudgetCheck"/>
      <Button
        text="{i18n>approve}"
        icon="sap-icon://accept"
        type="Accept"
        visible="{task>/canProcess}"
        enabled="{= !${task>/budgetCheckBlocksApproval} }"
        tooltip="{= ${task>/budgetCheckBlocksApproval} ? 'Complete the Budget Check first' : '' }"
        press=".onApprove"/>
      <Button
        text="{i18n>sendBack}"
        icon="sap-icon://undo"
        class="caBtnSendBack"
        visible="{task>/canSendBack}"
        press=".onOpenSendBack"/>
      <!-- "Terminate" in the UI; the stored status code stays REJECTED and e-mails say Rejected. -->
      <Button
        text="{i18n>terminate}"
        icon="sap-icon://decline"
        type="Reject"
        press=".onReject"
        visible="{task>/canTerminate}"/>
    </headerContent>
    <content>
      <VBox>
        <VBox class="caObjectHeader sapUiResponsiveContentPadding">
          <HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap">
            <VBox class="caObjectIdentity">
              <ObjectStatus text="Task" state="Information" inverted="true"/>
              <Title text="{task>/referenceNumber}" level="H1"/>
              <Link text="{task>/request/referenceNumber}" press=".onRequestPress"/>
            </VBox>
            <HBox alignItems="Center">
              <ObjectStatus
                text="{i18n>slaBreachedLabel}"
                icon="sap-icon://lateness"
                state="Error"
                inverted="true"
                class="sapUiSmallMarginEnd"
                visible="{parts: ['task>/slaDueAt', 'task>/status/code', 'task>/slaBreached'], formatter: '.isSlaBreached'}"/>
              <ObjectStatus
                text="{parts: ['task>/status/name', 'task>/status/code'], formatter: '.statusName'}"
                state="{path: 'task>/status/code', formatter: '.statusState'}"
                inverted="true"/>
            </HBox>
          </HBox>
          <MessageStrip
            text="{parts: ['task>/slaDueAt', 'task>/status/code'], formatter: '.formatSlaBreachMessage'}"
            type="Error"
            showIcon="true"
            class="sapUiSmallMarginTop"
            visible="{parts: ['task>/slaDueAt', 'task>/status/code', 'task>/slaBreached'], formatter: '.isSlaBreached'}"/>
          <MessageStrip
            text="{task>/budgetCheckMessage}"
            type="{task>/budgetCheckMessageType}"
            showIcon="true"
            class="sapUiSmallMarginTop"
            visible="{= !!${task>/budgetCheckMessage} }"/>
          <FlexBox wrap="Wrap" class="caFactGrid">
            <VBox class="caFact">
              <Label text="Workflow Step"/>
              <ObjectNumber number="{task>/stepNo}"/>
            </VBox>
            <VBox class="caFact">
              <Label text="Assigned User"/>
              <Text text="{task>/assignedName}"/>
            </VBox>
            <VBox class="caFact">
              <Label text="Assigned Team"/>
              <Text text="{task>/assignedTeamName}"/>
            </VBox>
            <VBox class="caFact">
              <Label text="{i18n>slaDue}"/>
              <Text text="{= ${task>/status/code} === 'IN_PROGRESS' ? 'Paused while the Budget Check runs' : (${task>/slaDueAt} ? ${path: 'task>/slaDueAt', formatter: '.formatDateTime'} : ${path: 'task>/dueDate', formatter: '.formatDate'}) }"/>
              <ObjectStatus
                text="{parts: ['task>/slaDueAt', 'task>/status/code'], formatter: '.formatSlaRemaining'}"
                state="{parts: ['task>/slaDueAt', 'task>/status/code', 'task>/slaBreached'], formatter: '.formatSlaHighlight'}"
                visible="{= ${task>/status/code} === 'OPEN' &amp;&amp; !!${task>/slaDueAt} }"/>
            </VBox>
            <VBox class="caFact">
              <Label text="Mandatory"/>
              <ObjectStatus text="{= ${task>/isMandatory} ? 'Yes' : 'No' }" state="{= ${task>/isMandatory} ? 'Warning' : 'None' }"/>
            </VBox>
          </FlexBox>
        </VBox>

        <VBox class="sapUiResponsiveContentPadding">
          <Panel headerText="Activity" class="caFormSection">
            <content>
              <form:SimpleForm editable="false" layout="ColumnLayout" columnsXL="2" columnsL="2" columnsM="1">
                <Label text="Task"/>
                <Text text="{task>/taskName}"/>
                <Label text="{i18n>description}"/>
                <Text text="{task>/description}"/>
                <Label text="Decision"/>
                <Text text="{task>/decision}"/>
                <Label text="Remarks"/>
                <Text text="{task>/remarks}"/>
              </form:SimpleForm>
            </content>
          </Panel>
          <Panel headerText="Request Context" class="caFormSection">
            <content>
              <form:SimpleForm editable="false" layout="ColumnLayout" columnsXL="2" columnsL="2" columnsM="1">
                <Label text="Request"/>
                <Link text="{task>/request/referenceNumber}" press=".onRequestPress"/>
                <Label text="{i18n>title}"/>
                <Text text="{task>/request/title}"/>
                <Label text="{i18n>requester}"/>
                <Text text="{task>/request/requesterName}"/>
                <Label text="{i18n>status}"/>
                <ObjectStatus text="{parts: ['task>/request/status/name', 'task>/request/status/code'], formatter: '.statusName'}" state="{path: 'task>/request/status/code', formatter: '.statusState'}"/>
              </form:SimpleForm>
            </content>
          </Panel>
          <Panel headerText="Process-Specific Details" class="caFormSection" visible="{= ${task>/isRequesterStep} ? ${task>/hasEditableFields} : ${task>/hasDetailFields} }">
            <content>
              <FlexBox visible="{= !${task>/isRequesterStep} }" items="{task>/detailFields}" wrap="Wrap" renderType="Div" class="caDetailFieldGrid">
                <VBox class="caDetailField">
                  <Label text="{task>label}"/>
                  <Text text="{task>value}" wrapping="true"/>
                </VBox>
              </FlexBox>
              <VBox id="taskDetailFormHost" visible="{= ${task>/isRequesterStep} }"/>
            </content>
          </Panel>

          <Panel headerText="Header Creation" class="caFormSection caItemsSection" visible="{= !${task>/isRequesterStep} &amp;&amp; ${task>/hasDetailHeaders} }">
            <content>
              <Toolbar>
                <ToolbarSpacer/>
                <Button text="Export to Excel" icon="sap-icon://excel-attachment" type="Transparent"
                  press=".onExportTaskTable" app:table="headers" visible="{task>/isAssignedToMe}"/>
              </Toolbar>
              <ScrollContainer horizontal="true" vertical="false" width="100%">
                <Table id="taskHeadersTable" fixedLayout="true" class="caWorklistTable"/>
              </ScrollContainer>
            </content>
          </Panel>
          <Panel headerText="Header Creation" class="caFormSection caItemsSection" visible="{= ${task>/isRequesterStep} &amp;&amp; ${task>/hasEditableHeaders} }">
            <content>
              <Toolbar>
                <ToolbarSpacer/>
                <Button text="Add Row" icon="sap-icon://add" press=".onAddTaskItemRow" app:grid="headers"/>
                <Button text="Export to Excel" icon="sap-icon://excel-attachment" type="Transparent"
                  press=".onExportTaskRows" app:grid="headers"/>
                <unified:FileUploader buttonOnly="true" buttonText="Import" icon="sap-icon://upload"
                  fileType="xlsx,csv" sameFilenameAllowed="true" change=".onImportTaskRows" app:grid="headers"
                  tooltip="Replace the rows with an edited Excel (.xlsx) or CSV file"/>
              </Toolbar>
              <ScrollContainer horizontal="true" vertical="false" width="100%">
                <Table id="taskHeadersEditTable" fixedLayout="true" class="caWorklistTable"/>
              </ScrollContainer>
            </content>
          </Panel>
          <VBox id="taskChangeTablesHost" visible="{= !${task>/isRequesterStep} }"/>
          <Panel headerText="{task>/detailItemsTitle}" class="caFormSection caItemsSection" visible="{= ${task>/isRequesterStep} ? ${task>/hasEditableItems} : ${task>/hasDetailItems} }">
            <content>
              <Toolbar>
                <ToolbarSpacer/>
                <Button text="Add Row" icon="sap-icon://add" press=".onAddTaskItemRow" app:grid="items"
                  visible="{= ${task>/isRequesterStep} }"/>
                <Button text="Export to Excel" icon="sap-icon://excel-attachment" type="Transparent"
                  press=".onExportTaskRows" app:grid="items" visible="{= ${task>/isRequesterStep} }"/>
                <unified:FileUploader buttonOnly="true" buttonText="Import" icon="sap-icon://upload"
                  fileType="xlsx,csv" sameFilenameAllowed="true" change=".onImportTaskRows" app:grid="items"
                  visible="{= ${task>/isRequesterStep} }"
                  tooltip="Replace the rows with an edited Excel (.xlsx) or CSV file"/>
                <Button text="Export to Excel" icon="sap-icon://excel-attachment" type="Transparent"
                  press=".onExportTaskTable" app:table="items" visible="{= !${task>/isRequesterStep} &amp;&amp; ${task>/isAssignedToMe} }"/>
              </Toolbar>
              <ScrollContainer horizontal="true" vertical="false" width="100%">
                <Table id="taskItemsTable" fixedLayout="true" class="caWorklistTable"/>
              </ScrollContainer>
            </content>
          </Panel>
        </VBox>
      </VBox>
    </content>

    <dependents>
      <Dialog id="decisionDialog" title="{decision>/title}" contentWidth="{= ${decision>/lineEntry} ? '52rem' : '34rem' }">
        <content>
          <VBox class="sapUiSmallMargin">
            <!-- Purchase Order, S/4 Data Validation: one or more PO Numbers; the first is mandatory. With
                 Create SES Successor only one, used for the SES (+ disabled). -->
            <Label text="Purchase Order Number" required="true" visible="{= ${decision>/needsPoNumberList} === true }"/>
            <VBox items="{path: 'decision>/poNumberList', templateShareable: false}" visible="{= ${decision>/needsPoNumberList} === true }">
              <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                <Input value="{decision>value}" maxLength="80" width="22rem"
                  placeholder="{= ${decision>first} ? 'Enter the Purchase Order Number' : 'Another Purchase Order Number (optional)' }"/>
                <Button icon="sap-icon://decline" type="Transparent" tooltip="Remove this PO Number"
                  visible="{= !${decision>first} }" press=".onRemovePoNumber"/>
              </HBox>
            </VBox>
            <HBox alignItems="Center" class="sapUiSmallMarginBottom" visible="{= ${decision>/needsPoNumberList} === true }">
              <Button icon="sap-icon://add" text="Add PO Number" type="Transparent" press=".onAddPoNumber"
                enabled="{= !${decision>/poNumberListLocked} }"/>
              <Text text="Create SES Successor: one PO Number, used for the SES" class="caMuted sapUiTinyMarginBegin"
                visible="{= ${decision>/poNumberListLocked} === true }"/>
            </HBox>
            <!-- Last step of a PO with "Create SES Successor": the PO number goes to the SES. -->
            <Label text="Purchase Order Number" required="true" visible="{= ${decision>/needsPoNumber} === true }"/>
            <Input value="{decision>/purchaseOrderNo}" placeholder="Enter the created Purchase Order number"
              visible="{= ${decision>/needsPoNumber} === true }" class="sapUiSmallMarginBottom"/>
            <Label text="GL Account" required="true" visible="{= ${decision>/needsGlAccount} === true }"/>
            <Input value="{decision>/glAccount}" placeholder="Enter the GL Account" maxLength="80"
              visible="{= ${decision>/needsGlAccount} === true }" class="sapUiSmallMarginBottom"/>
            <Label text="Valuation Class" required="true" visible="{= ${decision>/needsValuationClass} === true }"/>
            <Input value="{decision>/valuationClass}" placeholder="Select the Valuation Class" maxLength="40"
              showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onValuationClassHelp"
              visible="{= ${decision>/needsValuationClass} === true }" class="sapUiSmallMarginBottom"/>
            <Label text="Service Code" required="true" visible="{= ${decision>/needsServiceCode} === true }"/>
            <Input value="{decision>/serviceCode}" placeholder="Enter the Service Code" maxLength="80"
              visible="{= ${decision>/needsServiceCode} === true }" class="sapUiSmallMarginBottom"/>
            <Label text="Material Code" required="true" visible="{= ${decision>/needsMaterialCode} === true }"/>
            <Input value="{decision>/materialCode}" placeholder="Enter the Material Code" maxLength="40"
              visible="{= ${decision>/needsMaterialCode} === true }" class="sapUiSmallMarginBottom"/>
            <Label text="Equipment Code" required="true" visible="{= ${decision>/needsEquipmentCode} === true }"/>
            <Input value="{decision>/equipmentCode}" placeholder="Enter the Equipment Code" maxLength="80"
              visible="{= ${decision>/needsEquipmentCode} === true }" class="sapUiSmallMarginBottom"/>
            <!-- Project Code: the Project Code, or the Function Location / Activity per Object Type. -->
            <Label text="{decision>/projectValueLabel}" required="true" visible="{= ${decision>/needsProjectValue} === true }"/>
            <Input value="{decision>/projectValue}" placeholder="{= 'Enter the ' + ${decision>/projectValueLabel} }" maxLength="80"
              visible="{= ${decision>/needsProjectValue} === true }" class="sapUiSmallMarginBottom"/>
            <!-- New SES, Single Line Items: the SES Number created at S/4 Data Validation. -->
            <Label text="SES Number" required="true" visible="{= ${decision>/needsSesNumber} === true }"/>
            <Input value="{decision>/sesNumber}" placeholder="Enter the SES Number" maxLength="80"
              visible="{= ${decision>/needsSesNumber} === true }" class="sapUiSmallMarginBottom"/>
            <!-- Multiple line items (Service Code, Equipment Code, Project Code): one value per line. -->
            <!-- Export the table, fill the value column in Excel, Import it to fill the inputs. -->
            <Toolbar visible="{= !!${decision>/lineEntry} }" style="Clear">
              <Title text="{= ${decision>/lineEntry/title} || (${decision>/lineEntry/label} + ' per line item') }" level="H5"/>
              <ToolbarSpacer/>
              <Button text="Export" icon="sap-icon://excel-attachment" type="Transparent" press=".onExportLineEntry"
                tooltip="Download this table to fill it in Excel"/>
              <unified:FileUploader buttonOnly="true" buttonText="Import" icon="sap-icon://upload"
                fileType="xlsx,csv" sameFilenameAllowed="true" change=".onImportLineEntry"
                tooltip="{= 'Fill the ' + ${decision>/lineEntry/label} + ' column from an edited Excel (.xlsx) or CSV file' }"/>
            </Toolbar>
            <Table items="{path: 'decision>/lineEntryRows', templateShareable: false}"
              visible="{= !!${decision>/lineEntry} }" class="sapUiSizeCompact sapUiSmallMarginBottom">
              <columns>
                <Column width="3rem"><Text text="#"/></Column>
                <Column><Text text="{decision>/lineEntry/info1Label}"/></Column>
                <Column visible="{= !!${decision>/lineEntry/info2Label} }"><Text text="{decision>/lineEntry/info2Label}"/></Column>
                <Column visible="{= !!${decision>/lineEntry/info3Label} }"><Text text="{decision>/lineEntry/info3Label}"/></Column>
                <Column><Label text="{decision>/lineEntry/label}" required="true"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{decision>itemNo}"/>
                    <Text text="{decision>info1}"/>
                    <Text text="{decision>info2}"/>
                    <Text text="{decision>info3}"/>
                    <!-- Valuation Class: value help on its master (lineEntry/lookup). -->
                    <Input value="{decision>value}" maxLength="{decision>/lineEntry/maxLength}"
                      placeholder="{= (${decision>/lineEntry/lookup} ? 'Select the ' : 'Enter the ') + ${decision>/lineEntry/label} }"
                      showValueHelp="{= !!${decision>/lineEntry/lookup} }" valueHelpOnly="{= !!${decision>/lineEntry/lookup} }"
                      valueHelpRequest=".onValuationClassHelp"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
            <!-- Purchase Order, PO Approval Completion: mandatory, just above Remarks. -->
            <Label text="PO Released Date" required="true" visible="{= ${decision>/needsPoReleasedDate} === true }"/>
            <DatePicker value="{decision>/poReleasedDate}" valueFormat="yyyy-MM-dd" displayFormat="medium" width="100%"
              placeholder="Select the PO released date"
              visible="{= ${decision>/needsPoReleasedDate} === true }" class="sapUiSmallMarginBottom"/>
            <Label text="Remarks" required="{= ${decision>/action} === 'reject' }"/>
            <TextArea value="{decision>/remarks}" rows="4" width="100%"/>
          </VBox>
        </content>
        <buttons>
          <Button
            text="{i18n>sendToWorkhub}"
            icon="sap-icon://paper-plane"
            visible="{= ${decision>/action} === 'approve' &amp;&amp; ${decision>/canSendToWorkhub} === true }"
            enabled="{= !${decision>/workhubSent} }"
            press=".onSendPoNumbersToWorkhub"/>
          <Button text="Confirm" type="Emphasized" press=".onConfirmDecision"/>
          <Button text="{i18n>cancel}" press=".onCloseDecision"/>
        </buttons>
      </Dialog>

      <Dialog id="sendBackDialog" title="Send Task Back" contentWidth="38rem">
        <content>
          <form:SimpleForm editable="true" layout="ResponsiveGridLayout" class="sapUiSmallMargin">
            <Label text="Target Step" required="true"/>
            <ComboBox selectedKey="{sendBack>/targetStepNo}" items="{sendBack>/steps}">
              <core:Item key="{sendBack>stepNo}" text="{= ${sendBack>stepNo} + '. ' + ${sendBack>stepName} }"/>
            </ComboBox>
            <Label text="Reason" required="true"/>
            <TextArea value="{sendBack>/remarks}" rows="4"/>
          </form:SimpleForm>
        </content>
        <beginButton>
          <Button text="{i18n>sendBack}" type="Reject" press=".onConfirmSendBack"/>
        </beginButton>
        <endButton>
          <Button text="{i18n>cancel}" press=".onCloseSendBack"/>
        </endButton>
      </Dialog>
    </dependents>
  </Page>
</mvc:View>
