<mvc:View
  controllerName="flowmateca.controller.Reports"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Page class="caPage" showNavButton="true" navButtonPress=".onDashboard" title="{i18n>reportsDashboard}">
    <dependents>
      <Dialog id="drillDialog" title="{drill>/title}" contentWidth="80rem" contentHeight="36rem" resizable="true" draggable="true"
        horizontalScrolling="false" class="sapUiNoContentPadding">
        <content>
          <IconTabBar selectedKey="{drill>/tab}" expandable="false" headerMode="Inline" stretchContentHeight="true" applyContentPadding="false">
            <items>
              <IconTabFilter key="overview" text="{i18n>drillOverview}" icon="sap-icon://business-objects-experience">
                <ScrollContainer vertical="true" height="100%" width="100%">
                  <VBox class="sapUiSmallMargin">
                    <FlexBox wrap="Wrap" class="caFactGrid rptDrillFacts" renderType="Div">
                      <VBox class="caFact"><Label text="{i18n>drillRequests}"/><Title text="{drill>/facts/requests}" level="H3"/></VBox>
                      <VBox class="caFact"><Label text="{i18n>drillTasks}"/><Title text="{drill>/facts/tasks}" level="H3"/></VBox>
                      <VBox class="caFact"><Label text="{i18n>drillOpenTasks}"/><Title text="{drill>/facts/openTasks}" level="H3"/></VBox>
                      <VBox class="caFact"><Label text="{i18n>drillAverageDays}"/><Title text="{drill>/facts/averageDays}" level="H3"/></VBox>
                      <VBox class="caFact"><Label text="{i18n>drillBreached}"/><Title text="{drill>/facts/breached}" level="H3"/></VBox>
                    </FlexBox>
                    <FlexBox class="rptDrillCharts" renderType="Div">
                      <VBox width="100%">
                        <Title text="{i18n>drillByStatus}" level="H5" class="rptChartTitle"/>
                        <VBox id="drillStatusChartHost" width="100%"/>
                      </VBox>
                      <VBox width="100%">
                        <Title text="{i18n>drillSla}" level="H5" class="rptChartTitle"/>
                        <VBox id="drillSlaChartHost" width="100%"/>
                      </VBox>
                      <VBox width="100%">
                        <Title text="{i18n>drillTasksByStep}" level="H5" class="rptChartTitle"/>
                        <VBox id="drillStepChartHost" width="100%"/>
                      </VBox>
                    </FlexBox>
                  </VBox>
                </ScrollContainer>
              </IconTabFilter>
              <IconTabFilter key="requests" text="{i18n>drillRequests}" count="{= ${drill>/requests}.length }">
                <ScrollContainer vertical="true" height="100%" width="100%">
                  <Table items="{drill>/requests}" class="caWorklistTable" growing="true" growingThreshold="50" growingScrollToLoad="true"
                    sticky="ColumnHeaders" noDataText="{i18n>drillNoRequests}">
                    <columns>
                      <Column><Text text="Request ID"/></Column>
                      <Column><Text text="{i18n>poNumber}"/></Column>
                      <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>supplier}"/></Column>
                      <Column><Text text="{i18n>status}"/></Column>
                      <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>drillCurrentStep}"/></Column>
                      <Column hAlign="End"><Text text="{i18n>drillDays}"/></Column>
                      <Column><Text text="SLA"/></Column>
                    </columns>
                    <items>
                      <ColumnListItem type="Navigation" press=".onDrillRequestPress">
                        <cells>
                          <ObjectIdentifier title="{drill>reference}" text="{drill>title}"/>
                          <Text text="{= ${drill>poNumber} || '—' }"/>
                          <Text text="{= ${drill>supplier} || '—' }" class="caWrapCell"/>
                          <ObjectStatus text="{path: 'drill>status', formatter: '.requestStatusText'}" state="{path: 'drill>status', formatter: '.requestStatusState'}"/>
                          <Text text="{= ${drill>currentStep} || '—' }"/>
                          <Text text="{parts: ['drill>elapsedDays', 'drill>targetDays'], formatter: '.daysOfTarget'}"/>
                          <ObjectStatus text="{= ${drill>breached} ? 'Breached' : 'Within SLA' }" state="{= ${drill>breached} ? 'Error' : 'Success' }"/>
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </ScrollContainer>
              </IconTabFilter>
              <IconTabFilter key="tasks" text="{i18n>drillTasks}" count="{= ${drill>/tasks}.length }">
                <ScrollContainer vertical="true" height="100%" width="100%">
                  <Table items="{drill>/tasks}" class="caWorklistTable" growing="true" growingThreshold="50" growingScrollToLoad="true"
                    sticky="ColumnHeaders" noDataText="{i18n>drillNoTasks}">
                    <columns>
                      <Column><Text text="Task ID"/></Column>
                      <Column><Text text="Request ID"/></Column>
                      <Column><Text text="{i18n>drillTask}"/></Column>
                      <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>drillAssignedTo}"/></Column>
                      <Column><Text text="{i18n>status}"/></Column>
                      <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>slaDue}"/></Column>
                      <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>drillCompleted}"/></Column>
                    </columns>
                    <items>
                      <ColumnListItem type="Navigation" press=".onDrillTaskPress">
                        <cells>
                          <ObjectIdentifier title="{drill>referenceNumber}"/>
                          <Text text="{drill>requestReference}"/>
                          <Text text="{= ${drill>stepNo} + '. ' + ${drill>taskName} }" class="caWrapCell"/>
                          <Text text="{= ${drill>assignedName} || ${drill>assignedTeamName} || '—' }" class="caWrapCell"/>
                          <ObjectStatus text="{path: 'drill>status_code', formatter: '.taskStatusText'}" state="{parts: ['drill>status_code', 'drill>slaBreached'], formatter: '.taskStatusState'}"/>
                          <Text text="{path: 'drill>slaDueAt', formatter: '.dateTime'}"/>
                          <Text text="{path: 'drill>completedAt', formatter: '.dateTime'}"/>
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </ScrollContainer>
              </IconTabFilter>
            </items>
          </IconTabBar>
        </content>
        <endButton>
          <Button text="Close" press=".onDrillClose"/>
        </endButton>
      </Dialog>
      <Dialog id="spendDrillDialog" title="{spendDrill>/title}" contentWidth="80rem" contentHeight="36rem" resizable="true" draggable="true"
        horizontalScrolling="false" class="sapUiNoContentPadding">
        <content>
          <IconTabBar selectedKey="{spendDrill>/tab}" expandable="false" headerMode="Inline" stretchContentHeight="true" applyContentPadding="false">
            <items>
              <IconTabFilter key="overview" text="{i18n>drillOverview}" icon="sap-icon://business-objects-experience">
                <ScrollContainer vertical="true" height="100%" width="100%">
                  <VBox class="sapUiSmallMargin">
                    <FlexBox wrap="Wrap" class="caFactGrid rptDrillFacts" renderType="Div">
                      <VBox class="caFact"><Label text="{i18n>spendDrillPos}"/><Title text="{spendDrill>/facts/purchaseOrders}" level="H3"/></VBox>
                      <VBox class="caFact"><Label text="{i18n>spendDrillSuppliers}"/><Title text="{spendDrill>/facts/suppliers}" level="H3"/></VBox>
                      <VBox class="caFact"><Label text="{i18n>spendDrillSpend}"/><Title text="{spendDrill>/facts/spend}" level="H3"/></VBox>
                      <VBox class="caFact" visible="{= !${spendDrill>/inactive} }"><Label text="{i18n>spendDrillPrevious}"/><Title text="{spendDrill>/facts/previous}" level="H3"/></VBox>
                      <VBox class="caFact" visible="{= !${spendDrill>/inactive} }"><Label text="{i18n>spendDrillYears}"/><Title text="{spendDrill>/facts/years}" level="H3"/></VBox>
                    </FlexBox>
                    <Title text="{i18n>spendDrillChart}" level="H5" class="rptChartTitle"/>
                    <VBox id="spendDrillChartHost" width="100%"/>
                    <Text text="{i18n>spendDrillNoSpend}" visible="{= ${spendDrill>/chart}.length === 0 }"/>
                  </VBox>
                </ScrollContainer>
              </IconTabFilter>
              <IconTabFilter key="suppliers" text="{i18n>spendDrillSuppliers}" count="{= ${spendDrill>/suppliers}.length }">
                <ScrollContainer vertical="true" height="100%" width="100%">
                  <Table items="{spendDrill>/suppliers}" class="caWorklistTable" growing="true" growingThreshold="50" growingScrollToLoad="true"
                    sticky="ColumnHeaders" noDataText="{i18n>spendDrillNoSuppliers}">
                    <columns>
                      <Column width="4rem" visible="{= !${spendDrill>/inactive} }"><Text text="{i18n>spendRank}"/></Column>
                      <Column visible="{spendDrill>/inactive}"><Text text="{i18n>spendDrillVendorCode}"/></Column>
                      <Column><Text text="{i18n>spendSupplier}"/></Column>
                      <Column hAlign="End" visible="{= !${spendDrill>/inactive} }"><Text text="{= ${spend>/kpis/currentYear} + ' (LKR Mn)' }"/></Column>
                      <Column hAlign="End" visible="{= !${spendDrill>/inactive} }"><Text text="{= ${spend>/kpis/previousYear} + ' (LKR Mn)' }"/></Column>
                      <Column hAlign="End" visible="{= !${spendDrill>/inactive} }"><Text text="{i18n>spendVariance}"/></Column>
                      <Column hAlign="End"><Text text="{i18n>spendDrillPoCount}"/></Column>
                      <Column hAlign="End" visible="{= !${spendDrill>/inactive} }"><Text text="{i18n>spendShare}"/></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <Text text="{= ${spendDrill>rank} || '—' }"/>
                          <Text text="{spendDrill>vendorCode}"/>
                          <Text text="{spendDrill>supplier}" class="caWrapCell"/>
                          <Text text="{path: 'spendDrill>current', formatter: '.lkrMillions'}"/>
                          <Text text="{path: 'spendDrill>previous', formatter: '.lkrMillions'}"/>
                          <ObjectStatus text="{path: 'spendDrill>variancePercent', formatter: '.varianceText'}" state="{path: 'spendDrill>variancePercent', formatter: '.varianceState'}"/>
                          <Text text="{spendDrill>poCount}"/>
                          <Text text="{path: 'spendDrill>sharePercent', formatter: '.shareText'}"/>
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </ScrollContainer>
              </IconTabFilter>
              <IconTabFilter key="purchaseOrders" text="{i18n>spendDrillPos}" count="{= ${spendDrill>/purchaseOrders}.length }">
                <ScrollContainer vertical="true" height="100%" width="100%">
                  <Table items="{spendDrill>/purchaseOrders}" class="caWorklistTable" growing="true" growingThreshold="50" growingScrollToLoad="true"
                    sticky="ColumnHeaders" noDataText="{i18n>spendDrillNoPos}">
                    <columns>
                      <Column><Text text="{i18n>spendPoNo}"/></Column>
                      <Column><Text text="{i18n>spendSupplier}"/></Column>
                      <Column><Text text="{i18n>spendDate}"/></Column>
                      <Column hAlign="End"><Text text="{i18n>spendAmount}"/></Column>
                      <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>spendAmountLkr}"/></Column>
                      <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>spendBusinessUnit}"/></Column>
                      <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>spendCapexOpex}"/></Column>
                    </columns>
                    <items>
                      <ColumnListItem type="Navigation" press=".onSpendDrillPoPress">
                        <cells>
                          <ObjectIdentifier title="{spendDrill>poNumber}" text="{= ${spendDrill>poNumber} !== ${spendDrill>reference} ? ${spendDrill>reference} : '' }"/>
                          <Text text="{spendDrill>supplier}" class="caWrapCell"/>
                          <Text text="{path: 'spendDrill>date', formatter: '.dayText'}"/>
                          <Text text="{= ${path: 'spendDrill>amount', formatter: '.amountText'} + ' ' + (${spendDrill>currency} || '') }"/>
                          <Text text="{= ${spendDrill>amountLkr} === null ? '—' : ${path: 'spendDrill>amountLkr', formatter: '.amountText'} }"/>
                          <Text text="{spendDrill>division}"/>
                          <Text text="{spendDrill>expenditure}"/>
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </ScrollContainer>
              </IconTabFilter>
            </items>
          </IconTabBar>
        </content>
        <endButton>
          <Button text="Close" press=".onSpendDrillClose"/>
        </endButton>
      </Dialog>
    </dependents>
    <headerContent>
      <Button icon="sap-icon://home" type="Transparent" tooltip="Dashboard" press=".onNavHome"/>
      <Button icon="sap-icon://documents" type="Transparent" tooltip="Requests" visible="{app>/currentUser/canViewAllRequests}" press=".onAllRequests"/>
      <Button icon="sap-icon://task" type="Transparent" tooltip="Tasks" visible="{app>/currentUser/canViewAllTasks}" press=".onTasks"/>
      <Button icon="sap-icon://action-settings" type="Transparent" tooltip="Administration" visible="{app>/currentUser/isAdmin}" press=".onAdmin"/>
    </headerContent>
    <content>
      <VBox class="caDashboard rptTop sapUiResponsiveContentPadding">
        <HBox class="rptHero" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
          <HBox alignItems="Center" class="rptHeroTitle">
            <core:Icon src="sap-icon://line-charts" class="rptHeroIcon"/>
            <VBox>
              <Title text="{i18n>reportsHeroTitle}" level="H1" class="rptHeroHeading"/>
              <Text text="{i18n>reportsHeroSubtitle}" class="rptHeroSubtitle"/>
            </VBox>
          </HBox>
          <VBox class="rptHeroPeriod">
            <Label text="{i18n>reportingPeriod}" labelFor="reportPeriod" design="Bold"/>
            <DateRangeSelection id="reportPeriod" width="25rem" dateValue="{reports>/filters/from}" secondDateValue="{reports>/filters/to}"
              displayFormat="dd MMM yyyy" delimiter="-" change=".onPeriodChange"/>
          </VBox>
        </HBox>
        <OverflowToolbar class="rptReportsBar">
          <Title text="{i18n>reportsBarTitle}" level="H2"/>
          <ToolbarSpacer/>
          <Label text="{i18n>viewLabel}" labelFor="reportDashboard"/>
          <Select id="reportDashboard" width="19rem" selectedKey="{reports>/selectedDashboard}" items="{reports>/dashboards}"
            tooltip="{i18n>selectDashboard}" change=".onApplyFilters">
            <core:Item key="{reports>key}" text="{reports>title}"/>
          </Select>
          <Label text="{i18n>poTypeLabel}" labelFor="reportPoType"/>
          <Select id="reportPoType" width="15rem" selectedKey="{reports>/filters/poType}" items="{reports>/poTypes}"
            tooltip="{i18n>poTypeLabel}" change=".onApplyFilters">
            <core:Item key="{reports>code}" text="{reports>name}"/>
          </Select>
          <Button icon="sap-icon://clear-filter" type="Transparent" tooltip="{i18n>clearFilters}" press=".onResetFilters"/>
          <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onApplyFilters"/>
          <Button icon="sap-icon://pdf-attachment" type="Transparent" tooltip="{i18n>exportPdf}" press=".onExport"
            visible="{= ${reports>/selectedDashboard} !== 'ALL' }"/>
          <MenuButton icon="sap-icon://pdf-attachment" type="Transparent" tooltip="{i18n>exportPdf}"
            visible="{= ${reports>/selectedDashboard} === 'ALL' }">
            <menu>
              <Menu>
                <MenuItem text="{i18n>exportLifecyclePdf}" icon="sap-icon://pdf-attachment" press=".onExportLifecycle"/>
                <MenuItem text="{i18n>exportSpendPdf}" icon="sap-icon://pdf-attachment" press=".onExportSpend"/>
              </Menu>
            </menu>
          </MenuButton>
        </OverflowToolbar>
      </VBox>
      <VBox class="caDashboard rptBody sapUiResponsiveContentPadding" busy="{reports>/loading}" busyIndicatorDelay="0"
        visible="{= ${reports>/selectedDashboard} !== 'SPEND_ANALYSIS' }">
        <Title text="{i18n>poLifecycleSection}" level="H2" class="rptSectionTitle"
          visible="{= ${reports>/selectedDashboard} === 'ALL' }"/>
        <MessageStrip text="{i18n>noPoRequestsInPeriod}" type="Information" showIcon="true" class="sapUiSmallMarginBottom"
          visible="{= ${reports>/loaded} === true &amp;&amp; ${reports>/kpis/totalRequests} === 0 }"/>

        <!-- KPI tiles, in the workspace tile style -->
        <FlexBox wrap="Wrap" class="caTileGrid rptKpiGrid" renderType="Div">
          <GenericTile class="caTile caTileBlue" header="{reports>/kpiTiles/0/label}" subheader="{reports>/kpiTiles/0/caption}" press=".onKpiPress">
            <customData><core:CustomData key="kpiIndex" value="0"/></customData>
            <tileContent>
              <TileContent footer="{reports>/kpiTiles/0/footer}">
                <NumericContent value="{reports>/kpiTiles/0/value}" scale="{reports>/kpiTiles/0/scale}" icon="{reports>/kpiTiles/0/icon}"
                  valueColor="{reports>/kpiTiles/0/valueColor}" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileRed" header="{reports>/kpiTiles/1/label}" subheader="{reports>/kpiTiles/1/caption}" press=".onKpiPress">
            <customData><core:CustomData key="kpiIndex" value="1"/></customData>
            <tileContent>
              <TileContent footer="{reports>/kpiTiles/1/footer}">
                <NumericContent value="{reports>/kpiTiles/1/value}" scale="{reports>/kpiTiles/1/scale}" icon="{reports>/kpiTiles/1/icon}"
                  valueColor="{reports>/kpiTiles/1/valueColor}" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileTeal" header="{reports>/kpiTiles/2/label}" subheader="{reports>/kpiTiles/2/caption}" press=".onKpiPress">
            <customData><core:CustomData key="kpiIndex" value="2"/></customData>
            <tileContent>
              <TileContent footer="{reports>/kpiTiles/2/footer}">
                <NumericContent value="{reports>/kpiTiles/2/value}" scale="{reports>/kpiTiles/2/scale}" icon="{reports>/kpiTiles/2/icon}"
                  valueColor="{reports>/kpiTiles/2/valueColor}" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileGreen" header="{reports>/kpiTiles/3/label}" subheader="{reports>/kpiTiles/3/caption}" press=".onKpiPress">
            <customData><core:CustomData key="kpiIndex" value="3"/></customData>
            <tileContent>
              <TileContent footer="{reports>/kpiTiles/3/footer}">
                <NumericContent value="{reports>/kpiTiles/3/value}" scale="{reports>/kpiTiles/3/scale}" icon="{reports>/kpiTiles/3/icon}"
                  valueColor="{reports>/kpiTiles/3/valueColor}" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileOrange" header="{reports>/kpiTiles/4/label}" subheader="{reports>/kpiTiles/4/caption}" press=".onKpiPress">
            <customData><core:CustomData key="kpiIndex" value="4"/></customData>
            <tileContent>
              <TileContent footer="{reports>/kpiTiles/4/footer}">
                <NumericContent value="{reports>/kpiTiles/4/value}" scale="{reports>/kpiTiles/4/scale}" icon="{reports>/kpiTiles/4/icon}"
                  valueColor="{reports>/kpiTiles/4/valueColor}" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTilePurple" header="{reports>/kpiTiles/5/label}" subheader="{reports>/kpiTiles/5/caption}" press=".onKpiPress">
            <customData><core:CustomData key="kpiIndex" value="5"/></customData>
            <tileContent>
              <TileContent footer="{reports>/kpiTiles/5/footer}">
                <NumericContent value="{reports>/kpiTiles/5/value}" scale="{reports>/kpiTiles/5/scale}" icon="{reports>/kpiTiles/5/icon}"
                  valueColor="{reports>/kpiTiles/5/valueColor}" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
        </FlexBox>

        <Panel headerText="{i18n>trendTitle}" class="caFormSection">
          <content>
            <FlexBox class="rptChartGrid" renderType="Div">
              <VBox width="100%">
                <Title text="{i18n>trendSubtitle}" level="H5" class="rptChartTitle"/>
                <VBox id="trendChartHost" width="100%"/>
              </VBox>
              <VBox width="100%">
                <Title text="{i18n>groupChartTitle}" level="H5" class="rptChartTitle"/>
                <VBox id="groupChartHost" width="100%"/>
              </VBox>
            </FlexBox>
          </content>
        </Panel>

        <Panel headerText="{parts: ['i18n>periodSlaTitle', 'reports>/period'], formatter: '.titleWithPeriod'}" class="caFormSection caItemsSection">
          <content>
            <Table items="{reports>/monthlySla}" class="caWorklistTable" noDataText="{i18n>noData}">
              <columns>
                <Column><Text text="{i18n>metric}"/></Column>
                <Column hAlign="End"><Text text="{i18n>requestsLabel}"/></Column>
                <Column hAlign="End"><Text text="{i18n>slaTargetDays}"/></Column>
                <Column hAlign="End"><Text text="{i18n>slaAchievedDays}"/></Column>
                <Column hAlign="End"><Text text="{i18n>slaPercent}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{reports>label}"/>
                    <Text text="{reports>count}"/>
                    <Text text="{path: 'reports>targetDays', formatter: '.days'}"/>
                    <Text text="{path: 'reports>achievedDays', formatter: '.days'}"/>
                    <ObjectStatus text="{path: 'reports>slaPercent', formatter: '.percent'}" state="{path: 'reports>status', formatter: '.statusState'}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </content>
        </Panel>

        <Panel headerText="{i18n>procurementViewTitle}" class="caFormSection caItemsSection">
          <content>
            <Table id="viewSummaryTable" items="{reports>/views}" mode="SingleSelectMaster" selectionChange=".onViewSelect"
              class="caWorklistTable" noDataText="{i18n>noData}">
              <columns>
                <Column><Text text="{i18n>viewLabel}"/></Column>
                <Column hAlign="End"><Text text="{i18n>poVolume}"/></Column>
                <Column hAlign="End"><Text text="{i18n>slaPercent}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>remarks}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{reports>label}"/>
                    <Text text="{reports>volume}"/>
                    <ObjectStatus text="{path: 'reports>slaPercent', formatter: '.percent'}" state="{path: 'reports>status', formatter: '.statusState'}"/>
                    <Text text="{reports>remarks}" class="caMuted"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
            <Toolbar class="caSectionToolbar" visible="{= ${reports>/selectedView/rows}.length &gt; 0 }">
              <Title text="{reports>/selectedView/label}"/>
            </Toolbar>
            <Table items="{reports>/selectedView/rows}" class="caWorklistTable" visible="{= ${reports>/selectedView/rows}.length &gt; 0 }">
              <columns>
                <Column><Text text="{reports>/selectedView/groupLabel}"/></Column>
                <Column hAlign="End"><Text text="{i18n>poVolume}"/></Column>
                <Column hAlign="End" visible="{= ${reports>/selectedView/layout} === 'VOLUME' }"><Text text="{i18n>share}"/></Column>
                <Column hAlign="End" visible="{= ${reports>/selectedView/layout} === 'STAGES' }"><Text text="{i18n>stageCreated}"/></Column>
                <Column hAlign="End" visible="{= ${reports>/selectedView/layout} === 'STAGES' }"><Text text="{i18n>stageApproved}"/></Column>
                <Column hAlign="End" visible="{= ${reports>/selectedView/layout} === 'STAGES' }"><Text text="{i18n>stageRejected}"/></Column>
                <Column hAlign="End" visible="{= ${reports>/selectedView/layout} === 'STAGES' }"><Text text="{i18n>stagePending}"/></Column>
                <Column hAlign="End" visible="{= ${reports>/selectedView/layout} === 'SLA' }"><Text text="{i18n>slaTargetDays}"/></Column>
                <Column hAlign="End" visible="{= ${reports>/selectedView/layout} === 'SLA' }"><Text text="{i18n>slaAchievedDays}"/></Column>
                <Column hAlign="End"><Text text="{i18n>slaPercent}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{reports>label}"/>
                    <Text text="{reports>volume}"/>
                    <Text text="{path: 'reports>sharePercent', formatter: '.percent'}"/>
                    <Text text="{reports>created}"/>
                    <Text text="{reports>approved}"/>
                    <Text text="{reports>rejected}"/>
                    <Text text="{reports>pending}"/>
                    <Text text="{path: 'reports>targetDays', formatter: '.days'}"/>
                    <Text text="{path: 'reports>achievedDays', formatter: '.days'}"/>
                    <ObjectStatus text="{path: 'reports>slaPercent', formatter: '.percent'}" state="{path: 'reports>status', formatter: '.statusState'}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </content>
        </Panel>

        <Panel headerText="{= ${i18n>slaFailTitle} + ' (' + ${reports>/slaFailures}.length + ')' }" class="caFormSection caItemsSection">
          <content>
            <Table items="{reports>/slaFailures}" growing="true" growingThreshold="10" growingScrollToLoad="false"
              class="caWorklistTable" noDataText="{i18n>noSlaFailures}">
              <columns>
                <Column><Text text="{i18n>poNumber}"/></Column>
                <Column><Text text="{i18n>supplier}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>slaFailReason}"/></Column>
                <Column><Text text="{i18n>failStatus}"/></Column>
                <Column hAlign="End"><Text text="{i18n>daysOfFail}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onFailurePress">
                  <cells>
                    <ObjectIdentifier title="{reports>poNumber}" text="{= ${reports>hasPoNumber} ? ${reports>reference} : '' }"/>
                    <Text text="{= ${reports>supplier} || '—' }" class="caWrapCell"/>
                    <Text text="{reports>reason}" class="caWrapCell"/>
                    <ObjectStatus text="{path: 'reports>failStatus', formatter: '.failText'}" state="{path: 'reports>failStatus', formatter: '.failState'}"/>
                    <ObjectStatus text="{path: 'reports>failDays', formatter: '.daysText'}" state="{path: 'reports>failStatus', formatter: '.failState'}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </content>
        </Panel>

        <Panel headerText="{i18n>groupBreakdownTitle}" class="caFormSection caItemsSection">
          <content>
            <Table items="{reports>/divisionBreakdown}" class="caWorklistTable" noDataText="{i18n>noData}">
              <columns>
                <Column><Text text="{i18n>groupLabel}"/></Column>
                <Column hAlign="End"><Text text="{i18n>poVolume}"/></Column>
                <Column hAlign="End"><Text text="{i18n>slaPercent}"/></Column>
                <Column><Text text="{i18n>status}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{reports>label}"/>
                    <Text text="{reports>volume}"/>
                    <ObjectStatus text="{path: 'reports>slaPercent', formatter: '.percent'}" state="{path: 'reports>status', formatter: '.statusState'}"/>
                    <ObjectStatus text="{path: 'reports>status', formatter: '.statusText'}" state="{path: 'reports>status', formatter: '.statusState'}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </content>
        </Panel>
      </VBox>

      <!-- Spend Analysis: approved POs' LKR spend for the period, compared with a year before -->
      <VBox class="caDashboard rptBody sapUiResponsiveContentPadding" busy="{reports>/loading}" busyIndicatorDelay="0"
        visible="{= ${reports>/selectedDashboard} !== 'PO_LIFECYCLE' }">
        <Title text="{i18n>spendAnalysisSection}" level="H2" class="rptSectionTitle"
          visible="{= ${reports>/selectedDashboard} === 'ALL' }"/>
        <MessageStrip text="{i18n>spendNoPos}" type="Information" showIcon="true" class="sapUiSmallMarginBottom"
          visible="{= ${spend>/loaded} === true &amp;&amp; ${spend>/kpis/poCount} === 0 }"/>
        <MessageStrip text="{parts: ['i18n>spendOtherCurrencies', 'spend>/otherCurrencyCount'], formatter: '.otherCurrencyText'}"
          type="Warning" showIcon="true" class="sapUiSmallMarginBottom" visible="{= ${spend>/otherCurrencyCount} &gt; 0 }"/>

        <FlexBox wrap="Wrap" class="caTileGrid rptKpiGrid rptKpiGrid5" renderType="Div">
          <GenericTile class="caTile caTileBlue" header="{i18n>spendTotal}" subheader="{i18n>spendLkrOnly}" press=".onSpendKpiPress">
            <customData><core:CustomData key="spendKpi" value="TOTAL"/></customData>
            <tileContent>
              <TileContent footer="{path: 'reports>/period', formatter: '.periodText'}">
                <NumericContent value="{path: 'spend>/kpis/totalSpend', formatter: '.tileMillions'}" scale="Mn" truncateValueTo="9"
                  icon="sap-icon://money-bills" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileTeal" header="{i18n>spendActiveSuppliers}" subheader="{i18n>spendActiveCaption}" press=".onSpendKpiPress">
            <customData><core:CustomData key="spendKpi" value="ACTIVE"/></customData>
            <tileContent>
              <TileContent>
                <NumericContent value="{spend>/kpis/activeSuppliers}" icon="sap-icon://supplier" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTilePurple" header="{i18n>spendTopShare}" subheader="{i18n>spendTopShareCaption}" press=".onSpendKpiPress">
            <customData><core:CustomData key="spendKpi" value="TOP10"/></customData>
            <tileContent>
              <TileContent>
                <NumericContent value="{= (${spend>/kpis/topSupplierSharePercent} || 0).toFixed(1) }" scale="%" icon="sap-icon://pie-chart" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileGreen" header="{i18n>spendYoy}"
            subheader="{parts: ['spend>/kpis/currentYear', 'spend>/kpis/previousYear'], formatter: '.yearsText'}" press=".onSpendKpiPress">
            <customData><core:CustomData key="spendKpi" value="YOY"/></customData>
            <tileContent>
              <TileContent>
                <NumericContent value="{path: 'spend>/kpis/yoyVariancePercent', formatter: '.tileVariance'}" scale="%" truncateValueTo="7"
                  icon="{= ${spend>/kpis/yoyVariancePercent} &lt; 0 ? 'sap-icon://trend-down' : 'sap-icon://trend-up' }"
                  valueColor="{= ${spend>/kpis/yoyVariancePercent} &lt; 0 ? 'Error' : 'Good' }" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
          <GenericTile class="caTile caTileRed" header="{i18n>spendInactiveSuppliers}" subheader="{i18n>spendInactiveCaption}" press=".onSpendKpiPress">
            <customData><core:CustomData key="spendKpi" value="INACTIVE"/></customData>
            <tileContent>
              <TileContent>
                <NumericContent value="{spend>/kpis/inactiveSuppliers}" icon="sap-icon://alert" valueColor="Error" withMargin="false"/>
              </TileContent>
            </tileContent>
          </GenericTile>
        </FlexBox>

        <Panel headerText="{i18n>spendChartsTitle}" class="caFormSection">
          <content>
            <FlexBox class="rptChartGrid" renderType="Div">
              <VBox width="100%">
                <Title text="{i18n>spendTopChart}" level="H5" class="rptChartTitle"/>
                <VBox id="spendTopChartHost" width="100%"/>
              </VBox>
              <VBox width="100%">
                <Title text="{i18n>spendYoyChart}" level="H5" class="rptChartTitle"/>
                <VBox id="spendYoyChartHost" width="100%"/>
              </VBox>
            </FlexBox>
          </content>
        </Panel>

        <FlexBox class="rptChartGrid" renderType="Div">
          <Panel headerText="{i18n>spendTopTitle}" class="caFormSection caItemsSection">
            <content>
              <Table items="{spend>/topSuppliers}" class="caWorklistTable" noDataText="{i18n>noData}">
                <columns>
                  <Column width="4rem"><Text text="{i18n>spendRank}"/></Column>
                  <Column><Text text="{i18n>spendSupplier}"/></Column>
                  <Column hAlign="End"><Text text="{i18n>spendAmountMn}"/></Column>
                  <Column hAlign="End"><Text text="{i18n>spendShare}"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{spend>rank}"/>
                      <Text text="{spend>supplier}" class="caWrapCell"/>
                      <Text text="{path: 'spend>amount', formatter: '.lkrMillions'}"/>
                      <Text text="{path: 'spend>sharePercent', formatter: '.shareText'}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </content>
          </Panel>
          <Panel headerText="{i18n>spendYoyTitle}" class="caFormSection caItemsSection">
            <content>
              <Table items="{spend>/yoy}" class="caWorklistTable" noDataText="{i18n>noData}">
                <columns>
                  <Column><Text text="{i18n>spendSupplier}"/></Column>
                  <Column hAlign="End"><Text text="{= ${spend>/kpis/previousYear} + ' (LKR Mn)' }"/></Column>
                  <Column hAlign="End"><Text text="{= ${spend>/kpis/currentYear} + ' (LKR Mn)' }"/></Column>
                  <Column hAlign="End"><Text text="{i18n>spendVariance}"/></Column>
                  <Column hAlign="Center" width="4rem"><Text text="{i18n>spendTrend}"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{spend>supplier}" class="caWrapCell"/>
                      <Text text="{path: 'spend>previous', formatter: '.lkrMillions'}"/>
                      <Text text="{path: 'spend>current', formatter: '.lkrMillions'}"/>
                      <ObjectStatus text="{path: 'spend>variancePercent', formatter: '.varianceText'}" state="{path: 'spend>variancePercent', formatter: '.varianceState'}"/>
                      <core:Icon src="{path: 'spend>trend', formatter: '.trendIcon'}" color="{path: 'spend>trend', formatter: '.trendColor'}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </content>
          </Panel>
        </FlexBox>

        <FlexBox class="rptChartGrid" renderType="Div">
          <Panel headerText="{i18n>spendExpenditureTitle}" class="caFormSection caItemsSection">
            <content>
              <Table items="{spend>/byExpenditure}" class="caWorklistTable" noDataText="{i18n>noData}">
                <columns>
                  <Column><Text text="{i18n>spendCategory}"/></Column>
                  <Column hAlign="End"><Text text="{i18n>spendAmountMn}"/></Column>
                  <Column hAlign="End"><Text text="{i18n>spendShare}"/></Column>
                  <Column width="35%"><Text text="{i18n>spendVisual}"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{spend>label}"/>
                      <Text text="{path: 'spend>amount', formatter: '.lkrMillions'}"/>
                      <Text text="{path: 'spend>sharePercent', formatter: '.shareText'}"/>
                      <ProgressIndicator percentValue="{path: 'spend>sharePercent', formatter: '.shareValue'}" showValue="false" height="0.75rem" class="rptSpendBar"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </content>
          </Panel>
          <Panel headerText="{i18n>spendDivisionTitle}" class="caFormSection caItemsSection">
            <content>
              <Table items="{spend>/byDivision}" class="caWorklistTable" noDataText="{i18n>noData}">
                <columns>
                  <Column><Text text="{i18n>spendBusinessUnit}"/></Column>
                  <Column hAlign="End"><Text text="{i18n>spendAmountMn}"/></Column>
                  <Column hAlign="End"><Text text="{i18n>spendShare}"/></Column>
                  <Column width="35%"><Text text="{i18n>spendVisual}"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{spend>label}" class="caWrapCell"/>
                      <Text text="{path: 'spend>amount', formatter: '.lkrMillions'}"/>
                      <Text text="{path: 'spend>sharePercent', formatter: '.shareText'}"/>
                      <ProgressIndicator percentValue="{path: 'spend>sharePercent', formatter: '.shareValue'}" showValue="false" height="0.75rem" class="rptSpendBar"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </content>
          </Panel>
        </FlexBox>

        <Panel headerText="{i18n>spendRecentTitle}" class="caFormSection caItemsSection">
          <content>
            <Table items="{spend>/recent}" class="caWorklistTable" noDataText="{i18n>noData}">
              <columns>
                <Column><Text text="{i18n>spendPoNo}"/></Column>
                <Column><Text text="{i18n>spendSupplier}"/></Column>
                <Column><Text text="{i18n>spendDate}"/></Column>
                <Column hAlign="End"><Text text="{i18n>spendAmount}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>spendDocCurrency}"/></Column>
                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>spendAmountLkr}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>spendBusinessUnit}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>spendCapexOpex}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onSpendRowPress">
                  <cells>
                    <Text text="{spend>poNumber}"/>
                    <Text text="{spend>supplier}" class="caWrapCell"/>
                    <Text text="{path: 'spend>date', formatter: '.dayText'}"/>
                    <Text text="{path: 'spend>amount', formatter: '.amountText'}"/>
                    <Text text="{spend>currency}"/>
                    <Text text="{path: 'spend>amountLkr', formatter: '.amountText'}"/>
                    <Text text="{spend>division}"/>
                    <Text text="{spend>expenditure}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </content>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
