<mvc:View
  controllerName="flowmateca.controller.RequestDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  xmlns:unified="sap.ui.unified"
  xmlns="sap.m">
  <Page class="caPage caObjectPage" showNavButton="true" navButtonPress=".onClose" title="{detail>/title}">
    <headerContent>
      <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onRefresh"/>
      <Button text="Assign Request" icon="sap-icon://employee" visible="{detail>/canReassign}" press=".onReassignRequest"/>
    </headerContent>
    <content>
      <VBox>
        <VBox class="caObjectHeader sapUiResponsiveContentPadding">
          <HBox alignItems="Start" justifyContent="SpaceBetween" wrap="Wrap">
            <VBox class="caObjectIdentity">
              <ObjectStatus text="{detail>/requestType/name}" state="Information" inverted="true"/>
              <Title text="{detail>/referenceNumber}" level="H1"/>
              <Text text="{detail>/requestVariant/name}" class="caHeaderSubtitle"/>
            </VBox>
            <HBox wrap="Wrap" class="caHeaderActions">
              <ObjectStatus
                text="{parts: ['detail>/status/name', 'detail>/status/code'], formatter: '.statusName'}"
                state="{path: 'detail>/status/code', formatter: '.statusState'}"
                inverted="true"/>
            </HBox>
          </HBox>
          <FlexBox wrap="Wrap" class="caFactGrid">
            <VBox class="caFact">
              <Label text="Requester"/>
              <Text text="{detail>/requesterName}"/>
            </VBox>
            <VBox class="caFact">
              <Label text="Request Owner"/>
              <Text text="{detail>/ownerName}"/>
            </VBox>
            <VBox class="caFact">
              <Label text="Owner Team"/>
              <Text text="{detail>/ownerTeamName}"/>
            </VBox>
            <VBox class="caFact">
              <Label text="Current Step"/>
              <ObjectNumber number="{detail>/currentStep}"/>
            </VBox>
            <VBox class="caFact">
              <Label text="Due Date"/>
              <Text text="{= ${detail>/slaDueAt} ? ${path: 'detail>/slaDueAt', formatter: '.formatDateTime'} : ${path: 'detail>/dueDate', formatter: '.formatDate'} }"/>
            </VBox>
            <VBox class="caFact">
              <Label text="Submitted"/>
              <Text text="{path: 'detail>/submittedAt', formatter: '.formatDate'}"/>
            </VBox>
          </FlexBox>
        </VBox>

        <Panel headerText="Guided Process" class="caProcessPanel" expandable="true" expanded="true">
          <headerToolbar>
            <OverflowToolbar>
              <Title text="Guided Process" level="H3"/>
              <ObjectStatus text="{detail>/processStatusText}" state="Information"/>
              <ToolbarSpacer/>
              <Button
                text="{detail>/myOpenTaskName}"
                icon="sap-icon://edit"
                type="Emphasized"
                visible="{= !!${detail>/myOpenTaskId} }"
                press=".onOpenMyTask"/>
              <Button
                text="{i18n>completeStep}"
                icon="sap-icon://complete"
                type="Emphasized"
                visible="{detail>/canCompleteCurrentStep}"
                press=".onCompleteCurrentStep"/>
            </OverflowToolbar>
          </headerToolbar>
          <content>
            <FlexBox
              items="{detail>/stepInstances}"
              wrap="Wrap"
              alignItems="Start"
              class="caProcessFlow"
              renderType="Div">
              <VBox class="caStepNode" alignItems="Center">
                <Button
                  icon="{path: 'detail>status', formatter: '.stepIcon'}"
                  type="{path: 'detail>status', formatter: '.stepButtonType'}"
                  tooltip="{detail>activityDescription}"
                  press=".onStepPress"
                  class="caMilestone"/>
                <ObjectStatus
                  text="{path: 'detail>status', formatter: '.stepStatusText'}"
                  state="{path: 'detail>status', formatter: '.stepState'}"
                  inverted="true"/>
                <Title text="{detail>stepName}" level="H5"/>
                <Text text="{detail>activityDescription}" maxLines="2" textAlign="Center"/>
                <Text
                  text="Due {path: 'detail>slaDueAt', formatter: '.formatDateTime'}"
                  class="caSlaRemaining"
                  textAlign="Center"
                  visible="{= ${detail>status} === 'OPEN' &amp;&amp; !!${detail>slaDueAt} }"/>
                <Text
                  text="Completed {path: 'detail>completedAt', formatter: '.formatDateTime'}"
                  class="caStepCompleted"
                  textAlign="Center"
                  visible="{= ${detail>status} === 'COMPLETED' &amp;&amp; !!${detail>completedAt} }"/>
                <Text
                  text="by {detail>completedByName}"
                  class="caSlaRemaining"
                  textAlign="Center"
                  visible="{= ${detail>status} === 'COMPLETED' &amp;&amp; !!${detail>completedByName} }"/>
                <Text
                  text="{path: 'detail>slaDays', formatter: '.formatSlaLength'}"
                  class="caSlaRemaining"
                  textAlign="Center"
                  visible="{= ${detail>status} === 'PENDING' &amp;&amp; ${detail>slaDays} > 0 }"/>
                <ObjectStatus
                  text="{i18n>slaBreachedLabel}"
                  icon="sap-icon://lateness"
                  state="Error"
                  inverted="true"
                  visible="{= !!${detail>slaBreached} }"/>
              </VBox>
            </FlexBox>
          </content>
        </Panel>

        <IconTabBar selectedKey="overview" class="caDetailTabs" expandable="false">
          <items>
            <IconTabFilter key="overview" text="Overview" icon="sap-icon://hint">
              <VBox class="sapUiResponsiveContentPadding">
                <Panel headerText="Request Summary" class="caFormSection">
                  <content>
                    <form:SimpleForm
                      editable="false"
                      layout="ColumnLayout"
                      columnsXL="3"
                      columnsL="3"
                      columnsM="2">
                      <Label text="{i18n>title}"/>
                      <Text text="{detail>/title}"/>
                      <Label text="{i18n>description}"/>
                      <Text text="{detail>/description}"/>
                    </form:SimpleForm>
                  </content>
                </Panel>
                <Panel headerText="Process-Specific Details" class="caFormSection">
                  <content>
                    <FlexBox items="{detail>/detailFields}" wrap="Wrap" renderType="Div" class="caDetailFieldGrid">
                      <VBox class="caDetailField">
                        <Label text="{detail>label}"/>
                        <Text text="{detail>value}" wrapping="true"/>
                      </VBox>
                    </FlexBox>
                  </content>
                </Panel>
                <Panel headerText="Header Creation" class="caFormSection caItemsSection" visible="{= ${detail>/hasDetailHeaders} }">
                  <content>
                    <ScrollContainer horizontal="true" vertical="false" width="100%">
                      <Table id="detailHeadersTable" fixedLayout="true" class="caWorklistTable"/>
                    </ScrollContainer>
                  </content>
                </Panel>
                <VBox id="detailChangeTablesHost"/>
                <Panel headerText="{detail>/detailItemsTitle}" class="caFormSection caItemsSection" visible="{= ${detail>/hasDetailItems} }">
                  <content>
                    <ScrollContainer horizontal="true" vertical="false" width="100%">
                      <Table id="detailItemsTable" fixedLayout="true" class="caWorklistTable"/>
                    </ScrollContainer>
                  </content>
                </Panel>
              </VBox>
            </IconTabFilter>

            <IconTabFilter key="tasks" text="Tasks" icon="sap-icon://task" count="{detail>/tasks/count}">
              <VBox class="sapUiResponsiveContentPadding">
                <Toolbar class="caSectionToolbar">
                  <Title text="Request Tasks" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="Add Task" icon="sap-icon://add" type="Emphasized" press=".onOpenAddTaskDialog"/>
                </Toolbar>
                <!-- One line per task: a send-back adds a new task (tagged Sent Back) under the one it replaces. -->
                <Table id="requestTasksTable" items="{detail>/tasks}" itemPress=".onTaskPress" class="caWorklistTable caCompactTasks sapUiSizeCompact">
                  <columns>
                    <Column width="14.5rem"><Text text="Task ID"/></Column>
                    <Column><Text text="Task"/></Column>
                    <Column width="3rem" hAlign="Center"><Text text="Step"/></Column>
                    <Column width="9.5rem"><Text text="Assigned To"/></Column>
                    <Column width="9.5rem"><Text text="{i18n>status}"/></Column>
                    <Column width="12rem"><Text text="SLA"/></Column>
                    <Column width="12rem"><Text text="Completed On"/></Column>
                  </columns>
                  <items>
                    <ColumnListItem type="Navigation">
                      <cells>
                        <Text text="{detail>referenceNumber}" wrapping="false"/>
                        <Text text="{detail>taskName}" tooltip="{detail>description}" wrapping="false"/>
                        <Text text="{detail>stepNo}" wrapping="false"/>
                        <Text text="{= ${detail>assignedName} || ${detail>assignedTeamName} }" wrapping="false"/>
                        <HBox alignItems="Center" wrap="NoWrap">
                          <ObjectStatus text="{parts: ['detail>status/name', 'detail>status/code'], formatter: '.statusName'}" state="{path: 'detail>status/code', formatter: '.statusState'}" inverted="true"/>
                          <ObjectStatus
                            text="Sent Back"
                            state="Warning"
                            inverted="true"
                            class="sapUiTinyMarginBegin"
                            visible="{= !!${detail>reworkOf_ID} }"/>
                        </HBox>
                        <ObjectStatus
                          text="{parts: ['detail>slaDueAt', 'detail>status/code', 'detail>slaBreached'], formatter: '.formatSlaCell'}"
                          state="{parts: ['detail>slaDueAt', 'detail>status/code', 'detail>slaBreached'], formatter: '.formatSlaHighlight'}"/>
                        <Text
                          text="{path: 'detail>completedAt', formatter: '.formatDateTime'}"
                          tooltip="{parts: ['detail>status/code', 'detail>completedByName', 'detail>assignedName'], formatter: '.formatTaskOutcome'}"
                          wrapping="false"/>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </VBox>
            </IconTabFilter>

            <IconTabFilter key="attachments" text="Attachments" icon="sap-icon://attachment" count="{detail>/attachments/count}">
              <VBox class="sapUiResponsiveContentPadding">
                <Toolbar class="caSectionToolbar">
                  <Title text="Attachments" level="H3"/>
                  <ToolbarSpacer/>
                  <unified:FileUploader
                    id="detailAttachmentUploader"
                    multiple="true"
                    uploadOnChange="false"
                    change=".onDetailFilesSelected"
                    buttonOnly="true"
                    buttonText="Upload Supporting Document"
                    icon="sap-icon://upload"
                    visible="{detail>/canContribute}"/>
                </Toolbar>
                <!-- Grouped by field in the controller (_bindAttachments). -->
                <List id="attachmentsList" items="{path: 'detail>/attachments', templateShareable: true}" noDataText="No attachments">
                  <StandardListItem
                    title="{detail>filename}"
                    description="{detail>uploadInfo}"
                    icon="{= ${detail>replacedAt} ? 'sap-icon://document-text' : 'sap-icon://document' }"
                    type="Active"
                    press=".onAttachmentPress"/>
                </List>
              </VBox>
            </IconTabFilter>

            <IconTabFilter key="related" text="Related Requests" icon="sap-icon://chain-link">
              <VBox class="sapUiResponsiveContentPadding">
                <Panel headerText="Predecessor" class="caFormSection">
                  <content>
                    <Link
                      text="{detail>/predecessor/referenceNumber}"
                      visible="{= !!${detail>/predecessor/ID} }"
                      press=".onRelatedRequestPress"/>
                    <Text text="No predecessor request" visible="{= !${detail>/predecessor/ID} }"/>
                  </content>
                </Panel>
                <Panel headerText="Successors" class="caFormSection">
                  <content>
                    <List items="{detail>/successors}" noDataText="No successor requests">
                      <StandardListItem
                        title="{detail>referenceNumber}"
                        description="{detail>title}"
                        type="Navigation"
                        press=".onSuccessorPress"/>
                    </List>
                  </content>
                </Panel>
              </VBox>
            </IconTabFilter>

            <IconTabFilter key="comments" text="Comments" icon="sap-icon://discussion-2" count="{detail>/comments/count}">
              <VBox class="sapUiResponsiveContentPadding">
                <HBox class="caCommentComposer" visible="{detail>/canContribute}">
                  <TextArea id="newComment" rows="2" width="100%" placeholder="Add a comment"/>
                  <Button icon="sap-icon://paper-plane" type="Emphasized" tooltip="Post comment" press=".onAddComment"/>
                </HBox>
                <List items="{detail>/comments}" noDataText="No comments">
                  <FeedListItem
                    sender="{detail>authorName}"
                    text="{detail>comment}"
                    timestamp="{path: 'detail>createdAt', formatter: '.formatDateTime'}"
                    icon="sap-icon://person-placeholder"/>
                </List>
              </VBox>
            </IconTabFilter>

            <IconTabFilter key="history" text="History" icon="sap-icon://history" count="{detail>/history/count}">
              <!-- Left: what happened and when (date and time). Right: the request's data per version. -->
              <HBox class="caHistoryLayout" wrap="Wrap" renderType="Bare">
                <VBox class="caHistoryTimeline" renderType="Bare">
                  <Title text="Activity" level="H4" class="caHistoryHeading"/>
                  <ScrollContainer vertical="true" horizontal="false" height="34rem" width="100%">
                    <List items="{detail>/history}" noDataText="No history entries" class="caHistoryList">
                      <CustomListItem>
                        <HBox class="caHistoryRow" alignItems="Start">
                          <Avatar src="sap-icon://history" displaySize="XS" displayShape="Circle"/>
                          <VBox>
                            <ObjectStatus text="{path: 'detail>action', formatter: '.formatHistoryAction'}" state="Information"/>
                            <Text text="{detail>remarks}" visible="{= !!${detail>remarks} }"/>
                            <Text text="{= ${detail>actorName} + ' · Step ' + ${detail>stepNo} }" class="caMuted"/>
                            <Text text="{path: 'detail>createdAt', formatter: '.formatDateTime'}" class="caMuted"/>
                          </VBox>
                        </HBox>
                      </CustomListItem>
                    </List>
                  </ScrollContainer>
                </VBox>
                <!-- Shown once the request has been sent back; until then Activity takes the width. -->
                <VBox class="caHistoryVersions" renderType="Bare" visible="{detail>/hasSendBack}">
                  <Title text="{= 'Versions (' + ${versions>/count} + ')' }" level="H4" class="caHistoryHeading"/>
                  <Text text="Each page compares a version with the one before it: edited fields are highlighted, and line items show only the fields that changed." class="caMuted caVersionsHint"/>
                  <!-- Page n = Version n and Version n + 1; opens on the latest pair. -->
                  <Toolbar style="Clear" class="caVersionsPager">
                    <Button text="Previous" icon="sap-icon://navigation-left-arrow" type="Transparent"
                      enabled="{= ${versions>/page} > 1 }" press=".onVersionsPrevious"/>
                    <ToolbarSpacer/>
                    <Text text="{versions>/pageText}"/>
                    <ToolbarSpacer/>
                    <Button text="Next" icon="sap-icon://navigation-right-arrow" iconFirst="false" type="Transparent"
                      enabled="{= ${versions>/page} &lt; ${versions>/pageCount} }" press=".onVersionsNext"/>
                  </Toolbar>
                  <ScrollContainer id="versionsScroll" vertical="true" horizontal="true" height="34rem" width="100%" class="caVersionsScroll">
                    <Table id="versionsTable" fixedLayout="true" class="caVersionsTable" noDataText="No data captured"/>
                  </ScrollContainer>
                </VBox>
              </HBox>
            </IconTabFilter>
          </items>
        </IconTabBar>
      </VBox>
    </content>

    <dependents>
      <Dialog id="stepDialog" title="{step>/stepName}" contentWidth="32rem">
        <content>
          <VBox class="sapUiSmallMargin">
            <ObjectStatus text="{path: 'step>/status', formatter: '.stepStatusText'}" state="{path: 'step>/status', formatter: '.stepState'}" inverted="true"/>
            <Title text="Activity" level="H4" class="sapUiSmallMarginTop"/>
            <Text text="{step>/activityDescription}" wrapping="true"/>
          </VBox>
        </content>
        <beginButton>
          <Button text="Close" press=".onCloseStepDialog"/>
        </beginButton>
      </Dialog>

      <Dialog id="addTaskDialog" title="Add Task" contentWidth="42rem">
        <content>
          <form:SimpleForm editable="true" layout="ResponsiveGridLayout" class="sapUiSmallMargin">
            <Label text="Workflow Step" required="true"/>
            <Select selectedKey="{taskForm>/stepNo}" items="{detail>/stepInstances}">
              <core:Item key="{detail>stepNo}" text="{= ${detail>stepNo} + '. ' + ${detail>stepName} }"/>
            </Select>
            <Label text="Task Name" required="true"/>
            <Input value="{taskForm>/taskName}"/>
            <Label text="{i18n>description}"/>
            <TextArea value="{taskForm>/description}" rows="3"/>
            <Label text="Assign User"/>
            <ComboBox
              selectedKey="{taskForm>/assignedUserId}"
              items="{catalog>/Users}"
              showSecondaryValues="true"
              filterSecondaryValues="true">
              <core:ListItem key="{catalog>ID}" text="{catalog>displayName}" additionalText="{catalog>email}"/>
            </ComboBox>
            <Label text="Assign Team"/>
            <ComboBox
              selectedKey="{taskForm>/assignedTeamId}"
              items="{catalog>/Teams}"
              showSecondaryValues="true">
              <core:ListItem key="{catalog>ID}" text="{catalog>name}" additionalText="{catalog>teamCode}"/>
            </ComboBox>
            <Label text="Mandatory"/>
            <CheckBox selected="{taskForm>/isMandatory}"/>
            <Label text="Approval Task"/>
            <CheckBox selected="{taskForm>/isApproval}"/>
            <Label text="{i18n>dueDate}"/>
            <DatePicker value="{taskForm>/dueDate}" valueFormat="yyyy-MM-dd" displayFormat="medium"/>
          </form:SimpleForm>
        </content>
        <beginButton>
          <Button text="{i18n>add}" type="Emphasized" press=".onAddTask"/>
        </beginButton>
        <endButton>
          <Button text="{i18n>cancel}" press=".onCloseAddTaskDialog"/>
        </endButton>
      </Dialog>
    </dependents>
  </Page>
</mvc:View>
