<mvc:View
  controllerName="flowmateca.controller.AllRequests"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Page class="caPage" showNavButton="true" navButtonPress=".onNavHome"
    title="{= ${i18n>allRequests} + ' (' + ${view>/total} + ')' }">
    <headerContent>
      <Button text="Export to Excel" icon="sap-icon://excel-attachment" type="Transparent" press=".onExportExcel"/>
      <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onRefresh"/>
    </headerContent>
    <subHeader>
      <OverflowToolbar class="caFilterBar">
        <SearchField id="allRequestsSearch" width="16rem" placeholder="{i18n>allRequestsSearch}"
          liveChange=".onFilterChange" search=".onFilterChange"/>
        <ComboBox id="allRequestsStatus" width="11rem" placeholder="{i18n>allStatuses}"
          change=".onFilterChange"
          items="{path: '/RequestStatuses', sorter: {path: 'sortOrder'}}">
          <core:Item key="{code}" text="{parts: ['name', 'code'], formatter: '.statusName'}"/>
        </ComboBox>
        <ComboBox id="allRequestsType" width="14rem" placeholder="{i18n>allRequestTypes}"
          change=".onFilterChange"
          items="{path: '/RequestTypes', sorter: {path: 'sortOrder'}}">
          <core:Item key="{code}" text="{name}"/>
        </ComboBox>
        <DatePicker id="allRequestsCreatedFrom" width="10rem" placeholder="{i18n>createdFrom}"
          tooltip="{i18n>createdFrom}" change=".onDateChange"/>
        <DatePicker id="allRequestsCreatedTo" width="10rem" placeholder="{i18n>createdTo}"
          tooltip="{i18n>createdTo}" change=".onDateChange"/>
        <ToolbarSpacer/>
        <Label text="{i18n>sortBy}" labelFor="allRequestsSort"/>
        <Select id="allRequestsSort" width="13rem" selectedKey="{view>/sort}" change=".onSortChange">
          <core:Item key="desc" text="{i18n>sortCreatedDesc}"/>
          <core:Item key="asc" text="{i18n>sortCreatedAsc}"/>
        </Select>
        <Button text="Clear" icon="sap-icon://clear-filter" type="Transparent" tooltip="{i18n>clearFilters}"
          press=".onClearFilters"/>
      </OverflowToolbar>
    </subHeader>
    <content>
      <!-- Columns keep their full width; the card scrolls sideways and down, headers stay in view. -->
      <ScrollContainer horizontal="false" vertical="false" width="100%" class="caWorklistScroll">
        <Table id="allRequestsTable" mode="None" growing="true" growingThreshold="50"
          growingScrollToLoad="false" noDataText="{i18n>noMatchingRequests}"
          updateFinished=".onUpdateFinished" itemPress=".onItemPress" sticky="ColumnHeaders" class="caWorklistTable"
          items="{
            path: '/Requests',
            parameters: {$count: true, $expand: 'requestType,status'},
            sorter: [{path: 'createdAt', descending: true}, {path: 'ID', descending: true}],
            events: {dataReceived: '.onDataReceived'}
          }">
          <columns>
            <Column width="13rem"><Text text="Request ID"/></Column>
            <Column><Text text="{i18n>requestType}"/></Column>
            <Column width="9rem"><Text text="Requester"/></Column>
            <Column><Text text="{i18n>title}"/></Column>
            <Column width="9rem"><Text text="{i18n>status}"/></Column>
            <Column><Text text="{i18n>processorTeam}"/></Column>
            <Column width="9rem"><Text text="{i18n>createdOn}"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation">
              <cells>
                <ObjectIdentifier title="{referenceNumber}"/>
                <Text text="{requestType/name}"/>
                <Text text="{requesterName}"/>
                <Text text="{title}" tooltip="{title}" class="caTitleCell"/>
                <ObjectStatus text="{parts: ['status/name', 'status_code'], formatter: '.statusName'}"
                  state="{path: 'status_code', formatter: '.statusState'}"/>
                <Text text="{ownerTeamName}"/>
                <Text text="{path: 'createdAt', formatter: '.formatDate'}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </ScrollContainer>
    </content>
  </Page>
</mvc:View>
