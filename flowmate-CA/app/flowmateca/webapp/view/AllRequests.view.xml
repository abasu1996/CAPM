<mvc:View
  controllerName="flowmateca.controller.AllRequests"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Page class="caPage" showNavButton="true" navButtonPress=".onNavHome" title="{i18n>allRequests}">
    <headerContent>
      <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onRefresh"/>
    </headerContent>
    <content>
      <VBox class="sapUiResponsiveContentPadding">
        <Text text="{i18n>allRequestsSubtitle}" class="sapUiSmallMarginBottom"/>
        <FlexBox wrap="Wrap" alignItems="End" class="sapUiSmallMarginBottom">
          <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
            <Label text="{i18n>status}" labelFor="allRequestsStatus"/>
            <ComboBox id="allRequestsStatus" width="13rem" placeholder="{i18n>allStatuses}"
              change=".onFilterChange"
              items="{path: '/RequestStatuses', sorter: {path: 'sortOrder'}}">
              <core:Item key="{code}" text="{name}"/>
            </ComboBox>
          </VBox>
          <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
            <Label text="{i18n>requestType}" labelFor="allRequestsType"/>
            <ComboBox id="allRequestsType" width="18rem" placeholder="{i18n>allRequestTypes}"
              change=".onFilterChange"
              items="{path: '/RequestTypes', sorter: {path: 'sortOrder'}}">
              <core:Item key="{code}" text="{name}"/>
            </ComboBox>
          </VBox>
          <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
            <Label text="{i18n>createdFrom}" labelFor="allRequestsCreatedFrom"/>
            <DatePicker id="allRequestsCreatedFrom" width="12rem" change=".onDateChange"/>
          </VBox>
          <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
            <Label text="{i18n>createdTo}" labelFor="allRequestsCreatedTo"/>
            <DatePicker id="allRequestsCreatedTo" width="12rem" change=".onDateChange"/>
          </VBox>
          <Button text="{i18n>clearFilters}" icon="sap-icon://clear-filter" type="Transparent"
            class="sapUiTinyMarginBottom" press=".onClearFilters"/>
        </FlexBox>
        <Table id="allRequestsTable" mode="None" growing="true" growingThreshold="50"
          growingScrollToLoad="false" noDataText="{i18n>noMatchingRequests}"
          updateFinished=".onUpdateFinished" itemPress=".onItemPress" class="caWorklistTable"
          items="{
            path: '/Requests',
            parameters: {$count: true, $expand: 'requestType,status'},
            sorter: [{path: 'createdAt', descending: true}, {path: 'ID', descending: true}],
            events: {dataReceived: '.onDataReceived'}
          }">
          <headerToolbar>
            <OverflowToolbar>
              <Title text="{= ${i18n>allRequests} + ' (' + ${view>/total} + ')' }" level="H2"/>
              <ToolbarSpacer/>
              <SearchField id="allRequestsSearch" width="20rem" placeholder="{i18n>allRequestsSearch}"
                liveChange=".onFilterChange" search=".onFilterChange"/>
            </OverflowToolbar>
          </headerToolbar>
          <columns>
            <Column width="13rem"><Text text="Request ID"/></Column>
            <Column><Text text="{i18n>title}"/></Column>
            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>requestType}"/></Column>
            <Column width="10rem"><Text text="{i18n>status}"/></Column>
            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>processorTeam}"/></Column>
            <Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>createdOn}"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation">
              <cells>
                <ObjectIdentifier title="{referenceNumber}" text="{requesterName}"/>
                <Text text="{title}" maxLines="2"/>
                <Text text="{requestType/name}"/>
                <ObjectStatus text="{status/name}" state="{path: 'status_code', formatter: '.statusState'}"/>
                <Text text="{ownerTeamName}"/>
                <Text text="{path: 'createdAt', formatter: '.formatDate'}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
