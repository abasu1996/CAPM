@host = http://localhost:4004
@service = {{host}}/odata/v4/flowmate
@adminUser = liam.patel@flowmate.demo
@adminPassword = FlowmateAdmin1!
@user = alex.johnson@flowmate.demo
@userPassword = FlowmateUser1!

# Replace these after running the list/read calls below.
@requestId = 00000000-0000-0000-0000-000000000000
@taskId = 00000000-0000-0000-0000-000000000000
@userId = 00000000-0000-0000-0000-000000000000
@managerId = 00000000-0000-0000-0000-000000000000
@teamId = 00000000-0000-0000-0000-000000000000
@partyId = 00000000-0000-0000-0000-000000000000
@attachmentId = 00000000-0000-0000-0000-000000000000

# Deployed technical-client values. Retrieve these from the dedicated
# flowmate-external-api-key service key; never commit the actual secret.
@deployedService = https://dialog-axiata-plc-arize-qas-9339ozek-org-a-qas-org-b-te48c9fbef.cfapps.ap11.hana.ondemand.com/odata/v4/flowmate
@tokenUrl = https://arize-qas-9339ozek.authentication.ap11.hana.ondemand.com/oauth/token
@apiClientId = replace-with-client-id
@apiClientSecret = replace-with-client-secret

### Obtain a technical-client token carrying UserProvisioning
# @name technicalToken
POST {{tokenUrl}}
Authorization: Basic {{apiClientId}} {{apiClientSecret}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials

### Verify the technical client can create a user and synchronize assignments
POST {{deployedService}}/createUserWithTeams
Authorization: Bearer {{technicalToken.response.body.access_token}}
Content-Type: application/json

{
  "userId": null,
  "azureObjectId": null,
  "displayName": "API Provisioned User",
  "email": "api.provisioned.user@flowmate.demo",
  "userPrincipalName": "api.provisioned.user@flowmate.demo",
  "managerId": "{{managerId}}",
  "teamIds": ["{{teamId}}"],
  "isActive": true
}

### Service metadata
GET {{service}}/$metadata
Authorization: Basic {{adminUser}} {{adminPassword}}

### Current user details
POST {{service}}/getCurrentUserDetails
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{}

### Application capabilities
GET {{service}}/getApplicationCapabilities()
Authorization: Basic {{adminUser}} {{adminPassword}}

### User administration capabilities
POST {{service}}/getUserAdministrationCapabilities
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{}

### Request reservation tile counts
GET {{service}}/getRequestReservationCounts()
Authorization: Basic {{user}} {{userPassword}}

### My task tile count
GET {{service}}/getMyTaskCount()
Authorization: Basic {{user}} {{userPassword}}

### My team task tile count
GET {{service}}/getMyTeamTaskCount()
Authorization: Basic {{user}} {{userPassword}}


### ------------------------------------------------------------------------
### Code Lists / Configuration
### ------------------------------------------------------------------------

### Process types
GET {{service}}/ProcessTypes?$top=20&$orderby=code
Authorization: Basic {{adminUser}} {{adminPassword}}

### Process sub types
GET {{service}}/ProcessSubTypes?$top=20&$orderby=code
Authorization: Basic {{adminUser}} {{adminPassword}}

### Process status
GET {{service}}/ProcessStatus?$top=20&$orderby=code
Authorization: Basic {{adminUser}} {{adminPassword}}

### Task status
GET {{service}}/TaskStatus?$top=20&$orderby=code
Authorization: Basic {{adminUser}} {{adminPassword}}

### Request dropdown values
GET {{service}}/RequestDropDown?$top=50&$orderby=code
Authorization: Basic {{adminUser}} {{adminPassword}}

### Request type config
GET {{service}}/RequestType?$top=20
Authorization: Basic {{adminUser}} {{adminPassword}}

### Process step config
GET {{service}}/ProcessStepConfig?$top=50&$orderby=processType_code,stepNo
Authorization: Basic {{adminUser}} {{adminPassword}}

### Create process step config
POST {{service}}/ProcessStepConfig
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{
  "processType_code": "PURCHASE",
  "stepNo": 1,
  "stepName": "Review",
  "activityDescription": "Review the request details.",
  "role": "Reviewer",
  "slaDays": 2,
  "processorTeam_ID": "{{teamId}}",
  "processorTeamName": "Procurement"
}


### ------------------------------------------------------------------------
### Users / Teams
### ------------------------------------------------------------------------

### Users
GET {{service}}/Users?$top=50&$orderby=displayName
Authorization: Basic {{adminUser}} {{adminPassword}}

### Create user, assign manager, and create team memberships atomically
POST {{service}}/createUserWithTeams
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{
  "userId": null,
  "azureObjectId": null,
  "displayName": "New User",
  "email": "new.user@flowmate.demo",
  "userPrincipalName": "new.user@flowmate.demo",
  "managerId": "{{managerId}}",
  "teamIds": ["{{teamId}}"],
  "isActive": true
}

### Update user, manager, and synchronize the complete team membership list
POST {{service}}/createUserWithTeams
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{
  "userId": "{{userId}}",
  "azureObjectId": "azure-object-id",
  "displayName": "Updated User Name",
  "email": "updated.user@flowmate.demo",
  "userPrincipalName": "updated.user@flowmate.demo",
  "managerId": "{{managerId}}",
  "teamIds": ["{{teamId}}"],
  "isActive": true
}

### Teams with members
GET {{service}}/Teams?$top=50&$expand=members
Authorization: Basic {{adminUser}} {{adminPassword}}

### Create team
POST {{service}}/Teams
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{
  "name": "Procurement",
  "description": "Procurement team",
  "active": true
}

### Team members
GET {{service}}/TeamMembers?$top=50&$expand=team,user
Authorization: Basic {{adminUser}} {{adminPassword}}

### Add team member
POST {{service}}/TeamMembers
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{
  "team_ID": "{{teamId}}",
  "user_ID": "{{userId}}",
  "displayName": "Alex Johnson",
  "email": "alex.johnson@flowmate.demo"
}


### ------------------------------------------------------------------------
### Requests
### ------------------------------------------------------------------------

### Process requests
GET {{service}}/ProcessRequests?$top=20&$orderby=createdAt desc
Authorization: Basic {{user}} {{userPassword}}

### Process requests with related data
GET {{service}}/ProcessRequests?$top=10&$expand=tasks,attachments,emailMessages
Authorization: Basic {{user}} {{userPassword}}

### Single request
GET {{service}}/ProcessRequests(guid'{{requestId}}')
Authorization: Basic {{user}} {{userPassword}}

### Create request
POST {{service}}/ProcessRequests
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "title": "API test request",
  "description": "Created from docs/flowmate-local-api.http",
  "processType_code": "PURCHASE",
  "subProcessType_code": "STANDARD",
  "priority": "Medium",
  "status_code": "OPEN",
  "processorTeam_ID": "{{teamId}}",
  "processorTeamName": "Procurement"
}

### Submit request
POST {{service}}/submitRequest
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "requestId": "{{requestId}}"
}

### Reserve request
POST {{service}}/reserveRequest
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "requestId": "{{requestId}}"
}

### Update request status
POST {{service}}/updateRequestStatus
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{
  "requestId": "{{requestId}}",
  "statusCode": "IN_PROGRESS"
}

### Assign request processor
POST {{service}}/assignRequestProcessor
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{
  "requestId": "{{requestId}}",
  "processorUserId": "{{userId}}"
}

### Assign request team
POST {{service}}/assignRequestTeam
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{
  "requestId": "{{requestId}}",
  "teamId": "{{teamId}}"
}


### ------------------------------------------------------------------------
### Tasks
### ------------------------------------------------------------------------

### All process tasks
GET {{service}}/ProcessTasks?$top=20&$orderby=createdAt desc&$expand=request,teamMembers
Authorization: Basic {{adminUser}} {{adminPassword}}

### My assigned tasks
GET {{service}}/MyAssignedTasks?$top=20&$orderby=createdAt desc&$expand=request
Authorization: Basic {{user}} {{userPassword}}

### My team tasks
GET {{service}}/MyTeamTasks?$top=20&$orderby=createdAt desc&$expand=request,teamMembers
Authorization: Basic {{user}} {{userPassword}}

### Request detail tasks
GET {{service}}/RequestDetailTasks?$filter=request_ID eq guid'{{requestId}}'&$orderby=stepNo,createdAt&$expand=teamMembers
Authorization: Basic {{user}} {{userPassword}}

### Single task
GET {{service}}/ProcessTasks(guid'{{taskId}}')
Authorization: Basic {{user}} {{userPassword}}

### Create task
POST {{service}}/ProcessTasks
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "request_ID": "{{requestId}}",
  "stepNo": 1,
  "taskName": "API test task",
  "role": "Processor",
  "isMandatory": true,
  "isTeamTask": true,
  "status_code": "OPEN",
  "processorTeam_ID": "{{teamId}}",
  "processorTeamName": "Procurement",
  "remarks": "Created from API test file"
}

### Task team members
GET {{service}}/ProcessTaskTeamMembers?$top=50&$filter=task_ID eq guid'{{taskId}}'
Authorization: Basic {{user}} {{userPassword}}

### Add task team member
POST {{service}}/ProcessTaskTeamMembers
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "task_ID": "{{taskId}}",
  "user_ID": "{{userId}}",
  "displayName": "Alex Johnson",
  "email": "alex.johnson@flowmate.demo"
}

### Assign team task to me
POST {{service}}/assignTeamTaskToMe
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "taskId": "{{taskId}}"
}

### Assign task processor
POST {{service}}/assignTaskProcessor
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{
  "taskId": "{{taskId}}",
  "processorUserId": "{{userId}}"
}

### Assign task team
POST {{service}}/assignTaskTeam
Authorization: Basic {{adminUser}} {{adminPassword}}
Content-Type: application/json

{
  "taskId": "{{taskId}}",
  "teamId": "{{teamId}}"
}

### Update task status
POST {{service}}/updateTaskStatus
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "taskId": "{{taskId}}",
  "statusCode": "OPEN"
}

### Approve task
POST {{service}}/approveTask
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "taskId": "{{taskId}}",
  "remarks": "Approved from API test file"
}

### Reject task
POST {{service}}/rejectTask
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "taskId": "{{taskId}}",
  "remarks": "Rejected from API test file"
}

### Send task back to previous step
POST {{service}}/sendBack
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "taskId": "{{taskId}}",
  "remarks": "Needs correction",
  "targetStepNo": 1
}


### ------------------------------------------------------------------------
### Guided Process
### ------------------------------------------------------------------------

### Guided process tasks
POST {{service}}/getGuidedProcessTasks
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "requestId": "{{requestId}}"
}

### Analyze guided task completion
POST {{service}}/analyzeGuidedTaskCompletion
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "taskId": "{{taskId}}"
}

### Complete guided task
POST {{service}}/completeGuidedTask
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "taskId": "{{taskId}}",
  "remarks": "Completed from API test file",
  "progressionMode": "NEXT"
}

### Analyze guided step completion
POST {{service}}/analyzeGuidedStepCompletion
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "requestId": "{{requestId}}",
  "stepNo": 1
}

### Complete guided step
POST {{service}}/completeGuidedStep
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "requestId": "{{requestId}}",
  "stepNo": 1,
  "remarks": "Step completed from API test file",
  "progressionMode": "NEXT"
}


### ------------------------------------------------------------------------
### Involved Parties / Comments / History
### ------------------------------------------------------------------------

### Involved parties
GET {{service}}/ProcessInvolvedParties?$filter=request_ID eq guid'{{requestId}}'&$top=50
Authorization: Basic {{user}} {{userPassword}}

### Add involved party
POST {{service}}/ProcessInvolvedParties
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "request_ID": "{{requestId}}",
  "user_ID": "{{userId}}",
  "displayName": "Alex Johnson",
  "email": "alex.johnson@flowmate.demo",
  "purpose": "FYI"
}

### Comments
GET {{service}}/ProcessComments?$filter=request_ID eq guid'{{requestId}}'&$top=50
Authorization: Basic {{user}} {{userPassword}}

### Add comment
POST {{service}}/ProcessComments
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "request_ID": "{{requestId}}",
  "comment": "API test comment"
}

### History
GET {{service}}/ProcessHistory?$filter=request_ID eq guid'{{requestId}}'&$orderby=createdAt desc
Authorization: Basic {{user}} {{userPassword}}


### ------------------------------------------------------------------------
### Attachments / Email
### ------------------------------------------------------------------------

### Attachments for request
GET {{service}}/ProcessAttachments?$filter=request_ID eq guid'{{requestId}}'&$top=50
Authorization: Basic {{user}} {{userPassword}}

### Attachment metadata
GET {{service}}/ProcessAttachments(guid'{{attachmentId}}')
Authorization: Basic {{user}} {{userPassword}}

### Download attachment content
GET {{service}}/ProcessAttachments(guid'{{attachmentId}}')/content
Authorization: Basic {{user}} {{userPassword}}

### Email messages
GET {{service}}/ProcessEmailMessages?$filter=request_ID eq guid'{{requestId}}'&$top=50&$expand=attachments
Authorization: Basic {{user}} {{userPassword}}

### Email attachments
GET {{service}}/ProcessEmailAttachments?$top=50
Authorization: Basic {{user}} {{userPassword}}

### Queue request email
POST {{service}}/sendRequestEmail
Authorization: Basic {{user}} {{userPassword}}
Content-Type: application/json

{
  "requestId": "{{requestId}}",
  "toRecipients": "[{\"email\":\"alex.johnson@flowmate.demo\",\"displayName\":\"Alex Johnson\"}]",
  "ccRecipients": "[]",
  "subject": "Flowmate API test email",
  "body": "This email was queued from docs/flowmate-local-api.http.",
  "attachmentIds": "[]"
}


