      },
      "[hybrid]": {
        "CommonMasterDataService": {
          "kind": "odata-v4",
          "model": "srv/external/common-master",
          "credentials": {
            "destination": "flowmate-common-api"
          }
        },
        "db": {
          "kind": "hana"
        },
        "attachments": {
          "kind": "db",
          "scan": false
        }
      },
      "attachments": {
        "kind": "db",
        "scan": true
      },
      "db": {
        "kind": "sqlite"
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}
