{
  "name": "flowmate",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.12",
    "@cap-js/attachments": "^3.12.2",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "serve-flowmate": "cds serve --in-memory --port 4004",
    "watch-flowmate": "cds watch --in-memory --port 4004 --open flowmate/webapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-flowmate-hybrid": "cds bind --profile hybrid --exec -- cds watch --profile hybrid --port 4004 --open flowmate/webapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-flowmate-dialog": "cds bind --profile Dialog-Hybrid --exec -- cds watch --profile Dialog-Hybrid --port 4004 --open flowmate/webapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-flowmate-flp": "cds watch --in-memory --port 4004 --open \"flowmate/webapp/test/flpSandbox.html#flowmate-openflowmate\" --livereload false",
    "watch-flowmate-flp-hybrid": "cds bind --profile hybrid --exec -- cds watch --profile hybrid --port 4004 --open \"flowmate/webapp/test/flpSandbox.html#flowmate-openflowmate\" --livereload false",
    "watch-flowmate-flp-dialog": "cds bind --profile Dialog-Hybrid --exec -- cds watch --profile Dialog-Hybrid --port 4004 --open \"flowmate/webapp/test/flpSandbox.html#flowmate-openflowmate\" --livereload false",
    "seed:requests:hybrid": "cds bind --profile hybrid --exec -- node scripts/seed-process-requests.js",
    "delete:requests:hybrid": "cds bind --profile hybrid --exec -- node scripts/seed-process-requests.js --delete"
  },
  "private": true,
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "*": false,
            "alice": false,
            "bob": false,
            "carol": false,
            "dave": false,
            "erin": false,
            "fred": false,
            "me": false,
            "yves": false,
            "liam.patel@flowmate.demo": {
              "password": "FlowmateAdmin1!",
              "roles": [
                "Admin"
              ]
            },
            "alex.johnson@flowmate.demo": {
              "password": "FlowmateUser1!"
            },
            "priya.sharma@flowmate.demo": {
              "password": "FlowmateUser1!"
            },
            "daniel.kim@flowmate.demo": {
              "password": "FlowmateUser1!"
            },
            "maya.perera@flowmate.demo": {
              "password": "FlowmateUser1!"
            },
            "sophia.fernando@flowmate.demo": {
              "password": "FlowmateUser1!"
            },
            "emma.silva@flowmate.demo": {
              "password": "FlowmateUser1!"
            }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        },
        "attachments": {
          "kind": "db",
          "scan": false
        }
      },
      "[hybrid]": {
        "db": {
          "kind": "hana"
        },
        "attachments": {
          "kind": "db",
          "scan": false
        }
      },
      "attachments": {
        "kind": "db",
        "scan": true
      },
      "db": {
        "kind": "sqlite"
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}
