            "venkata.manisha@ext.dialog.lk": {
              "password": "FlowmateAdmin1!",
              "roles": [
                "Admin"
              ]
            },
            "liam.patel@flowmate.demo": {
              "password": "FlowmateAdmin1!",
              "roles": [
