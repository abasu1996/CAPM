<mvc:View
    controllerName="flowmate.controller.RequestCreate"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core">
    <f:DynamicPage
        id="requestCreatePage"
        class="flowmatePage"
        toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>requestCreateTitle}" />
                </f:heading>
                <f:actions>
                    <Button
                        icon="sap-icon://home"
                        text="{i18n>dashboardNavButton}"
                        press=".onNavToDashboard" />
                    <Button
                        icon="sap-icon://request"
                        text="{i18n>requestsNavButton}"
                        press=".onNavToRequests" />
                    <Button
                        icon="sap-icon://workflow-tasks"
                        text="{i18n>tasksNavButton}"
                        press=".onNavToTasks" />
                    <Button
                        icon="sap-icon://action-settings"
                        text="{i18n>adminNavButton}"
                        visible="{permissions>/isAdmin}"
                        press=".onNavToAdminConfig" />
                    <Button
                        icon="sap-icon://employee"
                        text="{i18n>delegationsNavButton}"
                        press=".onNavToDelegations" />
                    <Button
                        icon="sap-icon://save"
                        text="{i18n>createButton}"
                        type="Emphasized"
                        enabled="{= !${create>/creating} }"
                        press=".onCreate" />
                    <Button
                        icon="sap-icon://decline"
                        text="{i18n>cancelButton}"
                        enabled="{= !${create>/creating} }"
                        press=".onCancel" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox
                class="flowmateContent flowmateNarrowContent flowmateCreateRequest"
                busy="{create>/creating}"
                busyIndicatorDelay="0">
                <VBox class="flowmateCreateIntro">
                    <ObjectStatus
                        text="{i18n>requestCreateTitle}"
                        state="Information"
                        inverted="true" />
                    <Title
                        text="{i18n>requestOverviewSectionTitle}"
                        level="H2" />
                    <Text
                        text="{i18n>requestCreateIntroText}"
                        wrapping="true" />
                    <ObjectStatus
                        class="sapUiTinyMarginTop"
                        icon="sap-icon://chain-link"
                        text="{= ${create>/predecessorReferenceNumber} ? ${i18n>successorOfRequestLabel} + ' ' + ${create>/predecessorReferenceNumber} : '' }"
                        state="Information"
                        visible="{= !!${create>/predecessorReferenceNumber} }" />
                </VBox>

                <Panel
                    class="flowmateCreateSection flowmateCreateSectionPrimary"
                    backgroundDesign="Transparent"
                    expandable="false">
                    <headerToolbar>
                        <OverflowToolbar>
                            <core:Icon src="sap-icon://request" />
                            <Title text="{i18n>requestOverviewSectionTitle}" level="H3" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <form:SimpleForm
                            class="flowmateCreateForm"
                            editable="true"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="3"
                            labelSpanL="3"
                            labelSpanM="4"
                            columnsXL="2"
                            columnsL="2"
                            columnsM="1"
                            adjustLabelSpan="false">
                            <Label text="{i18n>processTypeLabel}" required="true" />
                            <Input
                                value="{create>/processTypeName}"
                                placeholder="{i18n>chooseProcessTypePlaceholder}"
                                showValueHelp="true"
                                valueHelpOnly="true"
                                valueHelpRequest=".onProcessTypeValueHelpRequest"
                                required="true" />
                            <Label text="{i18n>subProcessTypeLabel}" visible="{create>/hasSubProcessTypes}" required="true" />
                            <Input
                                value="{create>/subProcessTypeName}"
                                placeholder="{i18n>chooseSubProcessTypePlaceholder}"
                                showValueHelp="true"
                                valueHelpOnly="true"
                                required="true"
                                visible="{create>/hasSubProcessTypes}"
                                valueHelpRequest=".onSubProcessTypeValueHelpRequest" />
                            <Label text="{i18n>requestTitleLabel}" required="true" />
                            <Input value="{create>/title}" maxLength="255" required="true" />
                            <Label text="{i18n>linkedRequestLabel}" />
                            <HBox
                                alignItems="Center"
                                width="100%">
                                <Input
                                    value="{= ${create>/predecessorReferenceNumber} ? ${create>/predecessorReferenceNumber} + (${create>/predecessorTitle} ? ' - ' + ${create>/predecessorTitle} : '') : '' }"
                                    placeholder="{i18n>linkedRequestPlaceholder}"
                                    showValueHelp="true"
                                    valueHelpOnly="true"
                                    valueHelpRequest=".onPredecessorRequestValueHelpRequest"
                                    width="100%" />
                                <Button
                                    icon="sap-icon://decline"
                                    tooltip="{i18n>clearLinkedRequestButton}"
                                    enabled="{= !!${create>/predecessor_ID} }"
                                    press=".onClearPredecessorRequest" />
                            </HBox>
                            <Label text="{i18n>priorityLabel}" />
                            <Select selectedKey="{create>/priority}">
                                <core:Item key="Low" text="{i18n>priorityLow}" />
                                <core:Item key="Medium" text="{i18n>priorityMedium}" />
                                <core:Item key="High" text="{i18n>priorityHigh}" />
                                <core:Item key="Critical" text="{i18n>priorityCritical}" />
                            </Select>
                            <Label text="{i18n>departmentLabel}" />
                            <Input value="{create>/department}" maxLength="100" />
                            <Label text="{i18n>descriptionLabel}" />
                            <TextArea value="{create>/description}" rows="5" width="100%" />
                        </form:SimpleForm>
                    </content>
                </Panel>

                <Panel
                    class="flowmateCreateSection"
                    backgroundDesign="Transparent"
                    expandable="false">
                    <headerToolbar>
                        <OverflowToolbar>
                            <core:Icon src="sap-icon://group" />
                            <Title text="{i18n>requestPeopleSectionTitle}" level="H3" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <form:SimpleForm
                            class="flowmateCreateForm"
                            editable="true"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="3"
                            labelSpanL="3"
                            labelSpanM="4"
                            columnsXL="2"
                            columnsL="2"
                            columnsM="1"
                            adjustLabelSpan="false">
                            <Label text="{i18n>requesterLabel}" />
                            <Input
                                value="{create>/requesterName}"
                                editable="false" />
                            <Label text="{i18n>processorTeamLabel}" />
                            <Input
                                value="{create>/processorTeamName}"
                                placeholder="{i18n>selectTeamPlaceholder}"
                                showValueHelp="true"
                                valueHelpOnly="true"
                                valueHelpRequest=".onCreateTeamValueHelpRequest" />
                        </form:SimpleForm>
                    </content>
                </Panel>

                <Panel
                    class="flowmateCreateSection"
                    backgroundDesign="Transparent"
                    expandable="false">
                    <headerToolbar>
                        <OverflowToolbar>
                            <core:Icon src="sap-icon://attachment" />
                            <Title text="{i18n>attachmentsTitle}" level="H3" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="flowmateAttachmentDropZone">
                            <Text
                                class="flowmateSectionHelpText"
                                text="{i18n>asyncAttachmentHelpText}"
                                wrapping="true" />
                            <u:FileUploader
                                id="attachmentsUploader"
                                buttonOnly="true"
                                buttonText="{i18n>chooseDocumentsButton}"
                                change=".onAttachmentsSelected"
                                fileSizeExceed=".onAttachmentFileSizeExceed"
                                icon="sap-icon://attachment"
                                maximumFileSize="400"
                                multiple="true"
                                enabled="{= !${create>/creating} }"
                                sameFilenameAllowed="true" />
                            <List
                                class="sapUiSmallMarginTop flowmateAttachmentList"
                                noDataText="{i18n>noAttachmentsSelectedText}"
                                items="{create>/attachments}">
                                <CustomListItem>
                                    <VBox class="flowmateUploadItem">
                                        <HBox
                                            alignItems="Center"
                                            justifyContent="SpaceBetween"
                                            wrap="Wrap">
                                            <ObjectIdentifier
                                                title="{create>name}"
                                                text="{create>sizeText}" />
                                            <HBox alignItems="Center">
                                                <ObjectStatus
                                                    class="flowmateSemanticStatus"
                                                    text="{create>statusText}"
                                                    state="{create>statusState}"
                                                    inverted="true" />
                                                <Button
                                                    icon="sap-icon://decline"
                                                    enabled="{= !${create>/creating} &amp;&amp; !${create>/uploading} }"
                                                    tooltip="{i18n>removeAttachmentButton}"
                                                    press=".onRemoveAttachment" />
                                            </HBox>
                                        </HBox>
                                        <ProgressIndicator
                                            class="sapUiTinyMarginTop"
                                            visible="{create>showProgress}"
                                            percentValue="{create>progress}"
                                            displayValue="{create>progressText}"
                                            state="{create>statusState}" />
                                    </VBox>
                                </CustomListItem>
                            </List>
                        </VBox>
                    </content>
                </Panel>

                <Panel
                    class="flowmateCreateSection flowmateCreateSubmitSection"
                    backgroundDesign="Transparent"
                    expandable="false"
                    visible="false">
                    <content>
                        <HBox
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                            wrap="Wrap">
                            <VBox>
                                <Title text="{i18n>requestSubmitSectionTitle}" level="H3" />
                                <Text text="{i18n>requestSubmitHelpText}" wrapping="true" />
                            </VBox>
                            <Switch
                                state="{create>/autoSubmit}"
                                customTextOn="{i18n>yesText}"
                                customTextOff="{i18n>noText}" />
                        </HBox>
                    </content>
                </Panel>
            </VBox>
        </f:content>
    </f:DynamicPage>
    <mvc:dependents>
        <TableSelectDialog
            id="predecessorRequestValueHelpDialog"
            title="{i18n>selectLinkedRequestTitle}"
            noDataText="{i18n>noRequestsText}"
            rememberSelections="false"
            search=".onPredecessorRequestValueHelpSearch"
            confirm=".onPredecessorRequestValueHelpConfirm"
            cancel=".onPredecessorRequestValueHelpClose"
            items="{
                path: '/ProcessRequests',
                parameters: {
                    expand: 'processType,subProcessType'
                },
                events: {
                    dataRequested: '.onDataRequested',
                    dataReceived: '.onDataReceived'
                }
            }">
            <columns>
                <Column><Text text="{i18n>referenceNumberLabel}" /></Column>
                <Column><Text text="{i18n>requestTitleLabel}" /></Column>
                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>processTypeLabel}" /></Column>
                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>subProcessTypeLabel}" /></Column>
                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>statusLabel}" /></Column>
                <Column demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>reservedByLabel}" /></Column>
            </columns>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{referenceNumber}" />
                    <Text text="{title}" />
                    <Text text="{= ${processType/name} || ${processType_code} }" />
                    <Text text="{= ${subProcessType/name} || ${subProcessType_code} }" />
                    <Text text="{status_code}" />
                    <Text text="{reservedBy}" />
                </cells>
            </ColumnListItem>
        </TableSelectDialog>
        <TableSelectDialog
            id="processTypeValueHelpDialog"
            title="{i18n>processTypeLabel}"
            noDataText="{i18n>noProcessTypesFoundText}"
            rememberSelections="false"
            search=".onProcessTypeValueHelpSearch"
            confirm=".onProcessTypeValueHelpConfirm"
            cancel=".onProcessTypeValueHelpClose"
            items="{
                path: '/ProcessTypes',
                events: {
                    dataRequested: '.onDataRequested',
                    dataReceived: '.onDataReceived'
                }
            }">
            <columns>
                <Column>
                    <Text text="{i18n>processTypeCodeLabel}" />
                </Column>
                <Column>
                    <Text text="{i18n>processTypeNameLabel}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Tablet">
                    <Text text="{i18n>processTypeDescriptionLabel}" />
                </Column>
            </columns>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{code}" />
                    <Text text="{name}" />
                    <Text text="{descr}" />
                </cells>
            </ColumnListItem>
        </TableSelectDialog>
        <TableSelectDialog
            id="subProcessTypeValueHelpDialog"
            title="{i18n>subProcessTypeLabel}"
            noDataText="{i18n>noSubProcessTypesFoundText}"
            rememberSelections="false"
            search=".onSubProcessTypeValueHelpSearch"
            confirm=".onSubProcessTypeValueHelpConfirm"
            cancel=".onSubProcessTypeValueHelpClose"
            items="{
                path: '/ProcessSubTypes',
                events: {
                    dataRequested: '.onDataRequested',
                    dataReceived: '.onDataReceived'
                }
            }">
            <columns>
                <Column><Text text="{i18n>processTypeCodeLabel}" /></Column>
                <Column><Text text="{i18n>processTypeNameLabel}" /></Column>
                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>processOwnerLabel}" /></Column>
                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>sapTCodeLabel}" /></Column>
            </columns>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{code}" />
                    <Text text="{name}" />
                    <Text text="{processOwner}" />
                    <Text text="{sapTCode}" />
                </cells>
            </ColumnListItem>
        </TableSelectDialog>
        <TableSelectDialog
            id="requestCreateTeamValueHelpDialog"
            title="{i18n>selectTeamTitle}"
            noDataText="{i18n>noTeamsFoundText}"
            rememberSelections="false"
            search=".onCreateTeamValueHelpSearch"
            confirm=".onCreateTeamValueHelpConfirm"
            cancel=".onCreateTeamValueHelpClose"
            items="{
                path: '/Teams',
                filters: [{ path: 'isActive', operator: 'EQ', value1: true }],
                events: {
                    dataRequested: '.onDataRequested',
                    dataReceived: '.onDataReceived'
                }
            }">
            <columns>
                <Column><Text text="{i18n>teamCodeLabel}" /></Column>
                <Column><Text text="{i18n>teamNameLabel}" /></Column>
            </columns>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{teamCode}" />
                    <Text text="{name}" />
                </cells>
            </ColumnListItem>
        </TableSelectDialog>
    </mvc:dependents>
</mvc:View>
