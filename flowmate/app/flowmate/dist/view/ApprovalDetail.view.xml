<mvc:View
    controllerName="flowmate.controller.ApprovalDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <f:DynamicPage
        id="approvalDetailPage"
        class="flowmatePage"
        toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{taskName}" />
                </f:heading>
                <f:actions>
                    <Button
                        icon="sap-icon://home"
                        text="{i18n>dashboardNavButton}"
                        press=".onNavToDashboard" />
                    <Button
                        icon="sap-icon://group"
                        text="{i18n>teamTasksNavButton}"
                        press=".onNavToTeamTasks" />
                    <Button
                        icon="sap-icon://request"
                        text="{i18n>requestsNavButton}"
                        press=".onNavToRequests" />
                    <Button
                        icon="sap-icon://workflow-tasks"
                        text="{i18n>tasksNavButton}"
                        press=".onNavToTasks" />
                    <Button
                        icon="sap-icon://add-document"
                        text="{i18n>createRequestButton}"
                        press=".onNavToCreateRequest" />
                    <Button
                        icon="sap-icon://action-settings"
                        text="{i18n>adminNavButton}"
                        visible="{permissions>/isAdmin}"
                        press=".onNavToAdminConfig" />
                    <Button
                        icon="sap-icon://employee"
                        text="{i18n>delegationsNavButton}"
                        press=".onNavToDelegations" />
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="{i18n>refreshButton}"
                        press=".onRefresh" />
                    <Button
                        icon="sap-icon://email"
                        text="{i18n>notifyProcessorButton}"
                        press=".onNotifyProcessor" />
                    <Button
                        icon="sap-icon://group"
                        text="{i18n>notifyTeamMembersButton}"
                        visible="{= !!${processorTeam_ID} }"
                        press=".onNotifyTaskTeamMembers" />
                    <Button
                        text="{i18n>approveButton}"
                        type="Accept"
                        enabled="{= ${status_code} !== 'APPROVED' &amp;&amp; ${status_code} !== 'REJECTED' }"
                        press=".onApprove" />
                    <Button
                        text="{i18n>sendBackButton}"
                        enabled="{= ${status_code} !== 'APPROVED' &amp;&amp; ${status_code} !== 'REJECTED' }"
                        press=".onSendBack" />
                    <Button
                        text="{i18n>rejectButton}"
                        type="Reject"
                        enabled="{= ${status_code} !== 'APPROVED' &amp;&amp; ${status_code} !== 'REJECTED' }"
                        press=".onReject" />
                    <Button
                        icon="sap-icon://decline"
                        text="{i18n>closeButton}"
                        press=".onClose" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="flowmateContent flowmateNarrowContent">

                <!-- Header: task id, request id (link), request title, processor, step ... -->
                <ObjectHeader
                    class="flowmateSurface"
                    title="{taskName}"
                    intro="{= ${request/title} || ${request/referenceNumber} }">
                    <attributes>
                        <ObjectAttribute
                            title="{i18n>taskIdLabel}"
                            text="{referenceNumber}" />
                        <ObjectAttribute
                            title="{i18n>requestIdLabel}"
                            text="{request/referenceNumber}"
                            active="true"
                            press=".onRelatedRequestPress" />
                            
                        <ObjectAttribute
                            title="{i18n>processorLabel}"
                            text="{processor}" />
                        <ObjectAttribute
                            title="{i18n>processorTeamLabel}"
                            text="{processorTeamName}" />
                        <ObjectAttribute
                            title="{i18n>stepLabel}"
                            text="{stepNo}" />
                        <ObjectAttribute
                            title="{i18n>mandatoryLabel}"
                            text="{= ${isMandatory} ? ${i18n>mandatoryLabel} : ${i18n>optionalLabel} }" />
                        <ObjectAttribute
                            title="{i18n>roleLabel}"
                            text="{role}" />
                    </attributes>
                </ObjectHeader>
                <ObjectStatus
                    class="sapUiSmallMarginTop flowmateSemanticStatus"
                    title="{i18n>statusLabel}"
                    text="{path: 'status_code', formatter: '.formatStatusText'}"
                    state="{path: 'status_code', formatter: '.formatStatusState'}"
                    inverted="true" />

                <!-- Processor editor -->
                <HBox
                    class="sapUiSmallMarginTop flowmateDetailBlock flowmateStatusRow"
                    alignItems="End">
                    <VBox class="flowmateStatusEditor">
                        <Label text="{i18n>processorLabel}" />
                        <Input
                            width="12rem"
                            value="{processorEdit>/processorName}"
                            placeholder="{i18n>selectProcessorPlaceholder}"
                            showValueHelp="true"
                            showSuggestion="true"
                            startSuggestion="1"
                            filterSuggests="false"
                            suggest=".onUserSuggest"
                            suggestionItemSelected=".onProcessorSuggestionSelected"
                            liveChange=".onProcessorLiveChange"
                            enabled="{= !${processorTeam_ID} &amp;&amp; !${processorUser_ID} &amp;&amp;${status_code} !== 'APPROVED'&amp;&amp; ${request/status_code} !== 'COMPLETED' &amp;&amp; ${request/status_code} !== 'REJECTED' }"
                            valueHelpRequest=".onProcessorValueHelpRequest"
                            suggestionItems="{/Users}">
                            <suggestionItems>
                                <core:ListItem key="{ID}" text="{displayName}" additionalText="{email}" />
                            </suggestionItems>
                        </Input>
                    </VBox>
                    <Button
                        class="sapUiTinyMarginBegin"
                        icon="sap-icon://save"
                        text="{i18n>saveProcessorButton}"
                        type="Emphasized"
                        enabled="{= !${processorTeam_ID} &amp;&amp; !${processorUser_ID} &amp;&amp; ${status_code} !== 'APPROVED'&amp;&amp; ${request/status_code} !== 'COMPLETED' &amp;&amp; ${request/status_code} !== 'REJECTED' }"
                        press=".onSaveTaskProcessor" />
                </HBox>

                <!-- Task details: request link, purpose (all normal / additional tasks), decision -->
                <VBox class="sapUiSmallMarginTop flowmateDetailBlock">
                    <Label text="{i18n>requestIdLabel}" />
                    <Link
                        text="{request/referenceNumber}"
                        press=".onRelatedRequestPress" />
                    <Label
                        class="sapUiSmallMarginTop"
                        text="{i18n>purposeLabel}"
                        visible="{= !!${purpose} &amp;&amp; ${taskName} !== 'Treasury Confirmation' &amp;&amp; ${taskName} !== 'WHT Clearance' &amp;&amp; ${taskName} !== 'Budget Check' }" />
                    <Text
                        text="{purpose}"
                        wrapping="true"
                        visible="{= !!${purpose} &amp;&amp; ${taskName} !== 'Treasury Confirmation' &amp;&amp; ${taskName} !== 'WHT Clearance' &amp;&amp; ${taskName} !== 'Budget Check' }" />
                    <Label
                        class="sapUiSmallMarginTop"
                        text="{i18n>decisionLabel}" />
                    <Text text="{decision}" />
                </VBox>

                <!-- Budget Check -->
                <VBox
                    class="sapUiSmallMarginTop flowmateDetailBlock"
                    visible="{= ${taskName} === 'Budget Check' }">
                    <Title text="Budget Check" level="H3" class="sapUiSmallMarginBottom" />
                    <Label text="{i18n>purposeLabel}" />
                    <Text text="{purpose}" wrapping="true" />
                </VBox>

                <!-- Treasury Confirmation -->
                <VBox
                    class="sapUiSmallMarginTop flowmateDetailBlock"
                    visible="{= ${taskName} === 'Treasury Confirmation' }">
                    <Title
                        text="Treasury Confirmation"
                        level="H3"
                        class="sapUiSmallMarginBottom" />
                    <ScrollContainer width="100%" height="18rem" horizontal="true" vertical="true">
                        <Table width="110rem" fixedLayout="false" items="{path: 'treasuryEntries'}" growing="true">
                            <columns>
                                <Column><Text text="{i18n>paymentReceivedDateLabel}" /></Column>
                                <Column><Text text="{i18n>treasuryRequestDateLabel}" /></Column>
                                <Column><Text text="{i18n>entityLabel}" /></Column>
                                <Column><Text text="{i18n>bankNameLabel}" /></Column>
                                <Column><Text text="{i18n>debitAccountLabel}" /></Column>
                                <Column><Text text="{i18n>beneficiaryLabel}" /></Column>
                                <Column><Text text="{i18n>currencyLabel}" /></Column>
                                <Column><Text text="{i18n>amountLabel}" /></Column>
                                <Column><Text text="{i18n>dueDateLabel}" /></Column>
                                <Column><Text text="{i18n>paymentModeLabel}" /></Column>
                                <Column><Text text="{i18n>userDivisionRepresentativeNameLabel}" /></Column>
                                <Column><Text text="{i18n>i2pTeamMemberLabel}" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <Text text="{path: 'paymentReceivedDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy-MM-dd'}}" />
                                    <Text text="{path: 'treasuryRequestDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy-MM-dd'}}" />
                                    <Text text="{entity_code}" />
                                    <Text text="{bankName}" />
                                    <Text text="{debitAccount}" />
                                    <Text text="{beneficiary}" />
                                    <Text text="{currency_code}" />
                                    <Text text="{amount}" />
                                    <Text text="{path: 'dueDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy-MM-dd'}}" />
                                    <Text text="{paymentMode}" />
                                    <Text text="{userDivisionRepresentative}" />
                                    <Text text="{i2pTeamMember}" />
                                </ColumnListItem>
                            </items>
                        </Table>
                    </ScrollContainer>
                    <VBox class="sapUiSmallMarginTop" width="100%">
                        <Label text="{i18n>purposeLabel}" />
                        <Text text="{purpose}" wrapping="true" />
                    </VBox>
                </VBox>

                <!-- WHT Clearance -->
                <VBox
                    class="sapUiSmallMarginTop flowmateDetailBlock"
                    visible="{= ${taskName} === 'WHT Clearance' }">
                    <Title
                        text="WHT Clearance"
                        level="H3"
                        class="sapUiSmallMarginBottom" />
                    <ScrollContainer width="100%" height="18rem" horizontal="true" vertical="true">
                        <Table width="62rem" fixedLayout="false" items="{path: 'whtEntries'}" growing="true">
                            <columns>
                                <Column><Text text="{i18n>entityLabel}" /></Column>
                                <Column><Text text="{i18n>vendorLabel}" /></Column>
                                <Column><Text text="{i18n>currencyLabel}" /></Column>
                                <Column><Text text="{i18n>amountLabel}" /></Column>
                                <Column><Text text="{i18n>dueDateLabel}" /></Column>
                                <Column><Text text="{i18n>userDivisionRepresentativeNameLabel}" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <Text text="{entity_code}" />
                                    <Text text="{vendor}" />
                                    <Text text="{currency_code}" />
                                    <Text text="{amount}" />
                                    <Text text="{path: 'dueDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy-MM-dd'}}" />
                                    <Text text="{userDivisionRepresentative}" />
                                </ColumnListItem>
                            </items>
                        </Table>
                    </ScrollContainer>
                    <VBox class="sapUiSmallMarginTop" width="100%">
                        <Label text="{i18n>purposeLabel}" />
                        <Text text="{purpose}" wrapping="true" />
                    </VBox>
                </VBox>

                <!-- GFA confirmation -->
                <VBox
                    class="sapUiSmallMarginTop flowmateDetailBlock"
                    width="24rem"
                    visible="{= ${request/subProcessType_code} === 'NON_PO_MISC_RECEIPTS' &amp;&amp; ${stepNo} === 2 }">
                    <Title
                        text="{i18n>gfaConfirmationSectionTitle}"
                        level="H3"
                        class="sapUiSmallMarginBottom" />
                    <Label text="{i18n>debitGLLabel}" required="true" />
                    <Input
                        id="gfaDebitGL"
                        value="{request/debitGL}"
                        maxLength="50"
                        placeholder="{i18n>debitGLPlaceholder}"
                        enabled="{= ${status_code} !== 'APPROVED' &amp;&amp; ${status_code} !== 'REJECTED' }" />
                </VBox>

                <!-- IV confirmation -->
                <VBox
                    class="sapUiSmallMarginTop flowmateDetailBlock"
                    width="24rem"
                    visible="{= ${request/subProcessType_code} === 'NON_PO_TAX_LIAB_PAY_PAYORDER' &amp;&amp; ${taskName} === 'IV Confirmation and Document Archiving' }">
                    <Title
                        text="{i18n>ivConfirmationSectionTitle}"
                        level="H3"
                        class="sapUiSmallMarginBottom" />
                    <Label text="{i18n>entityLabel}" />
                    <Text text="{request/businessEntity_code}" class="sapUiTinyMarginBottom" />
                    <Label text="{i18n>taxTypeLabel}" />
                    <Text text="{request/taxType}" class="sapUiSmallMarginBottom" />
                    <Label text="{i18n>voucherNumberLabel}" required="true" />
                    <Input
                        id="ivVoucherNumberInput"
                        value="{request/voucherNumber}"
                        maxLength="50"
                        placeholder="{i18n>voucherNumberPlaceholder}"
                        enabled="{= ${status_code} !== 'APPROVED' &amp;&amp; ${status_code} !== 'REJECTED' }" />
                    <Label text="{i18n>ivConfirmationValueLabel}" required="true" class="sapUiTinyMarginTop" />
                    <Input
                        id="ivConfirmationValueInput"
                        value="{request/ivConfirmationValue}"
                        type="Number"
                        placeholder="{i18n>ivConfirmationValuePlaceholder}"
                        enabled="{= ${status_code} !== 'APPROVED' &amp;&amp; ${status_code} !== 'REJECTED' }" />
                    <Label text="{i18n>bankStatusLabel}" required="true" class="sapUiTinyMarginTop" />
                    <Input
                        id="ivBankStatusInput"
                        value="{request/bankStatus}"
                        maxLength="50"
                        placeholder="{i18n>bankStatusPlaceholder}"
                        enabled="{= ${status_code} !== 'APPROVED' &amp;&amp; ${status_code} !== 'REJECTED' }" />
                </VBox>

                <!-- Remarks -->
                <VBox class="sapUiSmallMarginTop flowmateDetailBlock flowmateRemarks">
                    <Label text="{i18n>remarksLabel}" />
                    <TextArea
                        id="remarksTextArea"
                        class="sapUiTinyMarginTop"
                        rows="6"
                        width="100%"
                        value="{remarks}"
                        editable="{= ${status_code} !== 'APPROVED' &amp;&amp; ${status_code} !== 'REJECTED' }" />
                </VBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
    <mvc:dependents>
        <TableSelectDialog
            id="approvalDetailProcessorValueHelpDialog"
            title="{i18n>selectProcessorTitle}"
            noDataText="{i18n>noUsersFoundText}"
            rememberSelections="false"
            search=".onProcessorValueHelpSearch"
            confirm=".onProcessorValueHelpConfirm"
            cancel=".onProcessorValueHelpClose"
            items="{
                path: '/Users',
                filters: [{ path: 'isActive', operator: 'EQ', value1: true }],
                events: {
                    dataRequested: '.onDataRequested',
                    dataReceived: '.onDataReceived'
                }
            }">
            <columns>
                <Column><Text text="{i18n>userNameLabel}" /></Column>
                <Column><Text text="{i18n>emailLabel}" /></Column>
                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>departmentLabel}" /></Column>
            </columns>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{displayName}" />
                    <Text text="{email}" />
                    <Text text="{department}" />
                </cells>
            </ColumnListItem>
        </TableSelectDialog>
    </mvc:dependents>
</mvc:View>