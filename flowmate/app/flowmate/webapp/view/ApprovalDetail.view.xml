<mvc:View
    controllerName="flowmate.controller.ApprovalDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">
    <f:DynamicPage
        id="approvalDetailPage"
        class="flowmatePage"
        toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{taskName}" />
                </f:heading>
                <f:actions>
                    <Button
                        icon="sap-icon://home"
                        text="{i18n>dashboardNavButton}"
                        press=".onNavToDashboard" />
                    <Button
                        icon="sap-icon://request"
                        text="{i18n>requestsNavButton}"
                        press=".onNavToRequests" />
                    <Button
                        icon="sap-icon://workflow-tasks"
                        text="{i18n>tasksNavButton}"
                        press=".onNavToTasks" />
                    <Button
                        icon="sap-icon://add-document"
                        text="{i18n>createRequestButton}"
                        press=".onNavToCreateRequest" />
                    <Button
                        icon="sap-icon://action-settings"
                        text="{i18n>adminNavButton}"
                        visible="{permissions>/isAdmin}"
                        press=".onNavToAdminConfig" />
                    <Button
                        icon="sap-icon://employee"
                        text="{i18n>delegationsNavButton}"
                        press=".onNavToDelegations" />
                    <Button
                        icon="sap-icon://email"
                        text="{i18n>notifyAssigneeButton}"
                        press=".onNotifyAssignee" />
                    <Button
                        text="{i18n>approveButton}"
                        type="Accept"
                        press=".onApprove" />
                    <Button
                        text="{i18n>sendBackButton}"
                        press=".onSendBack" />
                    <Button
                        text="{i18n>rejectButton}"
                        type="Reject"
                        press=".onReject" />
                    <Button
                        icon="sap-icon://decline"
                        text="{i18n>closeButton}"
                        press=".onClose" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="flowmateContent flowmateNarrowContent">
                <ObjectHeader
                    class="flowmateSurface"
                    title="{taskName}"
                    intro="{request/title}"
                    number="{status_code}"
                    numberState="{path: 'status_code', formatter: '.formatStatusState'}"
                    numberUnit="{role}">
                    <attributes>
                        <ObjectAttribute
                            title="{i18n>assignedToLabel}"
                            text="{assignedTo}" />
                        <ObjectAttribute
                            title="{i18n>stepLabel}"
                            text="{stepNo}" />
                    </attributes>
                </ObjectHeader>
                <VBox class="sapUiSmallMarginTop flowmateDetailBlock flowmateRemarks">
                    <Label text="{i18n>remarksLabel}" />
                    <TextArea
                        id="remarksTextArea"
                        class="sapUiTinyMarginTop"
                        rows="6"
                        width="100%" />
                </VBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
