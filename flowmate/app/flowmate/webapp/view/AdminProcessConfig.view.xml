<mvc:View
    controllerName="flowmate.controller.AdminProcessConfig"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <f:DynamicPage
        id="adminProcessConfigPage"
        class="flowmatePage"
        fitContent="true"
        toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>adminConfigTitle}" />
                </f:heading>
                <f:actions>
                    <Button icon="sap-icon://home" text="{i18n>dashboardNavButton}" press=".onNavToDashboard" />
                    <Button icon="sap-icon://request" text="{i18n>requestsNavButton}" press=".onNavToRequests" />
                    <Button icon="sap-icon://workflow-tasks" text="{i18n>tasksNavButton}" press=".onNavToTasks" />
                    <Button icon="sap-icon://add-document" text="{i18n>createRequestButton}" press=".onNavToCreateRequest" />
                    <Button icon="sap-icon://employee" text="{i18n>delegationsNavButton}" press=".onNavToDelegations" />
                    <Button icon="sap-icon://group" text="{i18n>userAdminNavButton}" press=".onNavToUserAdministration" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="flowmateContent">
                <IconTabBar class="flowmateSurface flowmateAdminConfig" expandable="false">
                    <items>
                        <IconTabFilter icon="sap-icon://process" text="{i18n>processConfigTableHeader}">
                            <OverflowToolbar class="flowmateToolbar">
                                <Title text="{i18n>processConfigTableHeader}" />
                                <ToolbarSpacer />
                                <SearchField width="18rem" search=".onSearchProcessSteps" liveChange=".onSearchProcessSteps" />
                                <Button icon="sap-icon://add" text="{i18n>addProcessStepButton}" type="Emphasized" press=".onAddProcessStep" />
                                <Button icon="sap-icon://delete" text="{i18n>deleteSelectedButton}" type="Reject" press=".onDeleteSelectedProcessSteps" />
                            </OverflowToolbar>
                            <Table
                                id="configTable"
                                class="flowmateTable"
                                noDataText="{i18n>noProcessStepsText}"
                                busyIndicatorDelay="0"
                                mode="MultiSelect"
                                growing="true"
                                growingScrollToLoad="true"
                                items="{path: '/ProcessStepConfig', events: {dataRequested: '.onDataRequested', dataReceived: '.onDataReceived'}}">
                                <columns>
                                    <Column width="8rem"><Text text="{i18n>referenceNumberLabel}" wrapping="true" /></Column>
                                    <Column width="9rem"><Text text="{i18n>processTypeLabel}" wrapping="true" /></Column>
                                    <Column width="5rem"><Text text="{i18n>stepLabel}" wrapping="true" /></Column>
                                    <Column width="10rem"><Text text="{i18n>stepNameLabel}" wrapping="true" /></Column>
                                    <Column width="16rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>activityDescriptionLabel}" wrapping="true" /></Column>
                                    <Column width="8rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>roleLabel}" wrapping="true" /></Column>
                                    <Column width="7rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>mandatoryLabel}" wrapping="true" /></Column>
                                    <Column width="6rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>slaDaysLabel}" wrapping="true" /></Column>
                                    <Column width="8rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>nextApproveLabel}" wrapping="true" /></Column>
                                    <Column width="8rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>nextRejectLabel}" wrapping="true" /></Column>
                                    <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{referenceNumber}" />
                                            <Text text="{processType_code}" />
                                            <Text text="{stepNo}" />
                                            <ObjectIdentifier title="{stepName}" />
                                            <Text text="{activityDescription}" wrapping="true" />
                                            <Text text="{role}" />
                                            <ObjectStatus text="{= ${isMandatory} ? 'Yes' : 'No' }" state="{= ${isMandatory} ? 'Success' : 'None' }" />
                                            <Text text="{slaDays}" />
                                            <Text text="{nextOnApprove}" />
                                            <Text text="{nextOnReject}" />
                                            <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>editProcessStepButton}" press=".onEditProcessStep" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter icon="sap-icon://list" text="{i18n>processTypesConfigTitle}">
                            <OverflowToolbar class="flowmateToolbar">
                                <Title text="{i18n>processTypesConfigTitle}" />
                                <ToolbarSpacer />
                                <SearchField width="18rem" search=".onSearchCodeList" liveChange=".onSearchCodeList">
                                    <customData><core:CustomData key="entitySet" value="ProcessTypes" /></customData>
                                </SearchField>
                                <Button icon="sap-icon://add" text="{i18n>addConfigValueButton}" type="Emphasized" press=".onAddCodeList">
                                    <customData><core:CustomData key="entitySet" value="ProcessTypes" /></customData>
                                </Button>
                                <Button icon="sap-icon://delete" text="{i18n>deleteSelectedButton}" type="Reject" press=".onDeleteSelectedCodeList">
                                    <customData><core:CustomData key="entitySet" value="ProcessTypes" /></customData>
                                </Button>
                            </OverflowToolbar>
                            <Table id="processTypesTable" class="flowmateTable" mode="MultiSelect" noDataText="{i18n>noConfigValuesText}" items="{/ProcessTypes}">
                                <columns>
                                    <Column width="10rem"><Text text="{i18n>configCodeLabel}" wrapping="true" /></Column>
                                    <Column width="14rem"><Text text="{i18n>configNameLabel}" wrapping="true" /></Column>
                                    <Column><Text text="{i18n>configDescriptionLabel}" wrapping="true" /></Column>
                                    <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem><cells>
                                        <Text text="{code}" wrapping="true" /><Text text="{name}" wrapping="true" /><Text text="{descr}" wrapping="true" />
                                        <Button icon="sap-icon://edit" type="Transparent" press=".onEditCodeList">
                                            <customData><core:CustomData key="entitySet" value="ProcessTypes" /></customData>
                                        </Button>
                                    </cells></ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter icon="sap-icon://tree" text="{i18n>processSubTypesConfigTitle}">
                            <OverflowToolbar class="flowmateToolbar">
                                <Title text="{i18n>processSubTypesConfigTitle}" />
                                <ToolbarSpacer />
                                <SearchField width="18rem" search=".onSearchSubTypes" liveChange=".onSearchSubTypes" />
                                <Button icon="sap-icon://add" text="{i18n>addProcessSubTypeButton}" type="Emphasized" press=".onAddSubType" />
                                <Button icon="sap-icon://delete" text="{i18n>deleteSelectedButton}" type="Reject" press=".onDeleteSelectedSubTypes" />
                            </OverflowToolbar>
                            <Table
                                id="processSubTypesTable"
                                class="flowmateTable"
                                mode="MultiSelect"
                                noDataText="{i18n>noConfigValuesText}"
                                growing="true"
                                growingScrollToLoad="true"
                                items="{/ProcessSubTypes}">
                                <columns>
                                    <Column width="7rem"><Text text="{i18n>configCodeLabel}" wrapping="true" /></Column>
                                    <Column width="12rem"><Text text="{i18n>configNameLabel}" wrapping="true" /></Column>
                                    <Column width="7rem"><Text text="{i18n>processTypeLabel}" wrapping="true" /></Column>
                                    <Column width="8rem"><Text text="{i18n>processOwnerLabel}" wrapping="true" /></Column>
                                    <Column><Text text="{i18n>activityDescriptionLabel}" wrapping="true" /></Column>
                                    <Column width="8rem"><Text text="{i18n>sapTCodeLabel}" wrapping="true" /></Column>
                                    <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{descr}" text="{code}" />
                                            <Text text="{name}" wrapping="true" />
                                            <Text text="{processType_code}" />
                                            <Text text="{processOwner}" wrapping="true" />
                                            <Text text="{activityDescription}" wrapping="true" />
                                            <Text text="{sapTCode}" wrapping="true" />
                                            <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>editProcessSubTypeButton}" press=".onEditSubType" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter icon="sap-icon://form" text="{i18n>fieldCatalogConfigTitle}">
                            <OverflowToolbar class="flowmateToolbar">
                                <Title text="{i18n>fieldCatalogConfigTitle}" />
                                <ToolbarSpacer />
                                <SearchField width="18rem" search=".onSearchFieldCatalog" liveChange=".onSearchFieldCatalog" />
                                <Button icon="sap-icon://add" text="{i18n>addFieldCatalogButton}" type="Emphasized" press=".onAddFieldCatalog" />
                                <Button icon="sap-icon://delete" text="{i18n>deleteSelectedButton}" type="Reject" press=".onDeleteSelectedFieldCatalog" />
                            </OverflowToolbar>
                            <Table
                                id="fieldCatalogTable"
                                class="flowmateTable"
                                mode="MultiSelect"
                                noDataText="{i18n>noConfigValuesText}"
                                growing="true"
                                growingScrollToLoad="true"
                                items="{/ProcessRequestFieldCatalog}">
                                <columns>
                                    <Column width="16rem"><Text text="{i18n>fieldNameLabel}" wrapping="true" /></Column>
                                    <Column><Text text="{i18n>fieldLabel}" wrapping="true" /></Column>
                                    <Column width="9rem"><Text text="{i18n>dataTypeLabel}" wrapping="true" /></Column>
                                    <Column width="12rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>defaultValueLabel}" wrapping="true" /></Column>
                                    <Column width="12rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>placeholderLabel}" wrapping="true" /></Column>
                                    <Column width="12rem"><Text text="{i18n>inputHintLabel}" wrapping="true" /></Column>
                                    <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{fieldName}" wrapping="true" />
                                            <Text text="{label}" wrapping="true" />
                                            <ObjectStatus text="{dataType}" state="Information" />
                                            <Text text="{defaultValue}" wrapping="true" />
                                            <Text text="{placeholder}" wrapping="true" />
                                            <Text text="{inputHint}" wrapping="true" />
                                            <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>editFieldCatalogButton}" press=".onEditFieldCatalog" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter icon="sap-icon://value-help" text="{i18n>fieldOptionsConfigTitle}">
                            <OverflowToolbar class="flowmateToolbar">
                                <Title text="{i18n>fieldOptionsConfigTitle}" />
                                <ToolbarSpacer />
                                <SearchField width="18rem" search=".onSearchFieldOptions" liveChange=".onSearchFieldOptions" />
                                <Button icon="sap-icon://add" text="{i18n>addFieldOptionButton}" type="Emphasized" press=".onAddFieldOption" />
                                <Button icon="sap-icon://delete" text="{i18n>deleteSelectedButton}" type="Reject" press=".onDeleteSelectedFieldOptions" />
                            </OverflowToolbar>
                            <Table
                                id="fieldOptionsTable"
                                class="flowmateTable"
                                mode="MultiSelect"
                                noDataText="{i18n>noConfigValuesText}"
                                growing="true"
                                growingScrollToLoad="true"
                                items="{/ProcessRequestFieldOptions}">
                                <columns>
                                    <Column><Text text="{i18n>fieldNameLabel}" wrapping="true" /></Column>
                                    <Column width="12rem"><Text text="{i18n>configCodeLabel}" wrapping="true" /></Column>
                                    <Column width="14rem"><Text text="{i18n>valueLabel}" wrapping="true" /></Column>
                                    <Column width="6rem"><Text text="{i18n>sequenceLabel}" wrapping="true" /></Column>
                                    <Column width="7rem"><Text text="{i18n>activeLabel}" wrapping="true" /></Column>
                                    <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{field_fieldName}" wrapping="true" />
                                            <Text text="{code}" wrapping="true" />
                                            <ObjectIdentifier title="{text}" />
                                            <Text text="{sequence}" />
                                            <ObjectStatus text="{= ${isActive} ? ${i18n>yesText} : ${i18n>noText} }" state="{= ${isActive} ? 'Success' : 'Error' }" />
                                            <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>editFieldOptionButton}" press=".onEditFieldOption" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter icon="sap-icon://table-view" text="{i18n>fieldVisibilityConfigTitle}">
                            <OverflowToolbar class="flowmateToolbar">
                                <Title text="{i18n>fieldVisibilityConfigTitle}" />
                                <ToolbarSpacer />
                                <SearchField width="18rem" search=".onSearchFieldMappings" liveChange=".onSearchFieldMappings" />
                                <Button icon="sap-icon://add" text="{i18n>addFieldVisibilityButton}" type="Emphasized" press=".onAddFieldMapping" />
                                <Button icon="sap-icon://delete" text="{i18n>deleteSelectedButton}" type="Reject" press=".onDeleteSelectedFieldMappings" />
                            </OverflowToolbar>
                            <Table
                                id="fieldMappingsTable"
                                class="flowmateTable"
                                mode="MultiSelect"
                                noDataText="{i18n>noConfigValuesText}"
                                growing="true"
                                growingScrollToLoad="true"
                                items="{/ProcessRequestFieldMappings}">
                                <columns>
                                    <Column width="8rem"><Text text="{i18n>processTypeLabel}" wrapping="true" /></Column>
                                    <Column width="8rem"><Text text="{i18n>subProcessTypeLabel}" wrapping="true" /></Column>
                                    <Column><Text text="{i18n>fieldLabel}" wrapping="true" /></Column>
                                    <Column width="8rem"><Text text="{i18n>sourceColumnLabel}" wrapping="true" /></Column>
                                    <Column width="6rem"><Text text="{i18n>sequenceLabel}" wrapping="true" /></Column>
                                    <Column width="7rem"><Text text="{i18n>mandatoryLabel}" wrapping="true" /></Column>
                                    <Column width="7rem"><Text text="{i18n>visibleLabel}" wrapping="true" /></Column>
                                    <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{processType_code}" />
                                            <Text text="{processSubType_code}" />
                                            <ObjectIdentifier title="{fieldLabel}" text="{field_fieldName}" />
                                            <Text text="{sourceColumn}" />
                                            <Text text="{sequence}" />
                                            <ObjectStatus text="{= ${isMandatory} ? ${i18n>yesText} : ${i18n>noText} }" state="{= ${isMandatory} ? 'Success' : 'None' }" />
                                            <ObjectStatus text="{= ${isVisible} ? ${i18n>yesText} : ${i18n>noText} }" state="{= ${isVisible} ? 'Success' : 'Error' }" />
                                            <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>editFieldVisibilityButton}" press=".onEditFieldMapping" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter icon="sap-icon://status-positive" text="{i18n>processStatusesConfigTitle}">
                            <OverflowToolbar class="flowmateToolbar">
                                <Title text="{i18n>processStatusesConfigTitle}" />
                                <ToolbarSpacer />
                                <SearchField width="18rem" search=".onSearchCodeList" liveChange=".onSearchCodeList">
                                    <customData><core:CustomData key="entitySet" value="ProcessStatus" /></customData>
                                </SearchField>
                                <Button icon="sap-icon://add" text="{i18n>addConfigValueButton}" type="Emphasized" press=".onAddCodeList">
                                    <customData><core:CustomData key="entitySet" value="ProcessStatus" /></customData>
                                </Button>
                                <Button icon="sap-icon://delete" text="{i18n>deleteSelectedButton}" type="Reject" press=".onDeleteSelectedCodeList">
                                    <customData><core:CustomData key="entitySet" value="ProcessStatus" /></customData>
                                </Button>
                            </OverflowToolbar>
                            <Table id="processStatusTable" class="flowmateTable" mode="MultiSelect" noDataText="{i18n>noConfigValuesText}" items="{/ProcessStatus}">
                                <columns>
                                    <Column width="10rem"><Text text="{i18n>configCodeLabel}" wrapping="true" /></Column><Column width="14rem"><Text text="{i18n>configNameLabel}" wrapping="true" /></Column>
                                    <Column><Text text="{i18n>configDescriptionLabel}" wrapping="true" /></Column><Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items><ColumnListItem><cells>
                                    <Text text="{code}" wrapping="true" /><Text text="{name}" wrapping="true" /><Text text="{descr}" wrapping="true" />
                                    <Button icon="sap-icon://edit" type="Transparent" press=".onEditCodeList">
                                        <customData><core:CustomData key="entitySet" value="ProcessStatus" /></customData>
                                    </Button>
                                </cells></ColumnListItem></items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter icon="sap-icon://workflow-tasks" text="{i18n>taskStatusesConfigTitle}">
                            <OverflowToolbar class="flowmateToolbar">
                                <Title text="{i18n>taskStatusesConfigTitle}" />
                                <ToolbarSpacer />
                                <SearchField width="18rem" search=".onSearchCodeList" liveChange=".onSearchCodeList">
                                    <customData><core:CustomData key="entitySet" value="TaskStatus" /></customData>
                                </SearchField>
                                <Button icon="sap-icon://add" text="{i18n>addConfigValueButton}" type="Emphasized" press=".onAddCodeList">
                                    <customData><core:CustomData key="entitySet" value="TaskStatus" /></customData>
                                </Button>
                                <Button icon="sap-icon://delete" text="{i18n>deleteSelectedButton}" type="Reject" press=".onDeleteSelectedCodeList">
                                    <customData><core:CustomData key="entitySet" value="TaskStatus" /></customData>
                                </Button>
                            </OverflowToolbar>
                            <Table id="taskStatusTable" class="flowmateTable" mode="MultiSelect" noDataText="{i18n>noConfigValuesText}" items="{/TaskStatus}">
                                <columns>
                                    <Column width="10rem"><Text text="{i18n>configCodeLabel}" wrapping="true" /></Column><Column width="14rem"><Text text="{i18n>configNameLabel}" wrapping="true" /></Column>
                                    <Column><Text text="{i18n>configDescriptionLabel}" wrapping="true" /></Column><Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items><ColumnListItem><cells>
                                    <Text text="{code}" wrapping="true" /><Text text="{name}" wrapping="true" /><Text text="{descr}" wrapping="true" />
                                    <Button icon="sap-icon://edit" type="Transparent" press=".onEditCodeList">
                                        <customData><core:CustomData key="entitySet" value="TaskStatus" /></customData>
                                    </Button>
                                </cells></ColumnListItem></items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter icon="sap-icon://drop-down-list" text="{i18n>requestDropdownConfigTitle}">
                            <OverflowToolbar class="flowmateToolbar">
                                <Title text="{i18n>requestDropdownConfigTitle}" />
                                <ToolbarSpacer />
                                <SearchField width="18rem" search=".onSearchCodeList" liveChange=".onSearchCodeList">
                                    <customData><core:CustomData key="entitySet" value="RequestDropDown" /></customData>
                                </SearchField>
                                <Button icon="sap-icon://add" text="{i18n>addConfigValueButton}" type="Emphasized" press=".onAddCodeList">
                                    <customData><core:CustomData key="entitySet" value="RequestDropDown" /></customData>
                                </Button>
                                <Button icon="sap-icon://delete" text="{i18n>deleteSelectedButton}" type="Reject" press=".onDeleteSelectedCodeList">
                                    <customData><core:CustomData key="entitySet" value="RequestDropDown" /></customData>
                                </Button>
                            </OverflowToolbar>
                            <Table id="requestDropDownTable" class="flowmateTable" mode="MultiSelect" noDataText="{i18n>noConfigValuesText}" items="{/RequestDropDown}">
                                <columns>
                                    <Column width="10rem"><Text text="{i18n>configCodeLabel}" wrapping="true" /></Column><Column width="14rem"><Text text="{i18n>configNameLabel}" wrapping="true" /></Column>
                                    <Column><Text text="{i18n>configDescriptionLabel}" wrapping="true" /></Column><Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items><ColumnListItem><cells>
                                    <Text text="{code}" wrapping="true" /><Text text="{name}" wrapping="true" /><Text text="{descr}" wrapping="true" />
                                    <Button icon="sap-icon://edit" type="Transparent" press=".onEditCodeList">
                                        <customData><core:CustomData key="entitySet" value="RequestDropDown" /></customData>
                                    </Button>
                                </cells></ColumnListItem></items>
                            </Table>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </f:content>
    </f:DynamicPage>
    <mvc:dependents>
        <Dialog id="codeListDialog" title="{configEdit>/dialogTitle}" contentWidth="42rem" stretchOnPhone="true">
            <content>
                <form:SimpleForm class="flowmateDialogContent" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4">
                    <Label text="{i18n>configCodeLabel}" required="true" />
                    <Input value="{configEdit>/code}" enabled="{= !${configEdit>/isEdit} }" maxLength="30" required="true" />
                    <Label text="{i18n>configNameLabel}" required="true" />
                    <Input value="{configEdit>/name}" maxLength="255" required="true" />
                    <Label text="{i18n>configDescriptionLabel}" required="true" />
                    <TextArea value="{configEdit>/descr}" rows="4" required="true" />
                </form:SimpleForm>
            </content>
            <beginButton><Button icon="sap-icon://save" text="{i18n>saveButton}" type="Emphasized" press=".onSaveCodeList" /></beginButton>
            <endButton><Button text="{i18n>cancelButton}" press=".onCloseCodeListDialog" /></endButton>
        </Dialog>
        <Dialog id="processSubTypeDialog" title="{subTypeEdit>/dialogTitle}" contentWidth="52rem" stretchOnPhone="true">
            <content>
                <form:SimpleForm class="flowmateDialogContent" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4">
                    <Label text="{i18n>configCodeLabel}" required="true" />
                    <Input value="{subTypeEdit>/code}" enabled="{= !${subTypeEdit>/isEdit} }" maxLength="30" required="true" />
                    <Label text="{i18n>configNameLabel}" required="true" />
                    <Input value="{subTypeEdit>/name}" maxLength="255" required="true" />
                    <Label text="{i18n>configDescriptionLabel}" />
                    <Input value="{subTypeEdit>/descr}" maxLength="1000" />
                    <Label text="{i18n>processTypeLabel}" required="true" />
                    <Select selectedKey="{subTypeEdit>/processType_code}" items="{/ProcessTypes}" required="true">
                        <core:Item key="{code}" text="{name}" />
                    </Select>
                    <Label text="{i18n>processOwnerLabel}" />
                    <Input value="{subTypeEdit>/processOwner}" maxLength="100" />
                    <Label text="{i18n>activityDescriptionLabel}" />
                    <TextArea value="{subTypeEdit>/activityDescription}" rows="4" maxLength="500" />
                    <Label text="{i18n>sapTCodeLabel}" />
                    <Input value="{subTypeEdit>/sapTCode}" maxLength="100" />
                </form:SimpleForm>
            </content>
            <beginButton><Button icon="sap-icon://save" text="{i18n>saveButton}" type="Emphasized" press=".onSaveSubType" /></beginButton>
            <endButton><Button text="{i18n>cancelButton}" press=".onCloseSubTypeDialog" /></endButton>
        </Dialog>
        <Dialog id="fieldCatalogDialog" title="{fieldCatalogEdit>/dialogTitle}" contentWidth="48rem" stretchOnPhone="true">
            <content>
                <VBox>
                    <form:SimpleForm class="flowmateDialogContent" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4">
                        <Label text="{i18n>fieldNameLabel}" required="true" />
                        <Input value="{fieldCatalogEdit>/fieldName}" enabled="{= !${fieldCatalogEdit>/isEdit} }" maxLength="80" required="true" />
                        <Label text="{i18n>fieldLabel}" required="true" />
                        <TextArea value="{fieldCatalogEdit>/label}" rows="3" maxLength="500" required="true" />
                        <Label text="{i18n>dataTypeLabel}" required="true" />
                        <Select selectedKey="{fieldCatalogEdit>/dataType}" required="true">
                            <core:Item key="String" text="String" />
                            <core:Item key="List" text="List" />
                            <core:Item key="Decimal" text="Decimal" />
                            <core:Item key="Date" text="Date" />
                            <core:Item key="Boolean" text="Boolean" />
                            <core:Item key="Attachment/Text" text="Attachment/Text" />
                        </Select>
                        <Label text="{i18n>defaultValueLabel}" />
                        <Input value="{fieldCatalogEdit>/defaultValue}" maxLength="500" />
                        <Label text="{i18n>placeholderLabel}" />
                        <Input value="{fieldCatalogEdit>/placeholder}" maxLength="255" />
                        <Label text="{i18n>inputHintLabel}" />
                        <Input value="{fieldCatalogEdit>/inputHint}" maxLength="100" />
                    </form:SimpleForm>
                    <VBox
                        class="flowmateDialogContent"
                        visible="{= ${fieldCatalogEdit>/dataType} === 'List' }">
                        <OverflowToolbar class="flowmateToolbar">
                            <Title text="{i18n>fieldOptionInlineTitle}" />
                            <ToolbarSpacer />
                            <Button icon="sap-icon://add" text="{i18n>addFieldOptionButton}" type="Emphasized" press=".onAddInlineFieldOption" />
                        </OverflowToolbar>
                        <Table
                            class="flowmateTable"
                            noDataText="{i18n>noFieldOptionsText}"
                            items="{fieldCatalogEdit>/inlineOptions}">
                            <columns>
                                <Column width="12rem"><Text text="{i18n>configCodeLabel}" /></Column>
                                <Column><Text text="{i18n>configDescriptionLabel}" /></Column>
                                <Column width="7rem"><Text text="{i18n>sequenceLabel}" /></Column>
                                <Column width="7rem"><Text text="{i18n>activeLabel}" /></Column>
                                <Column hAlign="End" width="5rem"><Text text="{i18n>actionsLabel}" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Input value="{fieldCatalogEdit>code}" maxLength="80" placeholder="{i18n>configCodeLabel}" />
                                        <Input value="{fieldCatalogEdit>text}" maxLength="255" placeholder="{i18n>configDescriptionLabel}" />
                                        <Input value="{fieldCatalogEdit>sequence}" type="Number" />
                                        <Switch state="{fieldCatalogEdit>isActive}" />
                                        <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteInlineFieldOption" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </VBox>
            </content>
            <beginButton><Button icon="sap-icon://save" text="{i18n>saveButton}" type="Emphasized" press=".onSaveFieldCatalog" /></beginButton>
            <endButton><Button text="{i18n>cancelButton}" press=".onCloseFieldCatalogDialog" /></endButton>
        </Dialog>
        <Dialog id="fieldOptionDialog" title="{fieldOptionEdit>/dialogTitle}" contentWidth="44rem" stretchOnPhone="true">
            <content>
                <form:SimpleForm class="flowmateDialogContent" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4">
                    <Label text="{i18n>fieldNameLabel}" required="true" />
                    <Select selectedKey="{fieldOptionEdit>/field_fieldName}" items="{/ProcessRequestFieldCatalog}" required="true">
                        <core:Item key="{fieldName}" text="{label}" />
                    </Select>
                    <Label text="{i18n>configCodeLabel}" required="true" />
                    <Input value="{fieldOptionEdit>/code}" maxLength="80" required="true" />
                    <Label text="{i18n>valueLabel}" required="true" />
                    <Input value="{fieldOptionEdit>/text}" maxLength="255" required="true" />
                    <Label text="{i18n>sequenceLabel}" />
                    <Input value="{fieldOptionEdit>/sequence}" type="Number" />
                    <Label text="{i18n>activeLabel}" />
                    <Switch state="{fieldOptionEdit>/isActive}" />
                </form:SimpleForm>
            </content>
            <beginButton><Button icon="sap-icon://save" text="{i18n>saveButton}" type="Emphasized" press=".onSaveFieldOption" /></beginButton>
            <endButton><Button text="{i18n>cancelButton}" press=".onCloseFieldOptionDialog" /></endButton>
        </Dialog>
        <Dialog id="fieldMappingDialog" title="{fieldMappingEdit>/dialogTitle}" contentWidth="54rem" stretchOnPhone="true">
            <content>
                <form:SimpleForm class="flowmateDialogContent" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4">
                    <Label text="{i18n>processTypeLabel}" required="true" />
                    <Select selectedKey="{fieldMappingEdit>/processType_code}" items="{/ProcessTypes}" required="true">
                        <core:Item key="{code}" text="{name}" />
                    </Select>
                    <Label text="{i18n>subProcessTypeLabel}" />
                    <ComboBox selectedKey="{fieldMappingEdit>/processSubType_code}" items="{/ProcessSubTypes}">
                        <core:Item key="{code}" text="{name}" />
                    </ComboBox>
                    <Label text="{i18n>fieldNameLabel}" required="true" />
                    <Select id="fieldMappingFieldSelect" selectedKey="{fieldMappingEdit>/field_fieldName}" items="{/ProcessRequestFieldCatalog}" change=".onFieldMappingFieldChanged" required="true">
                        <core:Item key="{fieldName}" text="{label}" />
                    </Select>
                    <Label text="{i18n>fieldLabel}" required="true" />
                    <TextArea value="{fieldMappingEdit>/fieldLabel}" rows="3" maxLength="500" required="true" />
                    <Label text="{i18n>sourceColumnLabel}" />
                    <Input value="{fieldMappingEdit>/sourceColumn}" maxLength="30" />
                    <Label text="{i18n>sectionLabel}" />
                    <Input value="{fieldMappingEdit>/section}" maxLength="50" />
                    <Label text="{i18n>sequenceLabel}" />
                    <Input value="{fieldMappingEdit>/sequence}" type="Number" />
                    <Label text="{i18n>mandatoryLabel}" />
                    <Switch state="{fieldMappingEdit>/isMandatory}" />
                    <Label text="{i18n>visibleLabel}" />
                    <Switch state="{fieldMappingEdit>/isVisible}" />
                </form:SimpleForm>
            </content>
            <beginButton><Button icon="sap-icon://save" text="{i18n>saveButton}" type="Emphasized" press=".onSaveFieldMapping" /></beginButton>
            <endButton><Button text="{i18n>cancelButton}" press=".onCloseFieldMappingDialog" /></endButton>
        </Dialog>
        <Dialog id="processStepDialog" title="{stepEdit>/dialogTitle}" contentWidth="50rem" stretchOnPhone="true">
            <content>
                <form:SimpleForm class="flowmateDialogContent" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4">
                    <Label text="{i18n>processTypeLabel}" required="true" />
                    <Select selectedKey="{stepEdit>/processType_code}" items="{/ProcessTypes}" required="true">
                        <core:Item key="{code}" text="{name}" />
                    </Select>
                    <Label text="{i18n>stepLabel}" required="true" />
                    <Input value="{stepEdit>/stepNo}" type="Number" required="true" />
                    <Label text="{i18n>stepNameLabel}" required="true" />
                    <Input value="{stepEdit>/stepName}" maxLength="100" required="true" />
                    <Label text="{i18n>activityDescriptionLabel}" />
                    <TextArea value="{stepEdit>/activityDescription}" maxLength="500" rows="4" />
                    <Label text="{i18n>roleLabel}" />
                    <Input value="{stepEdit>/role}" maxLength="100" />
                    <Label text="{i18n>mandatoryLabel}" />
                    <Switch state="{stepEdit>/isMandatory}" />
                    <Label text="{i18n>slaDaysLabel}" />
                    <Input value="{stepEdit>/slaDays}" type="Number" />
                    <Label text="{i18n>nextApproveLabel}" />
                    <Input value="{stepEdit>/nextOnApprove}" type="Number" />
                    <Label text="{i18n>nextRejectLabel}" />
                    <Input value="{stepEdit>/nextOnReject}" type="Number" />
                </form:SimpleForm>
            </content>
            <beginButton><Button icon="sap-icon://save" text="{i18n>saveButton}" type="Emphasized" press=".onSaveProcessStep" /></beginButton>
            <endButton><Button text="{i18n>cancelButton}" press=".onCloseProcessStepDialog" /></endButton>
        </Dialog>
    </mvc:dependents>
</mvc:View>
