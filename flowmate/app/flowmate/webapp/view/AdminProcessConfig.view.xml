<mvc:View
    controllerName="flowmate.controller.AdminProcessConfig"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">
    <f:DynamicPage
        id="adminProcessConfigPage"
        class="flowmatePage"
        fitContent="true"
        toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>adminConfigTitle}" />
                </f:heading>
                <f:actions>
                    <Button
                        icon="sap-icon://home"
                        text="{i18n>dashboardNavButton}"
                        press=".onNavToDashboard" />
                    <Button
                        icon="sap-icon://request"
                        text="{i18n>requestsNavButton}"
                        press=".onNavToRequests" />
                    <Button
                        icon="sap-icon://workflow-tasks"
                        text="{i18n>tasksNavButton}"
                        press=".onNavToTasks" />
                    <Button
                        icon="sap-icon://add-document"
                        text="{i18n>createRequestButton}"
                        press=".onNavToCreateRequest" />
                    <Button
                        icon="sap-icon://employee"
                        text="{i18n>delegationsNavButton}"
                        press=".onNavToDelegations" />
                    <Button
                        icon="sap-icon://group"
                        text="{i18n>userAdminNavButton}"
                        press=".onNavToUserAdministration" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="flowmateContent flowmateSurface">
                <OverflowToolbar class="flowmateToolbar">
                    <Title text="{i18n>processConfigTableHeader}" />
                    <ToolbarSpacer />
                    <SearchField
                        width="18rem"
                        search=".onSearch"
                        liveChange=".onSearch" />
                </OverflowToolbar>
                <Table
                    id="configTable"
                    class="flowmateTable"
                    noDataText="{i18n>noProcessStepsText}"
                    busyIndicatorDelay="0"
                    growing="true"
                    growingScrollToLoad="true"
                    items="{
                        path: '/ProcessStepConfig',
                        events: {
                            dataRequested: '.onDataRequested',
                            dataReceived: '.onDataReceived'
                        }
                    }">
                    <columns>
                        <Column><Text text="{i18n>processTypeLabel}" /></Column>
                        <Column><Text text="{i18n>stepLabel}" /></Column>
                        <Column><Text text="{i18n>stepNameLabel}" /></Column>
                        <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>roleLabel}" /></Column>
                        <Column demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>mandatoryLabel}" /></Column>
                        <Column demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>slaDaysLabel}" /></Column>
                        <Column demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>nextApproveLabel}" /></Column>
                        <Column demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>nextRejectLabel}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{processType_code}" />
                                <Text text="{stepNo}" />
                                <ObjectIdentifier title="{stepName}" />
                                <Text text="{role}" />
                                <ObjectStatus
                                    text="{= ${isMandatory} ? 'Yes' : 'No' }"
                                    state="{= ${isMandatory} ? 'Success' : 'None' }" />
                                <Text text="{slaDays}" />
                                <Text text="{nextOnApprove}" />
                                <Text text="{nextOnReject}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
