<mvc:View
    controllerName="flowmate.controller.RequestDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">
    <f:DynamicPage
        id="requestDetailPage"
        class="flowmatePage"
        toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{title}" />
                </f:heading>
                <f:actions>
                    <Button
                        icon="sap-icon://home"
                        text="{i18n>dashboardNavButton}"
                        press=".onNavToDashboard" />
                    <Button
                        icon="sap-icon://request"
                        text="{i18n>requestsNavButton}"
                        press=".onNavToRequests" />
                    <Button
                        icon="sap-icon://workflow-tasks"
                        text="{i18n>tasksNavButton}"
                        press=".onNavToTasks" />
                    <Button
                        icon="sap-icon://add-document"
                        text="{i18n>createRequestButton}"
                        press=".onNavToCreateRequest" />
                    <Button
                        icon="sap-icon://action-settings"
                        text="{i18n>adminNavButton}"
                        visible="{permissions>/isAdmin}"
                        press=".onNavToAdminConfig" />
                    <Button
                        icon="sap-icon://employee"
                        text="{i18n>delegationsNavButton}"
                        press=".onNavToDelegations" />
                    <Button
                        icon="sap-icon://decline"
                        text="{i18n>closeButton}"
                        press=".onClose" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="flowmateContent">
                <ObjectHeader
                    class="flowmateSurface"
                    title="{title}"
                    intro="{processType_code}">
                    <attributes>
                        <ObjectAttribute
                            title="{i18n>departmentLabel}"
                            text="{department}" />
                        <ObjectAttribute
                            title="{i18n>requesterLabel}"
                            text="{requester}" />
                        <ObjectAttribute
                            title="{i18n>dueDateLabel}"
                            text="{dueDate}" />
                        <ObjectAttribute
                            title="{i18n>priorityLabel}"
                            text="{priority}" />
                    </attributes>
                </ObjectHeader>
                <HBox
                    class="sapUiSmallMarginTop flowmateDetailBlock flowmateStatusRow"
                    alignItems="End">
                    <VBox class="flowmateStatusEditor">
                        <Label text="{i18n>statusLabel}" />
                        <Select
                            width="12rem"
                            selectedKey="{statusEdit>/requestStatus}"
                            items="{/ProcessStatus}">
                            <core:Item key="{code}" text="{name}" />
                        </Select>
                    </VBox>
                    <Button
                        class="sapUiTinyMarginBegin"
                        icon="sap-icon://save"
                        text="{i18n>saveStatusButton}"
                        type="Emphasized"
                        press=".onSaveRequestStatus" />
                </HBox>
                <IconTabBar
                    class="sapUiSmallMarginTop flowmateSurface"
                    expandable="false">
                    <items>
                        <IconTabFilter
                            icon="sap-icon://workflow-tasks"
                            text="{i18n>tasksTitle}">
                            <Table
                                class="flowmateTable"
                                noDataText="{i18n>noTasksText}"
                                items="{tasks}">
                                <columns>
                                    <Column><Text text="{i18n>stepLabel}" /></Column>
                                    <Column><Text text="{i18n>taskNameLabel}" /></Column>
                                    <Column><Text text="{i18n>assignedToLabel}" /></Column>
                                    <Column><Text text="{i18n>statusLabel}" /></Column>
                                    <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{stepNo}" />
                                            <Text text="{taskName}" />
                                            <Text text="{assignedTo}" />
                                            <ObjectStatus
                                                text="{status_code}"
                                                state="{path: 'status_code', formatter: '.formatStatusState'}" />
                                            <HBox justifyContent="End">
                                                <Button
                                                    icon="sap-icon://delete"
                                                    type="Transparent"
                                                    tooltip="{i18n>deleteTaskButton}"
                                                    press=".onDeleteTask" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter
                            icon="sap-icon://comment"
                            text="{i18n>commentsTitle}">
                            <List
                                noDataText="{i18n>noCommentsText}"
                                items="{comments}">
                                <StandardListItem
                                    title="{userId}"
                                    description="{comment}" />
                            </List>
                        </IconTabFilter>
                        <IconTabFilter
                            icon="sap-icon://attachment"
                            text="{i18n>attachmentsTitle}">
                            <Table
                                class="flowmateTable"
                                noDataText="{i18n>noAttachmentsText}"
                                items="{attachments}">
                                <columns>
                                    <Column><Text text="{i18n>fileNameLabel}" /></Column>
                                    <Column><Text text="{i18n>mimeTypeLabel}" /></Column>
                                    <Column><Text text="{i18n>statusLabel}" /></Column>
                                    <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{filename}" />
                                            <Text text="{mimeType}" />
                                            <ObjectStatus
                                                text="{status}"
                                                state="{path: 'status', formatter: '.formatStatusState'}" />
                                            <HBox justifyContent="End">
                                                <Button
                                                    icon="sap-icon://show"
                                                    text="{i18n>viewAttachmentButton}"
                                                    press=".onViewAttachment" />
                                                <Button
                                                    icon="sap-icon://download"
                                                    text="{i18n>downloadAttachmentButton}"
                                                    press=".onDownloadAttachment" />
                                                <Button
                                                    icon="sap-icon://delete"
                                                    type="Transparent"
                                                    tooltip="{i18n>deleteAttachmentButton}"
                                                    press=".onDeleteAttachment" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter
                            icon="sap-icon://history"
                            text="{i18n>historyTitle}">
                            <List
                                noDataText="{i18n>noHistoryText}"
                                items="{history}">
                                <StandardListItem
                                    title="{action}"
                                    description="{actor} - {remarks}"
                                    info="{newStatus}" />
                            </List>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
