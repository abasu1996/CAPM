<mvc:View
    controllerName="flowmate.controller.RequestDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <f:DynamicPage
        id="requestDetailPage"
        class="flowmatePage"
        toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{title}" />
                </f:heading>
                <f:actions>
                    <Button
                        icon="sap-icon://home"
                        text="{i18n>dashboardNavButton}"
                        press=".onNavToDashboard" />
                    <Button
                        icon="sap-icon://request"
                        text="{i18n>requestsNavButton}"
                        press=".onNavToRequests" />
                    <Button
                        icon="sap-icon://workflow-tasks"
                        text="{i18n>tasksNavButton}"
                        press=".onNavToTasks" />
                    <Button
                        icon="sap-icon://add-document"
                        text="{i18n>createRequestButton}"
                        press=".onNavToCreateRequest" />
                    <Button
                        icon="sap-icon://action-settings"
                        text="{i18n>adminNavButton}"
                        visible="{permissions>/isAdmin}"
                        press=".onNavToAdminConfig" />
                    <Button
                        icon="sap-icon://employee"
                        text="{i18n>delegationsNavButton}"
                        press=".onNavToDelegations" />
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="{i18n>refreshButton}"
                        press=".onRefresh" />
                    <Button
                        icon="sap-icon://chain-link"
                        text="{i18n>createSuccessorRequestButton}"
                        type="Emphasized"
                        press=".onCreateSuccessorRequest" />
                    <Button
                        icon="sap-icon://decline"
                        text="{i18n>closeButton}"
                        press=".onClose" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="flowmateContent">
                <ObjectHeader
                    class="flowmateSurface"
                    title="{title}"
                    intro="{processType_code}">
                    <attributes>
                        <ObjectAttribute
                            title="{i18n>referenceNumberLabel}"
                            text="{referenceNumber}" />
                        <ObjectAttribute
                            title="{i18n>departmentLabel}"
                            text="{department}" />
                        <ObjectAttribute
                            title="{i18n>requesterLabel}"
                            text="{requester}" />
                        <ObjectAttribute
                            title="{i18n>subProcessTypeLabel}"
                            text="{subProcessType/name}" />
                        <ObjectAttribute
                            title="{i18n>processorLabel}"
                            text="{processor}" />
                        <ObjectAttribute
                            title="{i18n>dueDateLabel}"
                            text="{dueDate}" />
                    </attributes>
                    <statuses>
                        <ObjectStatus
                            class="flowmateSemanticStatus"
                            text="{path: 'status_code', formatter: '.formatStatusText'}"
                            state="{path: 'status_code', formatter: '.formatStatusState'}"
                            inverted="true" />
                        <ObjectStatus
                            class="flowmateSemanticStatus"
                            text="{priority}"
                            state="{path: 'priority', formatter: '.formatPriorityState'}"
                            inverted="true" />
                    </statuses>
                </ObjectHeader>
                <HBox
                    class="sapUiSmallMarginTop flowmateDetailBlock flowmateStatusRow"
                    alignItems="End">
                    <VBox class="flowmateStatusEditor">
                        <Label text="{i18n>statusLabel}" />
                        <Select
                            width="12rem"
                            selectedKey="{statusEdit>/requestStatus}"
                            items="{/ProcessStatus}">
                            <core:Item key="{code}" text="{name}" />
                        </Select>
                    </VBox>
                    <Button
                        class="sapUiTinyMarginBegin"
                        icon="sap-icon://save"
                        text="{i18n>saveStatusButton}"
                        type="Emphasized"
                        press=".onSaveRequestStatus" />
                </HBox>
                <HBox
                    class="sapUiSmallMarginTop flowmateDetailBlock flowmateStatusRow"
                    alignItems="End">
                    <VBox class="flowmateStatusEditor">
                        <Label text="{i18n>processorLabel}" />
                        <Input
                            width="12rem"
                            value="{processorEdit>/processorName}"
                            placeholder="{i18n>selectProcessorPlaceholder}"
                            showValueHelp="true"
                            showSuggestion="true"
                            startSuggestion="1"
                            filterSuggests="false"
                            suggest=".onUserSuggest"
                            suggestionItemSelected=".onProcessorSuggestionSelected"
                            liveChange=".onProcessorLiveChange"
                            valueHelpRequest=".onProcessorValueHelpRequest"
                            suggestionItems="{/Users}">
                            <suggestionItems>
                                <core:ListItem key="{ID}" text="{displayName}" additionalText="{email}" />
                            </suggestionItems>
                        </Input>
                    </VBox>
                    <Button
                        class="sapUiTinyMarginBegin"
                        icon="sap-icon://save"
                        text="{i18n>saveProcessorButton}"
                        type="Emphasized"
                        press=".onSaveRequestProcessor" />
                </HBox>
                <IconTabBar
                    class="sapUiSmallMarginTop flowmateSurface"
                    expandable="false">
                    <items>
                        <IconTabFilter
                            icon="sap-icon://business-objects-experience"
                            text="{i18n>ftkFactoringDetailsTitle}"
                            visible="{= ${subProcessType_code} === 'FTK_FACTORING_PO_VALIDATION' || ${subProcessType_code} === 'FTK_FACTORING_BASED_ON_UAC' || ${subProcessType_code} === 'FTK_FACTORING_PENDING_UAC' }">
                            <form:SimpleForm
                                class="flowmateDetailBlock flowmateFactoringDetailForm"
                                editable="false"
                                layout="ResponsiveGridLayout"
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="4"
                                columnsXL="2"
                                columnsL="2"
                                columnsM="1"
                                adjustLabelSpan="false">
                                <Label text="{i18n>paymentCategoryLabel}" />
                                <Text text="{paymentCategory/name}" />
                                <Label text="{i18n>entityLabel}" />
                                <Text text="{businessEntity/name}" />
                                <Label text="{i18n>vendorCodeLabel}" />
                                <Text text="{vendorCode}" />
                                <Label text="{i18n>vendorNameLabel}" />
                                <Text text="{vendorName}" wrapping="true" />
                                <Label text="{i18n>remarksLabel}" />
                                <Text text="{remarks}" wrapping="true" />
                            </form:SimpleForm>
                        </IconTabFilter>
                        <IconTabFilter
                            icon="sap-icon://chain-link"
                            text="{i18n>requestRelationsTitle}">
                            <VBox class="flowmateDetailBlock">
                                <Label text="{i18n>predecessorRequestLabel}" />
                                <Link
                                    text="{= ${predecessor/referenceNumber} || ${i18n>noPredecessorRequestText} }"
                                    enabled="{= !!${predecessor/ID} }"
                                    press=".onRelatedRequestPress" />
                            </VBox>
                            <Table
                                class="flowmateTable"
                                noDataText="{i18n>noSuccessorRequestsText}"
                                items="{successors}">
                                <columns>
                                    <Column><Text text="{i18n>referenceNumberLabel}" /></Column>
                                    <Column><Text text="{i18n>requestTitleLabel}" /></Column>
                                    <Column><Text text="{i18n>statusLabel}" /></Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>priorityLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem type="Active" press=".onRelatedRequestPress">
                                        <cells>
                                            <Link
                                                text="{referenceNumber}"
                                                press=".onRelatedRequestPress" />
                                            <Text text="{title}" />
                                            <VBox>
                                                <ObjectStatus
                                                    class="flowmateSemanticStatus"
                                                    text="{path: 'status_code', formatter: '.formatStatusText'}"
                                                    state="{path: 'status_code', formatter: '.formatStatusState'}"
                                                    inverted="true" />
                                                <ObjectStatus
                                                    text="{i18n>slaBreachedLabel}"
                                                    icon="sap-icon://lateness"
                                                    state="Error"
                                                    inverted="true"
                                                    visible="{parts: ['slaDueAt', 'dueDate', 'status_code'], formatter: '.isSlaBreachedAt'}" />
                                            </VBox>
                                            <ObjectStatus
                                                text="{priority}"
                                                state="{path: 'priority', formatter: '.formatPriorityState'}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter
                            icon="sap-icon://workflow-tasks"
                            text="{i18n>tasksTitle}">
                            <Table
                                id="requestDetailTasksTable"
                                class="flowmateTable"
                                noDataText="{i18n>noTasksText}"
                                mode="MultiSelect"
                                items="{tasks}">
                                <headerToolbar>
                                    <OverflowToolbar class="flowmateToolbar">
                                        <Title text="{i18n>tasksTitle}" />
                                        <ToolbarSpacer />
                                        <Button
                                            icon="sap-icon://delete"
                                            text="{i18n>deleteSelectedButton}"
                                            type="Reject"
                                            press=".onDeleteSelectedTasks" />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column><Text text="{i18n>referenceNumberLabel}" /></Column>
                                    <Column><Text text="{i18n>stepLabel}" /></Column>
                                    <Column><Text text="{i18n>taskNameLabel}" /></Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>mandatoryLabel}" /></Column>
                                    <Column><Text text="{i18n>processorLabel}" /></Column>
                                    <Column><Text text="{i18n>statusLabel}" /></Column>
                                    <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem highlight="{parts: ['request/slaDueAt', 'request/dueDate', 'status_code', 'completedAt'], formatter: '.formatSlaHighlightAt'}">
                                        <customData>
                                            <core:CustomData key="sla-breached" value="{parts: ['request/slaDueAt', 'request/dueDate', 'status_code'], formatter: '.formatSlaBreachedAtFlag'}" writeToDom="true" />
                                            <core:CustomData key="sla-within" value="{parts: ['request/slaDueAt', 'request/dueDate', 'status_code', 'completedAt'], formatter: '.formatSlaWithinAtFlag'}" writeToDom="true" />
                                        </customData>
                                        <cells>
                                            <Link
                                                text="{referenceNumber}"
                                                press=".onTaskReferencePress" />
                                            <Text text="{stepNo}" />
                                            <Text text="{taskName}" />
                                            <ObjectStatus
                                                text="{= ${isMandatory} ? ${i18n>mandatoryLabel} : ${i18n>optionalLabel} }"
                                                state="{= ${isMandatory} ? 'Warning' : 'None' }" />
                                            <Text text="{processor}" />
                                            <VBox>
                                                <ObjectStatus
                                                    class="flowmateSemanticStatus"
                                                    text="{path: 'status_code', formatter: '.formatStatusText'}"
                                                    state="{path: 'status_code', formatter: '.formatStatusState'}"
                                                    inverted="true" />
                                                <ObjectStatus
                                                    text="{i18n>slaBreachedLabel}"
                                                    icon="sap-icon://lateness"
                                                    state="Error"
                                                    inverted="true"
                                                    visible="{parts: ['request/slaDueAt', 'request/dueDate', 'status_code'], formatter: '.isSlaBreachedAt'}" />
                                                <ObjectStatus
                                                    text="{i18n>withinSlaLabel}"
                                                    icon="sap-icon://accept"
                                                    state="Success"
                                                    inverted="true"
                                                    visible="{parts: ['request/slaDueAt', 'request/dueDate', 'status_code', 'completedAt'], formatter: '.isWithinSlaAt'}" />
                                            </VBox>
                                            <HBox justifyContent="End">
                                                <Button
                                                    icon="sap-icon://email"
                                                    type="Transparent"
                                                    tooltip="{i18n>notifyProcessorButton}"
                                                    press=".onNotifyProcessor" />
                                                <Button
                                                    icon="sap-icon://delete"
                                                    type="Transparent"
                                                    tooltip="{i18n>deleteTaskButton}"
                                                    press=".onDeleteTask" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter
                            icon="sap-icon://comment"
                            text="{i18n>commentsTitle}">
                            <List
                                noDataText="{i18n>noCommentsText}"
                                items="{comments}">
                                <StandardListItem
                                    title="{userId}"
                                    description="{comment}" />
                            </List>
                        </IconTabFilter>
                        <IconTabFilter
                            icon="sap-icon://attachment"
                            text="{i18n>attachmentsTitle}">
                            <Table
                                id="requestDetailAttachmentsTable"
                                class="flowmateTable"
                                noDataText="{i18n>noAttachmentsText}"
                                mode="MultiSelect"
                                items="{attachments}">
                                <headerToolbar>
                                    <OverflowToolbar class="flowmateToolbar">
                                        <Title text="{i18n>attachmentsTitle}" />
                                        <ToolbarSpacer />
                                        <Button
                                            icon="sap-icon://delete"
                                            text="{i18n>deleteSelectedButton}"
                                            type="Reject"
                                            press=".onDeleteSelectedAttachments" />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column><Text text="{i18n>referenceNumberLabel}" /></Column>
                                    <Column><Text text="{i18n>fileNameLabel}" /></Column>
                                    <Column><Text text="{i18n>mimeTypeLabel}" /></Column>
                                    <Column><Text text="{i18n>statusLabel}" /></Column>
                                    <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Link
                                                text="{referenceNumber}"
                                                press=".onAttachmentReferencePress" />
                                            <Text text="{filename}" />
                                            <Text text="{mimeType}" />
                                            <ObjectStatus
                                                class="flowmateSemanticStatus"
                                                text="{status}"
                                                state="{path: 'status', formatter: '.formatStatusState'}"
                                                inverted="true" />
                                            <HBox justifyContent="End">
                                                <Button
                                                    icon="sap-icon://show"
                                                    text="{i18n>viewAttachmentButton}"
                                                    press=".onViewAttachment" />
                                                <Button
                                                    icon="sap-icon://download"
                                                    text="{i18n>downloadAttachmentButton}"
                                                    press=".onDownloadAttachment" />
                                                <Button
                                                    icon="sap-icon://delete"
                                                    type="Transparent"
                                                    tooltip="{i18n>deleteAttachmentButton}"
                                                    press=".onDeleteAttachment" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter
                            icon="sap-icon://history"
                            text="{i18n>historyTitle}">
                            <Table
                                class="flowmateTable"
                                noDataText="{i18n>noHistoryText}"
                                items="{history}">
                                <headerToolbar>
                                    <OverflowToolbar class="flowmateToolbar">
                                        <Title text="{i18n>historyTitle}" />
                                        <ToolbarSpacer />
                                        <ObjectStatus
                                            class="flowmateSemanticStatus"
                                            icon="sap-icon://history"
                                            text="{i18n>auditTrailLabel}"
                                            state="Information"
                                            inverted="true" />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column><Text text="{i18n>actionLabel}" /></Column>
                                    <Column><Text text="{i18n>statusTransitionLabel}" /></Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>changedByLabel}" /></Column>
                                    <Column demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>changedAtLabel}" /></Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>remarksLabel}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectStatus
                                                class="flowmateSemanticStatus"
                                                text="{path: 'action', formatter: '.formatStatusText'}"
                                                state="{path: 'newStatus', formatter: '.formatStatusState'}"
                                                inverted="true" />
                                            <HBox class="flowmateHistoryTransition" alignItems="Center">
                                                <ObjectStatus
                                                    text="{path: 'oldStatus', formatter: '.formatStatusText'}"
                                                    state="{path: 'oldStatus', formatter: '.formatStatusState'}" />
                                                <core:Icon
                                                    class="flowmateHistoryArrow"
                                                    src="sap-icon://navigation-right-arrow" />
                                                <ObjectStatus
                                                    class="flowmateSemanticStatus"
                                                    text="{path: 'newStatus', formatter: '.formatStatusText'}"
                                                    state="{path: 'newStatus', formatter: '.formatStatusState'}"
                                                    inverted="true" />
                                            </HBox>
                                            <Text text="{actor}" />
                                            <Text text="{createdAt}" />
                                            <Text class="flowmateHistoryRemarks" text="{remarks}" wrapping="true" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </f:content>
    </f:DynamicPage>
    <mvc:dependents>
        <TableSelectDialog
            id="requestDetailProcessorValueHelpDialog"
            title="{i18n>selectProcessorTitle}"
            noDataText="{i18n>noUsersFoundText}"
            rememberSelections="false"
            search=".onProcessorValueHelpSearch"
            confirm=".onProcessorValueHelpConfirm"
            cancel=".onProcessorValueHelpClose"
            items="{
                path: '/Users',
                filters: [{ path: 'isActive', operator: 'EQ', value1: true }],
                events: {
                    dataRequested: '.onDataRequested',
                    dataReceived: '.onDataReceived'
                }
            }">
            <columns>
                <Column><Text text="{i18n>userNameLabel}" /></Column>
                <Column><Text text="{i18n>emailLabel}" /></Column>
                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>departmentLabel}" /></Column>
            </columns>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{displayName}" />
                    <Text text="{email}" />
                    <Text text="{department}" />
                </cells>
            </ColumnListItem>
        </TableSelectDialog>
    </mvc:dependents>
</mvc:View>
