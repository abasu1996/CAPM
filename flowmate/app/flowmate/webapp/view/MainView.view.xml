<mvc:View
    controllerName="flowmate.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">
    <f:DynamicPage
        id="dashboardPage"
        class="flowmatePage"
        toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>dashboardTitle}" />
                </f:heading>
                <f:actions>
                    <Button
                        icon="sap-icon://request"
                        text="{i18n>requestsNavButton}"
                        press=".onNavToRequests" />
                    <Button
                        icon="sap-icon://workflow-tasks"
                        text="{i18n>tasksNavButton}"
                        press=".onNavToTasks" />
                    <Button
                        icon="sap-icon://add-document"
                        text="{i18n>createRequestButton}"
                        press=".onNavToCreateRequest" />
                    <Button
                        icon="sap-icon://action-settings"
                        text="{i18n>adminNavButton}"
                        visible="{permissions>/isAdmin}"
                        press=".onNavToAdminConfig" />
                    <Button
                        icon="sap-icon://employee"
                        text="{i18n>delegationsNavButton}"
                        press=".onNavToDelegations" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="flowmateContent">
                <Title
                    class="sapUiTinyMarginBottom"
                    text="{i18n>workspaceTitle}" />
                <HBox
                    wrap="Wrap"
                    renderType="Bare"
                    class="flowmateTiles">
                    <GenericTile
                        class="flowmateTile"
                        header="{i18n>myRequestsTitle}"
                        subheader="{i18n>myRequestsSubtitle}"
                        state="{dashboard>/requestsState}"
                        press=".onOpenRequests">
                        <TileContent>
                            <NumericContent
                                icon="sap-icon://request"
                                value="{dashboard>/requestsCount}" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        class="flowmateTile"
                        header="{i18n>myTasksTitle}"
                        subheader="{i18n>myTasksSubtitle}"
                        state="{dashboard>/tasksState}"
                        press=".onOpenTasks">
                        <TileContent>
                            <NumericContent
                                icon="sap-icon://workflow-tasks"
                                value="{dashboard>/tasksCount}" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        class="flowmateTile"
                        header="{i18n>createRequestTitle}"
                        subheader="{i18n>createRequestSubtitle}"
                        press=".onCreateRequest">
                        <TileContent>
                            <NumericContent icon="sap-icon://add-document" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        class="flowmateTile"
                        header="{i18n>adminConfigTitle}"
                        subheader="{i18n>adminConfigSubtitle}"
                        visible="{permissions>/isAdmin}"
                        press=".onOpenConfig">
                        <TileContent>
                            <NumericContent icon="sap-icon://action-settings" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        class="flowmateTile"
                        header="{i18n>delegationsTitle}"
                        subheader="{i18n>delegationsSubtitle}"
                        press=".onOpenDelegations">
                        <TileContent>
                            <NumericContent icon="sap-icon://employee" />
                        </TileContent>
                    </GenericTile>
                </HBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
