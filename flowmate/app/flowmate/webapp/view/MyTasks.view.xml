<mvc:View
    controllerName="flowmate.controller.MyTasks"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:uxap="sap.uxap">
    <f:FlexibleColumnLayout
        id="tasksFlexibleColumnLayout"
        layout="OneColumn"
        backgroundDesign="Solid">
        <f:beginColumnPages>
            <f:DynamicPage
                id="myTasksPage"
                class="flowmatePage"
                fitContent="true"
                toggleHeaderOnTitleClick="false">
                <f:title>
                    <f:DynamicPageTitle>
                        <f:heading>
                            <Title text="{i18n>myTasksTitle}" />
                        </f:heading>
                        <f:actions>
                            <Button
                                icon="sap-icon://home"
                                text="{i18n>dashboardNavButton}"
                                press=".onNavToDashboard" />
                            <Button
                                icon="sap-icon://request"
                                text="{i18n>requestsNavButton}"
                                press=".onNavToRequests" />
                            <Button
                                icon="sap-icon://add-document"
                                text="{i18n>createRequestButton}"
                                press=".onNavToCreateRequest" />
                            <Button
                                icon="sap-icon://action-settings"
                                text="{i18n>adminNavButton}"
                                visible="{permissions>/isAdmin}"
                                press=".onNavToAdminConfig" />
                            <Button
                                icon="sap-icon://employee"
                                text="{i18n>delegationsNavButton}"
                                press=".onNavToDelegations" />
                            <Button
                                icon="sap-icon://accept"
                                text="{i18n>openTaskButton}"
                                type="Emphasized"
                                press=".onOpenSelectedTask" />
                        </f:actions>
                    </f:DynamicPageTitle>
                </f:title>
                <f:content>
                    <VBox class="flowmateContent flowmateSurface">
                        <OverflowToolbar class="flowmateToolbar">
                            <Title text="{i18n>tasksTableHeader}" />
                            <ToolbarSpacer />
                            <SearchField
                                width="18rem"
                                search=".onSearch"
                                liveChange=".onSearch" />
                        </OverflowToolbar>
                        <Table
                            id="tasksTable"
                            class="flowmateTable"
                            noDataText="{i18n>noTasksText}"
                            busyIndicatorDelay="0"
                            mode="SingleSelectMaster"
                            growing="true"
                            growingScrollToLoad="true"
                            itemPress=".onTaskPress"
                            items="{
                                path: '/ProcessTasks',
                                events: {
                                    dataRequested: '.onDataRequested',
                                    dataReceived: '.onDataReceived'
                                }
                            }">
                            <columns>
                                <Column><Text text="{i18n>taskNameLabel}" /></Column>
                                <Column><Text text="{i18n>stepLabel}" /></Column>
                                <Column><Text text="{i18n>assignedToLabel}" /></Column>
                                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>roleLabel}" /></Column>
                                <Column><Text text="{i18n>statusLabel}" /></Column>
                                <Column demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>decisionLabel}" /></Column>
                                <Column hAlign="End"><Text text="{i18n>actionsLabel}" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem
                                    type="Active">
                                    <cells>
                                        <ObjectIdentifier
                                            title="{taskName}"
                                            text="{request_ID}" />
                                        <Text text="{stepNo}" />
                                        <Text text="{assignedTo}" />
                                        <Text text="{role}" />
                                        <ObjectStatus
                                            text="{status_code}"
                                            state="{path: 'status_code', formatter: '.formatStatusState'}" />
                                        <Text text="{decision}" />
                                        <HBox justifyContent="End">
                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="{i18n>deleteTaskButton}"
                                                press=".onDeleteTask" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </f:content>
            </f:DynamicPage>
        </f:beginColumnPages>
        <f:midColumnPages>
            <uxap:ObjectPageLayout
                id="taskObjectPage"
                class="flowmateObjectPage"
                showTitleInHeaderContent="true"
                enableLazyLoading="false">
                <uxap:headerTitle>
                    <uxap:ObjectPageDynamicHeaderTitle>
                        <uxap:expandedHeading>
                            <Title text="{taskName}" />
                        </uxap:expandedHeading>
                        <uxap:snappedHeading>
                            <Title text="{taskName}" />
                        </uxap:snappedHeading>
                        <uxap:actions>
                            <Button
                                icon="sap-icon://email"
                                text="{i18n>notifyAssigneeButton}"
                                press=".onNotifyAssignee" />
                            <Button
                                text="{i18n>approveButton}"
                                type="Accept"
                                press=".onApprove" />
                            <Button
                                text="{i18n>sendBackButton}"
                                press=".onSendBack" />
                            <Button
                                text="{i18n>rejectButton}"
                                type="Reject"
                                press=".onReject" />
                            <Button
                                icon="sap-icon://decline"
                                text="{i18n>closeButton}"
                                press=".onCloseTaskDetail" />
                        </uxap:actions>
                    </uxap:ObjectPageDynamicHeaderTitle>
                </uxap:headerTitle>
                <uxap:headerContent>
                    <ObjectStatus
                        title="{i18n>statusLabel}"
                        text="{status_code}"
                        state="{path: 'status_code', formatter: '.formatStatusState'}" />
                    <ObjectStatus
                        title="{i18n>roleLabel}"
                        text="{role}" />
                    <ObjectAttribute
                        title="{i18n>assignedToLabel}"
                        text="{assignedTo}" />
                    <ObjectAttribute
                        title="{i18n>stepLabel}"
                        text="{stepNo}" />
                </uxap:headerContent>
                <uxap:sections>
                    <uxap:ObjectPageSection title="{i18n>taskDetailsTitle}">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection>
                                <uxap:blocks>
                                    <VBox class="flowmateDetailBlock">
                                        <ObjectIdentifier
                                            title="{request/title}"
                                            text="{request_ID}" />
                                        <Label
                                            class="sapUiSmallMarginTop"
                                            text="{i18n>decisionLabel}" />
                                        <Text text="{decision}" />
                                    </VBox>
                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>
                    <uxap:ObjectPageSection title="{i18n>taskActionsTitle}">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection>
                                <uxap:blocks>
                                    <VBox class="flowmateDetailBlock flowmateRemarks">
                                        <Label text="{i18n>remarksLabel}" />
                                        <TextArea
                                            id="taskRemarksTextArea"
                                            rows="6"
                                            width="100%" />
                                    </VBox>
                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>
                </uxap:sections>
            </uxap:ObjectPageLayout>
        </f:midColumnPages>
    </f:FlexibleColumnLayout>
</mvc:View>
