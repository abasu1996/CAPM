<mvc:View
    controllerName="flowmate.controller.RequestCreate"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core">
    <f:DynamicPage
        id="requestCreatePage"
        class="flowmatePage"
        toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>requestCreateTitle}" />
                </f:heading>
                <f:actions>
                    <Button
                        icon="sap-icon://home"
                        text="{i18n>dashboardNavButton}"
                        press=".onNavToDashboard" />
                    <Button
                        icon="sap-icon://request"
                        text="{i18n>requestsNavButton}"
                        press=".onNavToRequests" />
                    <Button
                        icon="sap-icon://workflow-tasks"
                        text="{i18n>tasksNavButton}"
                        press=".onNavToTasks" />
                    <Button
                        icon="sap-icon://action-settings"
                        text="{i18n>adminNavButton}"
                        visible="{permissions>/isAdmin}"
                        press=".onNavToAdminConfig" />
                    <Button
                        icon="sap-icon://employee"
                        text="{i18n>delegationsNavButton}"
                        press=".onNavToDelegations" />
                    <Button
                        text="{i18n>createButton}"
                        type="Emphasized"
                        enabled="{= !${create>/uploading} }"
                        press=".onCreate" />
                    <Button
                        text="{i18n>cancelButton}"
                        enabled="{= !${create>/uploading} }"
                        press=".onCancel" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="flowmateContent flowmateNarrowContent">
                <form:SimpleForm
                class="flowmateFormSurface"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                adjustLabelSpan="false">
                <Label
                    text="{i18n>processTypeLabel}"
                    required="true" />
                <Input
                    value="{create>/processTypeName}"
                    placeholder="{i18n>chooseProcessTypePlaceholder}"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".onProcessTypeValueHelpRequest"
                    required="true" />
                <Label
                    text="{i18n>requestTitleLabel}"
                    required="true" />
                <Input
                    value="{create>/title}"
                    maxLength="255"
                    required="true" />
                <Label text="{i18n>requesterLabel}" />
                <Input
                    value="{create>/requesterName}"
                    placeholder="{i18n>chooseUserPlaceholder}"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".onRequesterValueHelpRequest" />
                <Label text="{i18n>processorLabel}" />
                <Input
                    value="{create>/processorName}"
                    placeholder="{i18n>selectProcessorPlaceholder}"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".onProcessorValueHelpRequest" />
                <Label text="{i18n>departmentLabel}" />
                <Input
                    value="{create>/department}"
                    maxLength="100" />
                <Label text="{i18n>priorityLabel}" />
                <Select selectedKey="{create>/priority}">
                    <core:Item
                        key="Low"
                        text="{i18n>priorityLow}" />
                    <core:Item
                        key="Medium"
                        text="{i18n>priorityMedium}" />
                    <core:Item
                        key="High"
                        text="{i18n>priorityHigh}" />
                    <core:Item
                        key="Critical"
                        text="{i18n>priorityCritical}" />
                </Select>
                <Label text="{i18n>descriptionLabel}" />
                <TextArea
                    value="{create>/description}"
                    rows="6"
                    width="100%" />
                <Label text="{i18n>autoSubmitLabel}" />
                <Switch state="{create>/autoSubmit}" />
                <Label text="{i18n>attachmentsTitle}" />
                <VBox>
                    <u:FileUploader
                        id="attachmentsUploader"
                        buttonOnly="true"
                        buttonText="{i18n>chooseDocumentsButton}"
                        change=".onAttachmentsSelected"
                        fileSizeExceed=".onAttachmentFileSizeExceed"
                        icon="sap-icon://attachment"
                        maximumFileSize="400"
                        multiple="true"
                        enabled="{= !${create>/uploading} }"
                        sameFilenameAllowed="true" />
                    <List
                        class="sapUiSmallMarginTop flowmateAttachmentList"
                        noDataText="{i18n>noAttachmentsSelectedText}"
                        items="{create>/attachments}">
                        <CustomListItem>
                            <VBox class="flowmateUploadItem">
                                <HBox
                                    alignItems="Center"
                                    justifyContent="SpaceBetween">
                                    <ObjectIdentifier
                                        title="{create>name}"
                                        text="{create>sizeText}" />
                                    <HBox alignItems="Center">
                                        <ObjectStatus
                                            class="flowmateSemanticStatus"
                                            text="{create>statusText}"
                                            state="{create>statusState}"
                                            inverted="true" />
                                        <Button
                                            icon="sap-icon://decline"
                                            enabled="{= !${create>/uploading} }"
                                            tooltip="{i18n>removeAttachmentButton}"
                                            press=".onRemoveAttachment" />
                                    </HBox>
                                </HBox>
                                <ProgressIndicator
                                    class="sapUiTinyMarginTop"
                                    visible="{create>showProgress}"
                                    percentValue="{create>progress}"
                                    displayValue="{create>progressText}"
                                    state="{create>statusState}" />
                            </VBox>
                        </CustomListItem>
                    </List>
                </VBox>
                </form:SimpleForm>
            </VBox>
        </f:content>
    </f:DynamicPage>
    <mvc:dependents>
        <TableSelectDialog
            id="processTypeValueHelpDialog"
            title="{i18n>processTypeLabel}"
            noDataText="{i18n>noProcessTypesFoundText}"
            rememberSelections="false"
            search=".onProcessTypeValueHelpSearch"
            confirm=".onProcessTypeValueHelpConfirm"
            cancel=".onProcessTypeValueHelpClose"
            items="{
                path: '/ProcessTypes',
                events: {
                    dataRequested: '.onDataRequested',
                    dataReceived: '.onDataReceived'
                }
            }">
            <columns>
                <Column>
                    <Text text="{i18n>processTypeCodeLabel}" />
                </Column>
                <Column>
                    <Text text="{i18n>processTypeNameLabel}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Tablet">
                    <Text text="{i18n>processTypeDescriptionLabel}" />
                </Column>
            </columns>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{code}" />
                    <Text text="{name}" />
                    <Text text="{descr}" />
                </cells>
            </ColumnListItem>
        </TableSelectDialog>
        <TableSelectDialog
            id="requesterValueHelpDialog"
            title="{i18n>selectRequesterTitle}"
            noDataText="{i18n>noUsersFoundText}"
            rememberSelections="false"
            search=".onRequesterValueHelpSearch"
            confirm=".onRequesterValueHelpConfirm"
            cancel=".onRequesterValueHelpClose"
            items="{
                path: '/Users',
                filters: [{ path: 'isActive', operator: 'EQ', value1: true }],
                events: {
                    dataRequested: '.onDataRequested',
                    dataReceived: '.onDataReceived'
                }
            }">
            <columns>
                <Column><Text text="{i18n>userNameLabel}" /></Column>
                <Column><Text text="{i18n>emailLabel}" /></Column>
                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>departmentLabel}" /></Column>
            </columns>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{displayName}" />
                    <Text text="{email}" />
                    <Text text="{department}" />
                </cells>
            </ColumnListItem>
        </TableSelectDialog>
        <TableSelectDialog
            id="requestCreateProcessorValueHelpDialog"
            title="{i18n>selectProcessorTitle}"
            noDataText="{i18n>noUsersFoundText}"
            rememberSelections="false"
            search=".onProcessorValueHelpSearch"
            confirm=".onProcessorValueHelpConfirm"
            cancel=".onProcessorValueHelpClose"
            items="{
                path: '/Users',
                filters: [{ path: 'isActive', operator: 'EQ', value1: true }],
                events: {
                    dataRequested: '.onDataRequested',
                    dataReceived: '.onDataReceived'
                }
            }">
            <columns>
                <Column><Text text="{i18n>userNameLabel}" /></Column>
                <Column><Text text="{i18n>emailLabel}" /></Column>
                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>departmentLabel}" /></Column>
            </columns>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{displayName}" />
                    <Text text="{email}" />
                    <Text text="{department}" />
                </cells>
            </ColumnListItem>
        </TableSelectDialog>
    </mvc:dependents>
</mvc:View>
